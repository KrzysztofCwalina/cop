# General C# source code style checks

predicate isVarDeclaration(Statement) => Statement.Kind == 'declaration' && Statement.Keywords:contains('var')
predicate isDynamicDeclaration(Statement) => Statement.Kind == 'declaration' && Statement.Keywords:contains('dynamic')

predicate isThreadSleep(Statement) => Statement.Kind == 'call'
    && Statement.TypeName == 'Thread' && Statement.MemberName == 'Sleep'
predicate isConsoleCall(Statement) => Statement.Kind == 'call'
    && Statement.TypeName == 'Console'

predicate isBareExceptionCatch(Statement) => Statement.Kind == 'catch'
    && Statement.TypeName == 'Exception'

predicate isSwallowingBaseException(Statement) => Statement.Kind == 'catch'
    && Statement.TypeName == 'Exception' && !Statement.Rethrows

## Disallow implicit typing with var — use explicit types
command varDeclarationRule = foreach Statements:isCSharp:isVarDeclaration:!pathMatches(item.File.Path, '**/Tests/**') => '{error:@red} Do not use \'var\' for {item.MemberName}'

## Disallow dynamic typing
command dynamicDeclarationRule = foreach Statements:isCSharp:isDynamicDeclaration => '{error:@red} Do not use \'dynamic\''

## Use Task.Delay instead of blocking Thread.Sleep
command threadSleepRule = foreach Statements:isCSharp:isThreadSleep => '{error:@red} Use Task.Delay instead of Thread.Sleep'

## Avoid Console output in library code
command consoleCallRule = foreach Statements:isCSharp:isConsoleCall:!pathMatches(item.File.Path, '**/Tests/**') => '{warning:@yellow} Don\'t use Console.{item.MemberName} in library code'

## Catch specific exception types instead of bare Exception
command bareExceptionCatchRule = foreach Statements:isCSharp:isBareExceptionCatch => '{warning:@yellow} Catch a specific exception type instead of Exception'

## Do not swallow base exceptions
command swallowingExceptionRule = foreach Statements:isCSharp:isSwallowingBaseException => '{warning:@yellow} Do not swallow Exception'

RUN varDeclarationRule()
RUN dynamicDeclarationRule()
RUN threadSleepRule()
RUN consoleCallRule()
RUN bareExceptionCatchRule()
RUN swallowingExceptionRule()
