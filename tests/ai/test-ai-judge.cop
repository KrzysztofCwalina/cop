# Live model evaluation for ai.judge.
#
# Feeds blatantly code-analysis types against a rule that forbids them; the LLM
# judge must return at least one Violation. This exercises the whole ai.judge
# path (request → LLM → parsed violations) and fails loudly if the judge stops
# responding with complaints.
#
# Requires ~/.cop/ai.json (see packages/core/ai). It makes a network call, so it is
# kept OUT of the offline tests/cop/ suite.
#   Run from the repository root: cop test tests/ai/

import ai
import csharp

let code-analysis-leak = csharp.parse('fixtures')

let complaints = ai.judge(
    '''
    This library must not contain code-analysis, linting, or code-review types,
    including code-review violations, code-issue severities, and linting rules
    or analyzers.
    ''',
    code-analysis-leak)

test judge-complains = assert(complaints.Count == 3,
    'Expected a finding for each of the three code-analysis types')
