# Doc Example Tests
# Verifies that key examples from README.md, language-reference.md,
# and static-analysis.md work correctly.
# Run with: cop test tests/doc-samples/

import csharp
import python
import javascript
import code

# --- README: Source Code Analysis ---

predicate longMethod(Method) => Method.Statements.Count > 50
predicate hasLongMethod(Type) => Type.Methods:any(longMethod)

test cs-types = assert(csharp.Types.Count > 0, 'should find C# types')
test py-types = assert(python.Types.Count > 0, 'should find Python types')
test js-types = assert(javascript.Types.Count > 0, 'should find JS types')
test long-method-no-crash = assert(csharp.Types:hasLongMethod.Count == 0)

# --- README: Writing Checks ---

predicate client(Type) => Type.Name:endsWith('Client')
let CsClients = csharp.Types:client

test client-found = assert(csharp.Types:client.Count > 0)
test clients = assert(CsClients.Count > 0)

# Predicate composition
predicate optionsType(Parameter) => Parameter.Type.Name:endsWith('Options')
predicate hasOptions(Method) => Method.Parameters:any(optionsType)
predicate missingOptions(Type) => Type.Constructors:none(hasOptions)
test composition = assert(CsClients:missingOptions.Count > 0)

# --- Language Reference: String Predicates ---

predicate startsWithBlob(Type) => Type.Name:startsWith('Blob')
predicate containsClient(Type) => Type.Name:contains('Client')
predicate matchesPattern(Type) => Type.Name:matches('^Blob')

test starts-with = assert(csharp.Types:startsWithBlob.Count > 0)
test contains = assert(csharp.Types:containsClient.Count > 0)
test matches = assert(csharp.Types:matchesPattern.Count > 0)

# Short aliases (documented in language-reference.md alias table)
predicate swBlob(Type) => Type.Name:startsWith('Blob')
predicate ewClient(Type) => Type.Name:endsWith('Client')
test sw-alias = assert(csharp.Types:swBlob.Count > 0)
test ew-alias = assert(csharp.Types:ewClient.Count > 0)

# Convention-insensitive (sameAs)
predicate isBlobClient(Type) => Type.Name:sameAs('blob_client')
test same-as = assert(csharp.Types:isBlobClient.Count > 0)

# --- Language Reference: Collection Operations ---

# Negation using isPublic from code package
test negation = assert(csharp.Types:!isPublic.Count > 0)

# any on sub-collection using isPublic(Method)
predicate hasPublicCtors(Type) => Type.Constructors:any(isPublic)
test any-subcollection = assert(csharp.Types:hasPublicCtors.Count > 0)

# empty predicate
predicate noCtors(Type) => Type.Constructors:empty
test empty-predicate = assert(csharp.Types:noCtors.Count > 0)

# Collection concatenation
let all-types = csharp.Types + python.Types + javascript.Types
test union = assert(all-types.Count > 0)

# Select transform
let typeNames = csharp.Types.Select(item.Name)
test select = assert(typeNames.Count > 0)

# Constrained predicates using isSealed from code package
test sealed = assert(csharp.Types:isSealed.Count > 0)

# --- Static Analysis: Cross-Language ---

predicate swallowsException(Statement) => Statement.ErrorHandler == true
    && Statement.Generic == true && !Statement.Rethrows
test swallows = assert(python.Statements:swallowsException.Count > 0)

predicate consoleOutput(Statement) => Statement.Kind == call
    && (Statement.TypeName == 'Console'
        || Statement.TypeName == 'console'
        || Statement.MemberName == 'print')
test console = assert(python.Statements:consoleOutput.Count > 0)

predicate isCall(Statement) => Statement.Kind == call
test cs-calls = assert(csharp.Statements:isCall.Count > 0)
test py-calls = assert(python.Statements:isCall.Count > 0)
test js-calls = assert(javascript.Statements:isCall.Count > 0)

predicate anyErrorHandler(Statement) => Statement.ErrorHandler == true
test error-handlers = assert(python.Statements:anyErrorHandler.Count > 0)

# --- Language Reference: Collection transforms (Select / Where / OrderBy) ---
# These exercise per-item `item` binding on provider-backed collections.

let publicNames = csharp.Types:isPublic.Select(item.Name)
test select-member = assert(publicNames.Count > 0)

let arrowNames = csharp.Types:isPublic.Select((t) => t.Name)
test select-arrow = assert(arrowNames.Count > 0)

let clientTypes = csharp.Types.Where(item.Name:endsWith('Client'))
test where-filter = assert(clientTypes.Count > 0)

let orderedAsc = csharp.Types.OrderBy(item.Name)
test order-by = assert(orderedAsc.Count > 0)

let orderedDesc = csharp.Types.OrderByDescending(item.Name)
test order-by-desc = assert(orderedDesc.Count == orderedAsc.Count)

# --- Language Reference: convention-insensitive equality (sameAs / sm) ---

predicate isBlobSm(Type) => Type.Name:sm('blob_client')
test sm-alias = assert(csharp.Types:isBlobSm.Count > 0)
