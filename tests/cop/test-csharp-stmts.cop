# Tests for C# statement extraction and filtering.
# Runs against samples/BadCode.cs (var, dynamic, Console, Thread.Sleep)

import csharp

# ── Statement predicates ──
predicate isVar(Statement) => Statement.Kind == 'declaration' && Statement.Keywords:contains('var')
predicate isDynamic(Statement) => Statement.Kind == 'declaration' && Statement.Keywords:contains('dynamic')
predicate isConsole(Statement) => Statement.Kind == 'call' && Statement.TypeName == 'Console'
predicate isSleep(Statement) => Statement.Kind == 'call'
    && Statement.TypeName == 'Thread' && Statement.MemberName == 'Sleep'
predicate isCall(Statement) => Statement.Kind == 'call'
predicate isDecl(Statement) => Statement.Kind == 'declaration'

# ── Existence ──
command test-stmts-exist = ASSERT(csharp.Statements.Count > 0, 'should have statements')
command test-has-var = ASSERT(csharp.Statements:isVar.Count > 0, 'should find var declarations')
command test-has-dynamic = ASSERT(csharp.Statements:isDynamic.Count > 0, 'should find dynamic')
command test-has-console = ASSERT(csharp.Statements:isConsole.Count > 0, 'should find Console calls')
command test-has-sleep = ASSERT(csharp.Statements:isSleep.Count > 0, 'should find Thread.Sleep')
command test-has-calls = ASSERT(csharp.Statements:isCall.Count > 0, 'should have call statements')
command test-has-decls = ASSERT(csharp.Statements:isDecl.Count > 0, 'should have declarations')

# ── Negated ──
command test-not-all-var = ASSERT(csharp.Statements:!isVar.Count > 0, 'some statements are not var')

# ── Files ──
command test-has-cs-files = ASSERT(csharp.Files.Count > 0, 'should have C# files')

# ── Impossible intersection ──
command test-no-console-var = ASSERT(csharp.Statements:isConsole:isVar.Count == 0, 'nothing is both console and var')
