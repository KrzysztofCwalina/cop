# Tests for C# statement extraction and filtering.
# Runs against samples/BadCode.cs (var, dynamic, Console, Thread.Sleep)

import csharp

# ── Statement predicates ──
predicate isVar(Statement) => Statement.Kind == 'declaration' && Statement.Keywords:contains('var')
predicate isDynamic(Statement) => Statement.Kind == 'declaration' && Statement.Keywords:contains('dynamic')
predicate isConsole(Statement) => Statement.Kind == 'call' && Statement.TypeName == 'Console'
predicate isSleep(Statement) => Statement.Kind == 'call'
    && Statement.TypeName == 'Thread' && Statement.MemberName == 'Sleep'
predicate isCall(Statement) => Statement.Kind == 'call'
predicate isDecl(Statement) => Statement.Kind == 'declaration'

# ── Existence ──
test stmts-exist = assert(csharp.Statements.Count > 0, 'should have statements')
test has-var = assert(csharp.Statements:isVar.Count > 0, 'should find var declarations')
test has-dynamic = assert(csharp.Statements:isDynamic.Count > 0, 'should find dynamic')
test has-console = assert(csharp.Statements:isConsole.Count > 0, 'should find Console calls')
test has-sleep = assert(csharp.Statements:isSleep.Count > 0, 'should find Thread.Sleep')
test has-calls = assert(csharp.Statements:isCall.Count > 0, 'should have call statements')
test has-decls = assert(csharp.Statements:isDecl.Count > 0, 'should have declarations')

# ── Negated ──
test not-all-var = assert(csharp.Statements:!isVar.Count > 0, 'some statements are not var')

# ── Files ──
test has-cs-files = assert(csharp.Files.Count > 0, 'should have C# files')

# ── Impossible intersection ──
test no-console-var = assert(csharp.Statements:isConsole:isVar.Count == 0, 'nothing is both console and var')
