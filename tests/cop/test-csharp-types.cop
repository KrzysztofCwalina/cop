# Tests for basic C# type collection and type predicates.
# Runs against samples/Animals.cs (6 types: Animal, Dog, Cat, FishClient, HiddenHelper, AbstractService)

import csharp

# ── Type predicates ──
predicate endsClient(Type) => Type.Name:endsWith('Client')
predicate endsService(Type) => Type.Name:endsWith('Service')
predicate startsA(Type) => Type.Name:startsWith('A')
predicate containsI(Type) => Type.Name:contains('i')
predicate equalsDog(Type) => Type.Name:equals('Dog')
predicate equalsXyz(Type) => Type.Name:equals('Xyz')

# ── Existence ──
command test-types-exist = assert(csharp.Types.Count > 0, 'C# types should exist')
command test-has-public = assert(csharp.Types:isPublic.Count > 0, 'should have public types')
command test-has-non-public = assert(csharp.Types:!isPublic.Count > 0, 'should have non-public types')
command test-has-sealed = assert(csharp.Types:isSealed.Count > 0, 'should have sealed types')
command test-has-abstract = assert(csharp.Types:isAbstract.Count > 0, 'should have abstract types')

# ── String predicates on names ──
command test-ends-client = assert(csharp.Types:endsClient.Count > 0, 'should find FishClient')
command test-ends-service = assert(csharp.Types:endsService.Count > 0, 'should find AbstractService')
command test-starts-a = assert(csharp.Types:startsA.Count > 0, 'should find Animal and AbstractService')
command test-contains-i = assert(csharp.Types:containsI.Count > 0, 'types containing i')
command test-equals-dog = assert(csharp.Types:equalsDog.Count > 0, 'should find Dog')
command test-no-xyz = assert(csharp.Types:equalsXyz.Count == 0, 'no type named Xyz')

# ── Chained predicates ──
command test-public-sealed = assert(csharp.Types:isPublic:isSealed.Count > 0, 'FishClient is public+sealed')
command test-public-abstract = assert(csharp.Types:isPublic:isAbstract.Count > 0, 'AbstractService is public+abstract')
command test-no-sealed-abstract = assert(csharp.Types:isSealed:isAbstract.Count == 0, 'nothing is sealed+abstract')
command test-no-nonpub-sealed = assert(csharp.Types:!isPublic:isSealed.Count == 0, 'no non-public sealed types')
