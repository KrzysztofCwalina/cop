# Tests for case-insensitive string predicates: equals, startsWith, endsWith, contains, notEquals, matches.
# Runs against samples/Animals.cs (types: Animal, Dog, Cat, FishClient, HiddenHelper, AbstractService)

import csharp

# ── Case-insensitive equals ──
predicate eqAnimal(Type) => Type.Name:equals('animal')
predicate eqDOG(Type) => Type.Name:equals('DOG')
predicate eqCaT(Type) => Type.Name:equals('CaT')
command test-eq-lower = assert(csharp.Types:eqAnimal.Count > 0, 'equals matches lowercase')
command test-eq-upper = assert(csharp.Types:eqDOG.Count > 0, 'equals matches uppercase')
command test-eq-mixed = assert(csharp.Types:eqCaT.Count > 0, 'equals matches mixed case')

# ── Case-insensitive startsWith ──
predicate swAbstract(Type) => Type.Name:startsWith('abstract')
predicate swFISH(Type) => Type.Name:startsWith('FISH')
command test-sw-lower = assert(csharp.Types:swAbstract.Count > 0, 'startsWith case-insensitive')
command test-sw-upper = assert(csharp.Types:swFISH.Count > 0, 'startsWith FISH matches FishClient')

# ── Case-insensitive endsWith ──
predicate ewHELPER(Type) => Type.Name:endsWith('HELPER')
predicate ewClient(Type) => Type.Name:endsWith('client')
command test-ew-upper = assert(csharp.Types:ewHELPER.Count > 0, 'endsWith HELPER matches HiddenHelper')
command test-ew-lower = assert(csharp.Types:ewClient.Count > 0, 'endsWith client matches FishClient')

# ── Case-insensitive contains ──
predicate ctSERV(Type) => Type.Name:contains('SERV')
predicate ctfish(Type) => Type.Name:contains('fish')
command test-ct-upper = assert(csharp.Types:ctSERV.Count > 0, 'contains SERV matches AbstractService')
command test-ct-lower = assert(csharp.Types:ctfish.Count > 0, 'contains fish matches FishClient')

# ── notEquals ──
predicate neDog(Type) => Type.Name:notEquals('Dog')
command test-ne = assert(csharp.Types:neDog.Count > 0, 'notEquals excludes Dog, others remain')

# ── Regex matches ──
predicate rxCat(Type) => Type.Name:matches('^[A-Z]at$')
predicate rxService(Type) => Type.Name:matches('Service$')
command test-rx-cat = assert(csharp.Types:rxCat.Count > 0, 'regex ^[A-Z]at$ matches Cat')
command test-rx-service = assert(csharp.Types:rxService.Count > 0, 'regex Service$ matches AbstractService')
