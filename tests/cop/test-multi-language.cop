# Tests for multi-language support, namespace resolution, unions, and filesystem.
# Runs against samples/Animals.cs, samples/calculator.py, samples/app.js

import csharp
import python
import javascript
import files

# ── Statement call predicates ──
predicate printCall(Statement) => Statement.Kind == 'call' && Statement.MemberName == 'print'
predicate consoleCall(Statement) => Statement.Kind == 'call' && Statement.TypeName == 'console'
predicate evalCall(Statement) => Statement.Kind == 'call' && Statement.MemberName == 'eval'
predicate alertCall(Statement) => Statement.Kind == 'call' && Statement.MemberName == 'alert'

# ── Namespace resolution ──
test cs-types = assert(csharp.Types.Count > 0, 'csharp.Types via namespace')
test py-types = assert(python.Types.Count > 0, 'python.Types via namespace')
test js-types = assert(javascript.Types.Count > 0, 'javascript.Types via namespace')
test cs-stmts = assert(csharp.Statements.Count > 0, 'csharp.Statements via namespace')
test py-stmts = assert(python.Statements.Count > 0, 'python.Statements via namespace')
test js-stmts = assert(javascript.Statements.Count > 0, 'javascript.Statements via namespace')

# ── Python-specific ──
test py-print = assert(python.Statements:printCall.Count > 0, 'should find print() in calculator.py')

# ── JavaScript-specific ──
test js-console = assert(javascript.Statements:consoleCall.Count > 0, 'should find console.log in app.js')
test js-eval = assert(javascript.Statements:evalCall.Count > 0, 'should find eval() in app.js')
test js-alert = assert(javascript.Statements:alertCall.Count > 0, 'should find alert() in app.js')

# ── Union: two languages ──
let cs-py-types = csharp.Types + python.Types
test union-two = assert(cs-py-types.Count > 0, 'union of csharp + python types')

# ── Union: three languages ──
let all-types = csharp.Types + python.Types + javascript.Types
test union-three = assert(all-types.Count > 0, 'union of all three language types')

# ── Union: filtered branches ──
let public-cs = csharp.Types:isPublic
let public-all = public-cs + python.Types
test union-filtered = assert(public-all.Count > 0, 'union with filtered branch')

# ── Filesystem ──
test has-files = assert(files().Count > 0, 'should have files')
test has-folders = assert(folders().Count > 0, 'should have folders')
