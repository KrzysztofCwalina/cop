# Tests for let declarations, chaining, unions of let-bound collections, and negation.
# Runs against samples/Animals.cs

import csharp

# ── Predicates used by let chains ──
predicate endsClient(Type) => Type.Name:endsWith('Client')
predicate endsService(Type) => Type.Name:endsWith('Service')
predicate containsZzz(Type) => Type.Name:contains('Zzz')

# ── Basic let ──
let public-types = csharp.Types:isPublic
test let-basic = assert(public-types.Count > 0, 'let binding should resolve')

# ── Chained let (narrowing) ──
let sealed-public = public-types:isSealed
test let-chain-sealed = assert(sealed-public.Count > 0, 'chained let narrows to sealed')

let abstract-public = public-types:isAbstract
test let-chain-abstract = assert(abstract-public.Count > 0, 'chained let narrows to abstract')

# ── Chain producing empty ──
let sealed-abstract = sealed-public:isAbstract
test let-empty-chain = assert(sealed-abstract.Count == 0, 'sealed+abstract should be empty')

# ── Multiple predicates ──
let clients = public-types:endsClient
test let-client = assert(clients.Count > 0, 'should find client types via let')

let services = public-types:endsService
test let-service = assert(services.Count > 0, 'should find service types via let')

# ── Deep chain (3 levels) ──
let sealed-clients = clients:isSealed
test let-deep = assert(sealed-clients.Count > 0, 'FishClient is a sealed client')

# ── Union of let-bound collections ──
let important = clients + services
test let-union = assert(important.Count > 0, 'union of let-chained collections')

# ── Negated filter on let ──
let non-sealed = public-types:!isSealed
test let-negated = assert(non-sealed.Count > 0, 'should have non-sealed public types')

# ── Let that produces empty ──
let zzz = csharp.Types:containsZzz
test let-empty = assert(zzz.Count == 0, 'no types contain Zzz')
