import csharp
import code-analysis

let allowed-interfaces = ['ICopCallable']

predicate isDisallowedInterface(Type) => Type.Kind == 'Interface'
    && !Type.Name:in(allowed-interfaces)

let no-new-interfaces = csharp.Types:isDisallowedInterface
    :toError('Do not add new interfaces: {item.Name} in {item.File.Path}')

command main = CHECK(no-new-interfaces)
