# Flags GitHub Actions `uses:` references that are not pinned to a full 40-character
# commit SHA (tags and branches like @v4 or @main are mutable and a supply-chain risk).
#
# Run: cop packages/yaml/samples/pin-actions-to-sha.cop -t packages/yaml/samples/fixtures

import yaml
import code

predicate isUnpinnedActionUse(YamlEntry) =>
    YamlEntry.Key:equals('uses')
    && !YamlEntry.Value:matches('.*@[0-9a-f]{40}$')

let unpinned-actions = yaml.parse().Entries:isUnpinnedActionUse
    :toWarning('Action {item.Value} is not pinned to a commit SHA')

command MAIN = CHECK(unpinned-actions)
