# Spectral integration — runs Spectral and produces cop diagnostics
# Prerequisites: Spectral must be installed

import code-analysis

let data = provider('analysis-spectral', nic)

## Returns the Spectral diagnostics collection
export function diagnostics() : [Diagnostic] => data.Diagnostics
export let spectral-checks = data.Diagnostics

command main = foreach spectral-checks => '{item.FilePath}({item.Line}): {item.Severity}: {item.RuleId}: {item.Message}'
