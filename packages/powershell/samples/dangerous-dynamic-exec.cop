# Flags dangerous dynamic PowerShell execution.
#
# Run: cop packages\powershell\samples\dangerous-dynamic-exec.cop -t packages\powershell\samples\fixtures

import powershell
import code-analysis

predicate isDynamicExec(PowerShellCommand) =>
    PowerShellCommand.Name:equals('Invoke-Expression')
    || (PowerShellCommand.Name:equals('iex') && !PowerShellCommand.Text:contains('| iex'))
    || ((PowerShellCommand.Name:equals('Invoke-WebRequest') || PowerShellCommand.Name:equals('iwr') || PowerShellCommand.Name:equals('curl'))
        && (PowerShellCommand.Text:contains('| iex') || PowerShellCommand.Text:contains('| Invoke-Expression')))

predicate isMissingStrictMode(PowerShellScript) =>
    PowerShellScript.UsesStrictMode == false

let dynamic-exec = powershell.parse().Commands:isDynamicExec
    :toError('Avoid dynamic PowerShell execution: {item.Text}')

let missing-strict-mode = powershell.parse().Scripts:isMissingStrictMode
    :toWarning('PowerShell script should enable Set-StrictMode')

command MAIN = CHECK(dynamic-exec + missing-strict-mode)
