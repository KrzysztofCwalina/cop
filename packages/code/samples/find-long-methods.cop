import code
import csharp
import python
import javascript

# Language-independent predicate works on any Method regardless of source language
predicate isLong(Method) => Method.Statements.count() > 50

# Create a unified codebase from all three language providers
let cb = code.codebase('csharp', 'python', 'javascript')

command MAIN = foreach cb.Types => '{Type.Name} ({Type.File.Language})':Methods:isLong
    => '  {Method.Name} ({Method.Statements.count()} statements)'
