import code
import csharp
import python
import javascript

# Create a unified codebase from all three language providers
let cb = code.codebase('csharp', 'python', 'javascript')

# Group and count by language - demonstrates language-independent querying
command MAIN = 
    foreach cb.Types:isCSharp => 'C# types: {collection.count()}' |
    foreach cb.Types:isPython => 'Python types: {collection.count()}' |
    foreach cb.Types:isJavaScript => 'JavaScript types: {collection.count()}'
