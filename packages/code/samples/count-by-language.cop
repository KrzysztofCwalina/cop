import code
import csharp
import python
import javascript

# Use explicit provider proxies — each accesses its own collections
let cs : Codebase = provider('csharp')
let py : Codebase = provider('python')
let js : Codebase = provider('javascript')

# Count types per language using explicit provider access
command MAIN = 
    foreach cs.Types => 'C# types: {collection.count()}' |
    foreach py.Types => 'Python types: {collection.count()}' |
    foreach js.Types => 'JavaScript types: {collection.count()}'
