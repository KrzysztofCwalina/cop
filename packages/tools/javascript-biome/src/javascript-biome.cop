# Biome integration — runs biome and produces cop violations
# Prerequisites: biome must be installed (npm install @biomejs/biome)

import code

let data = provider('javascript-biome')

## Returns the Biome violations collection
export function violations() : [Violation] => data.Violations
export function diagnostics() : [Violation] => data.Violations
export let biome-checks = data.Violations

command MAIN = CHECK(biome-checks)
