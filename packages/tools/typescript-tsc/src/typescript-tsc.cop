# TypeScript compiler integration — runs tsc and produces cop violations
# Prerequisites: typescript must be installed (npm install typescript)

import code

let data = provider('typescript-tsc')

## Returns the TypeScript compiler violations collection
export function violations() : [Violation] => data.Violations
export function diagnostics() : [Violation] => data.Violations
export let tsc-checks = data.Violations

command MAIN = CHECK(tsc-checks)
