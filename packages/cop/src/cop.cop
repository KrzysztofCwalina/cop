# Cop Language Analysis Package v1.0
# Provides structural analysis of .cop source files through
# the standard code analysis collections (Types, Statements, Lines, Files).
#
# Usage: import cop
# Then use cop.types(), cop.lines(), cop.files(), etc.

import code

let cb : Codebase = provider('cop', nic)

## Returns all types defined in .cop source files.
export function types() : [Type] => cb.Types

## Returns all statements in .cop source files.
export function statements() : [Statement] => cb.Statements

## Returns all source lines in .cop source files.
export function lines() : [Line] => cb.Lines

## Returns all .cop source files.
export function files() : [File] => cb.Files
