# alan Filesystem Package v1.0
# Defines types and collections for filesystem structural analysis.
# Import with: import files

import code-analysis

export type Folder = {
    Path : string,
    Name : string,
    Empty : bool,
    FileCount : int,
    SubfolderCount : int,
    Depth : int,
    MinutesSinceModified : int
}

export type File = {
    Path : string,
    Name : string,
    Extension : string,
    Size : int,
    Folder : string,
    Depth : int,
    MinutesSinceModified : int
}

export type Filesystem = {
    Folders : [Folder],
    Files : [File]
}

# Provides filesystem data via the built-in filesystem provider
let disk : Filesystem = provider('filesystem', nic)

## Returns all folders in the project directory tree.
export function folders() : [Folder] => disk.Folders

## Returns all files in the project directory tree.
export function files() : [File] => disk.Files

# Convenience predicates
export predicate empty(Folder) => Folder.Empty == true
export predicate recentlyModified(Folder) => Folder.MinutesSinceModified < 10
export predicate recentlyModified(File) => File.MinutesSinceModified < 10
export predicate stale(Folder) => Folder.MinutesSinceModified > 1440
export predicate stale(File) => File.MinutesSinceModified > 1440

# Violation collections
export let empty-folders = folders():empty
    :toError('Empty folder: {item.Path}')