# Flags OpenAPI operations missing a summary/description or responses mapping.
#
# Run: cop packages/openapi/samples/undocumented-operations.cop -t packages/openapi/samples/fixtures

import openapi
import code-analysis

predicate isUndocumented(OpenApiOperation) => !OpenApiOperation.HasSummary
predicate hasNoResponses(OpenApiOperation) => !OpenApiOperation.HasResponses

let undocumented-operations = openapi.parse().Operations:isUndocumented
    :toError('{item.Method} {item.Path} is missing a summary or description')

let operations-without-responses = openapi.parse().Operations:hasNoResponses
    :toError('{item.Method} {item.Path} is missing responses')

command MAIN = CHECK(undocumented-operations + operations-without-responses)

