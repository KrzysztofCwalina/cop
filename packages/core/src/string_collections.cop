# String Collection Functions
# Functions specific to collections of strings.

## Returns true if collection contains a value (case-insensitive string match).
## Example: names:contains('Foo')
export function contains(items: [string], value: string) : bool 
    => items.any((item) => item == value)

## Returns true if collection contains any of the values in the second collection.
## Example: tags:containsAny(['api', 'public'])
export function containsAny(items: [string], values: [string]) : bool 
    => values.any((value) => items.contains(value))
