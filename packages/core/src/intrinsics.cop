# Core Intrinsic Functions
# All functions implemented by the runtime engine.
# Intrinsic declarations must ONLY appear in this file.

## Returns a dynamic Object accessor for the named provider.
## Properties on the returned object query the provider's collections.
## Example: provider('sample').Widgets returns the Widgets collection.
export function provider(name : string) : Object = intrinsic

## Returns an async streaming collection from the named provider.
## The stream produces items asynchronously (e.g., incoming HTTP requests).
export function source(name : string) : [object] = intrinsic

## Returns an async output collection for the named streaming provider.
## Items pushed into the sink are delivered to the provider's output channel.
export function sink(name : string) : [object] = intrinsic

## Reads the content of a file at the given path (sandboxed to project root).
## Returns the file content as a string.
export function read(path : string) : string = intrinsic

## Converts an integer to its decimal text representation.
export function text(int) : string = intrinsic

## Decodes a byte array as UTF-8 text.
export function text(bytes) : string = intrinsic

## Converts a Formattable to text by resolving the Template against each item
## in Items using {Property} interpolation, then joining results with Separator.
## When used in a pipeline: collection.text('{Item.Name}') creates a Formattable
## from the pipeline collection and resolves it into a single joined string.
export function text(Formattable) : string = intrinsic

## Creates an Error value with the given message string.
## Example: error('connection timeout')
export function error(string) : Error = intrinsic

## Terminates execution immediately with a fatal diagnostic.
## Use for programmer assertions — situations that should never occur.
## Can be used standalone: fail('invariant violated')
## Or in pipeline: foreach Items:badCondition => fail('{item.Name} is invalid')
export function fail(message : string) = intrinsic

## Returns the current program context.
## Provides access to command-line arguments passed to the cop invocation.
## Example: predicate verbose(Program) => program().Args:contains('/v')
export function program() : Program = intrinsic

## Glob-matches a file path against a pattern.
## Supports **, *, ? wildcards. Returns true if the path matches.
## Example: pathMatches(Statement.File.Path, '**/Tests/**')
export function pathMatches(path : string, pattern : string) : bool = intrinsic

## Prints a message to the output.
## Used standalone: print('hello {Name}')
## Used in pipeline: foreach Types => print('{item.Name}')
## The template supports {Property} interpolation and {@style} formatting.
export function print(message : string) : string = intrinsic

## Saves content to a file at the specified path.
## Used in pipeline: foreach Types:isPublic => save('api.txt', '{item.Name}')
## Creates or appends to the file with the rendered template output.
export function save(path : string, content : string) = intrinsic

## Outputs a diagnostic message to the debug log (--diag flag).
## Same template semantics as print but only visible when diagnostics are enabled.
## Used for troubleshooting: debug('{Types.Count} types loaded')
export function debug(message : string) = intrinsic

## Asserts that a condition is true. Fails the test run if false.
## Used in tests: assert(Types:isPublic.Count > 0, 'should have public types')
## Reports pass/fail with the description.
export function assert(condition : bool, description : string) = intrinsic

# Collection query functions (intrinsic)
# These take predicate/projection expressions evaluated per-item.
# The expression argument is passed from the call site and evaluated lazily per item.

## Filters items matching a condition. Returns a new collection.
## Example: Types:where(isPublic)
export function where(Collection) : Collection = intrinsic

## Projects each item through a transformation. Returns a new collection.
## Example: Types:select(item.Name)
export function select(Collection) : Collection = intrinsic

## Returns true if any item matches a condition.
## Example: Types:any(isAbstract)
export function any(Collection) : bool = intrinsic

## Returns true if all items match a condition.
## Example: Types:all(isPublic)
export function all(Collection) : bool = intrinsic

## Returns true if no item matches a condition.
## Example: Types:none(isObsolete)
export function none(Collection) : bool = intrinsic

## Counts items matching a condition.
## Example: Types:count(isPublic)
export function count(Collection) : int = intrinsic

## Returns true if collection contains a value (case-insensitive string match).
## Example: names:contains('Foo')
export function contains(Collection) : bool = intrinsic

## Returns true if collection contains any of the given values.
## Example: tags:containsAny('api', 'public')
export function containsAny(Collection) : bool = intrinsic

## Returns true if the collection is empty (Count == 0).
## Example: errors:empty
export function empty(Collection) : bool = intrinsic

## First item matching a condition, or nic.
## Example: Types:first(isPublic)
export function first(Collection) : Object = intrinsic

## Last item matching a condition, or nic.
## Example: Types:last(isPublic)
export function last(Collection) : Object = intrinsic

## The single item matching a condition, or nic if zero or multiple match.
## Example: Types:single(isEntryPoint)
export function single(Collection) : Object = intrinsic

## Item at a specific zero-based index.
## Example: items:elementAt(3)
export function elementAt(Collection) : Object = intrinsic

## Sorts ascending by a key expression.
## Example: Types:orderBy(item.Name)
export function orderBy(Collection) : Collection = intrinsic

## Sorts descending by a key expression.
## Example: Types:orderByDescending(item.Count)
export function orderByDescending(Collection) : Collection = intrinsic

## Removes duplicate items (by string representation).
## Example: names:distinct
export function distinct(Collection) : Collection = intrinsic

## Groups items by a key expression. Returns collection of groups.
## Example: Types:groupBy(item.Namespace)
export function groupBy(Collection) : Collection = intrinsic

## Sums a numeric property across all items.
## Example: files:sum(item.Size)
export function sum(Collection) : int = intrinsic

## Minimum value of a numeric property.
## Example: files:min(item.Size)
export function min(Collection) : int = intrinsic

## Maximum value of a numeric property.
## Example: files:max(item.Size)
export function max(Collection) : int = intrinsic

## Average value of a numeric property.
## Example: files:average(item.Size)
export function average(Collection) : int = intrinsic

## Reduces a collection to a single value using an accumulator expression.
## Example: numbers:reduce(acc + item)
export function reduce(Collection) : Object = intrinsic

# Immutable collection operations
# All return new collections — the original is never modified.

## Returns a new collection with the item appended at the end.
## Example: let updated = items:push(newItem)
export function push(Collection) : Collection = intrinsic

## Returns a new collection with the item prepended at the front.
## Example: let updated = items:prepend(newItem)
export function prepend(Collection) : Collection = intrinsic

## Returns a new collection without the last element.
## Example: let shorter = items:pop
export function pop(Collection) : Collection = intrinsic

## Returns a new collection combining both collections.
## Example: let merged = listA:concat(listB)
export function concat(Collection) : Collection = intrinsic
