# Object Collection Functions
# Functions that operate on collections of any item type.

# Collection query functions (intrinsic)
# These take predicate/projection expressions evaluated per-item.
# The expression argument is passed from the call site and evaluated lazily per item.

## Filters items matching a condition. Returns a new collection.
## Example: Types:where(isPublic)
export function where(items: [object], condition: expression) : [object] => intrinsic

## Projects each item through a transformation. Returns a new collection.
## Example: Types:select(item.Name)
export function select(items: [object], object2object: expression) : [object] => intrinsic

## Returns true if any item matches a condition.
## Example: Types:any(isAbstract)
export function any(items: [object], condition: expression) : bool => intrinsic

## Returns true if all items match a condition.
## Example: Types:all(isPublic)
export function all(items: [object], condition: expression) : bool => intrinsic

## Returns true if no item matches a condition.
## Example: Types:none(isObsolete)
export function none(items: [object], condition: expression) : bool => intrinsic

## Counts items matching a condition.
## Example: Types:count(isPublic)
export function count(items: [object], condition: expression) : int => intrinsic

## Returns true if the collection is empty (Count == 0).
## Example: errors:empty
export function empty(items: [object]) : bool => intrinsic

## First item matching a condition, or nic.
## Example: Types:first(isPublic)
export function first(items: [object], condition: expression) : object => intrinsic

## Last item matching a condition, or nic.
## Example: Types:last(isPublic)
export function last(items: [object], condition: expression) : object => intrinsic

## The single item matching a condition, or nic if zero or multiple match.
## Example: Types:single(isEntryPoint)
export function single(items: [object], condition: expression) : object => intrinsic

## Item at a specific zero-based index.
## Example: items:elementAt(3)
export function elementAt(items: [object], index: int) : object => intrinsic

## Sorts ascending by a key expression.
## Example: Types:orderBy(item.Name)
export function orderBy(items: [object], object2object: expression) : [object] => intrinsic

## Sorts descending by a key expression.
## Example: Types:orderByDescending(item.Count)
export function orderByDescending(items: [object], object2object: expression) : [object] => intrinsic

## Removes duplicate items (by string representation).
## Example: names:distinct
export function distinct(items: [object]) : [object] => intrinsic

## Groups items by a key expression. Returns collection of groups.
## Example: Types:groupBy(item.Namespace)
export function groupBy(items: [object], object2object: expression) : [object] => intrinsic

# Immutable collection operations
# All return new collections — the original is never modified.

## Returns a new collection with the item appended at the end.
## Example: let updated = items:push(newItem)
export function push(items: [object], value: object) : [object] => intrinsic

## Returns a new collection with the item added at the front (queue semantics).
## Example: let updated = items:enqueue(newItem)
export function enqueue(items: [object], value: object) : [object] => intrinsic

## Returns a new collection without the last element.
## Example: let shorter = items:pop
export function pop(items: [object]) : [object] => intrinsic

## Returns a new collection combining both collections.
## Example: let merged = listA:concat(listB)
export function concat(items: [object], other: [object]) : [object] => intrinsic
