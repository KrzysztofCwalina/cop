# Numeric Collection Functions
# Aggregate functions that operate on collections of numbers.
# reduce is the one fundamental intrinsic. sum is expressed using reduce.
# min/max/average remain intrinsic pending first() composition support.

## Reduces a collection to a single value using an accumulator.
## Example: [1,2,3]:reduce((acc, item) => acc + item, 0)
export function reduce(items: [object], accumulator: expression, initial: object) : object => intrinsic

## Sums all items in an integer collection.
## Example: scores:sum()
export function sum(items: [int]) : int => items.reduce((acc, x) => acc + x, 0)

## Sums all items in a number collection.
## Example: measurements:sum()
export function sum(items: [number]) : number => items.reduce((acc, x) => acc + x, 0)

## Sums a computed value for each item.
## Example: files:sum(item.Size)
export function sum(items: [object], object2int: expression) : int => intrinsic

## Minimum value in an integer collection.
## Example: scores:min()
export function min(items: [int]) : int => intrinsic

## Minimum value in a number collection.
## Example: measurements:min()
export function min(items: [number]) : number => intrinsic

## Minimum computed value across items.
## Example: files:min(item.Size)
export function min(items: [object], object2int: expression) : int => intrinsic

## Maximum value in an integer collection.
## Example: scores:max()
export function max(items: [int]) : int => intrinsic

## Maximum value in a number collection.
## Example: measurements:max()
export function max(items: [number]) : number => intrinsic

## Maximum computed value across items.
## Example: files:max(item.Size)
export function max(items: [object], object2int: expression) : int => intrinsic

## Average value of an integer collection.
## Example: scores:average()
export function average(items: [int]) : number => intrinsic

## Average value of a number collection.
## Example: measurements:average()
export function average(items: [number]) : number => intrinsic

## Average computed value across items.
## Example: files:average(item.Size)
export function average(items: [object], object2int: expression) : number => intrinsic
