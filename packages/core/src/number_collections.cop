# Numeric Collection Functions
# Aggregate functions that operate on collections of numbers.

## Sums all items in an integer collection.
## Example: scores:sum()
export function sum(items: [int]) : int 
  => items.reduce((acc, x) => acc + x, 0)

## Sums all items in a number collection.
## Example: measurements:sum()
export function sum(items: [number]) : number 
  => items.reduce((acc, x) => acc + x, 0.0)

## Sums a projected value for each item.
## Example: files:sum((f) => f.Size)
export function sum(items: [object], project: lambda) : int 
  => items.reduce((acc, item) => acc + project(item), 0)

## Minimum value in an integer collection.
## Example: scores:min()
export function min(items: [int]) : int 
  => items.reduce((acc, x) => acc < x ? acc : x, items.first())

## Minimum value in a number collection.
## Example: measurements:min()
export function min(items: [number]) : number 
  => items.reduce((acc, x) => acc < x ? acc : x, items.first())

## Minimum projected value across items.
## Example: files:min((f) => f.Size)
export function min(items: [object], project: lambda) : int 
  => items.reduce((acc, item) => project(item) < acc ? project(item) : acc, project(items.first()))

## Maximum value in an integer collection.
## Example: scores:max()
export function max(items: [int]) : int 
  => items.reduce((acc, x) => acc > x ? acc : x, items.first())

## Maximum value in a number collection.
## Example: measurements:max()
export function max(items: [number]) : number 
  => items.reduce((acc, x) => acc > x ? acc : x, items.first())

## Maximum projected value across items.
## Example: files:max((f) => f.Size)
export function max(items: [object], project: lambda) : int 
  => items.reduce((acc, item) => project(item) > acc ? project(item) : acc, project(items.first()))

## Average value of an integer collection.
## Example: scores:average()
export function average(items: [int]) : number 
  => items.sum() / items.count()

## Average value of a number collection.
## Example: measurements:average()
export function average(items: [number]) : number 
  => items.sum() / items.count()

## Average projected value across items.
## Example: files:average((f) => f.Size)
export function average(items: [object], project: lambda) : number 
  => items.sum(project) / items.count()
