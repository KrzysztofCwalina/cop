# Intrinsic Functions
# Functions implemented by the runtime engine.

# Provider Access

## Returns a dynamic object accessor for the named provider.
## Properties on the returned object query the provider's collections.
## Pass a path string for explicit target, or omit for default target directory.
## Example: provider('csharp') or provider('csharp', 'lib/MyLib.dll')
export function provider(name : string, options : object) : object => intrinsic

## Returns an async streaming collection from the named provider.
## The options argument is JSON-serialized and passed to the provider.
## Pass nic for default, or a string/object with provider-specific configuration.
## Use a typed annotation to declare the item type produced by the stream:
##   let req : [Request] = source('http', nic)
##   export function requests() : [Request] => req
export function source(name : string, options : object) : [object] => intrinsic

## Returns an async output collection for the named streaming provider.
## Items pushed into the sink are delivered to the provider's output channel.
## The options argument is JSON-serialized and passed to the provider.
## Pass nic for default, or a string/object with provider-specific configuration.
##   let resp : [Response] = sink('http', nic)
##   export function responses() : [Response] => resp
export function sink(name : string, options : object) : [object] => intrinsic

# I/O

## Reads the content of a file at the given path (sandboxed to project root).
## Returns the file content as a string.
export function read(path : string) : string => intrinsic

## Prints a message to the output.
## Used standalone: print('hello {Name}')
## Used in pipeline: foreach Types => print('{item.Name}')
## The template supports {Property} interpolation and {@style} formatting.
export function print(message : object) => intrinsic

## Saves content to a file at the specified path.
## Used in pipeline: foreach Types:isPublic => save('api.txt', '{item.Name}')
## Creates or appends to the file with the rendered template output.
export function save(path : string, content : string) => intrinsic

## Outputs a diagnostic message to the debug log (--diag flag).
## Same template semantics as print but only visible when diagnostics are enabled.
export function debug(message : object) => intrinsic

## Asserts that a condition is true. Fails the test run if false.
## Used in tests: assert(Types:isPublic.Count > 0, 'should have public types')
export function assert(condition : bool, description : string) => intrinsic

# Collections

## Reduces a collection to a single value using an accumulator function.
## The accumulator takes (acc, item) and returns the new accumulator value.
## Example: [1,2,3]:reduce((acc, item) => acc + item, 0)
export function reduce(items: [T], accumulator: (A, T) => A, initial: A) : A 
  => intrinsic

## Returns a new collection combining both collections.
## Example: let merged = listA:concat(listB)
export function concat(items: [T], other: [T]) : [T] 
  => intrinsic

# Text Conversion

## A template bound to data, ready to be resolved into a string.
## Items is the collection of data to format, Template is the {Property} interpolation pattern,
## and Separator is the string used to join results (defaults to newline).
export type InterpolatedString : object = {
    Items : [object]
    Template : string
    Separator : string
}

## Converts an integer to its decimal text representation.
export function text(int) : string => intrinsic

## Decodes a byte array as UTF-8 text.
export function text(bytes) : string => intrinsic

## Converts an InterpolatedString to text by resolving the Template against each item
## in Items using {Property} interpolation, then joining results with Separator.
export function text(InterpolatedString) : string => intrinsic

# Error Handling

## Represents an operational error flowing through a pipeline.
## Errors are not code bugs (use fail() for those). They represent external failures
## that code cannot prevent: network timeouts, I/O failures, malformed input.
## Use isError predicate to detect errors in pipeline items.
export type Error : object = {
    Message : string
    SourceFile : string
    SourceLine : int
    Source : string
}

## Returns true if the current item is an Error value.
## Works as a bare predicate or as a filter: items:isError
## Example: predicate handleError(item:isError) => print('{item.Message}')
export predicate isError(item: object) => item.Type:equals('Error')

## Creates an Error value with the given message string.
## Example: error('connection timeout')
export function error(message: string) : Error => intrinsic

## Terminates execution immediately with a fatal diagnostic.
## Use for programmer assertions — situations that should never occur.
## Can be used standalone: fail('invariant violated')
## Or in pipeline: foreach Items:badCondition => fail('{item.Name} is invalid')
export function fail(message : string) => intrinsic

# Utilities

## Returns the current program context.
## Provides access to command-line arguments and loaded providers.
export function program() : Program => intrinsic

## Represents the running program's context.
## Args: command-line arguments passed to the cop invocation.
## Providers: language providers loaded via -p flags (use with codebase()).
export type Program : object = {
    Args : [string],
    Providers : [Provider]
}

## Represents a loaded language provider (e.g., csharp, python).
## Providers are added to Program.Providers via the -p command-line flag.
## Access parsed data via codebase(Program.Providers) or individual parse() calls.
export type Provider : object = {
    Name : string
}

## Glob-matches a file path against a pattern.
## Supports **, *, ? wildcards. Returns true if the path matches.
export function pathMatches(path : string, pattern : string) : bool => intrinsic