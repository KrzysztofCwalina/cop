# alan Code Package v1.0
# Defines types and collections for source code structural analysis.
# Import with: import code

# Modifier flags — bit values match the code provider's CLR Modifier enum.
# Use with :isSet() and :isClear() predicates: Type.Modifiers:isSet(Public)
export flags Modifier = Public | Private | Protected | Internal | Static | Sealed | Abstract | Virtual | Async | Override | Readonly | Const

# Extensible enums — known values for Kind properties. Providers may return additional values.
export enum TypeKind = Class | Struct | Interface | Enum
export enum StatementKind = call | declaration | import | command | attribute | throw | return | using | foreach | try | catch | if | else | while | for | switch | await
export enum ApiKind = class | struct | interface | enum | enumvalue | ctor | method | property | event | field
export enum LineKind = code | comment | blank
export enum Language = csharp | python | javascript | rust | go | java | cop | text

export type Type = {
    Name : string,
    Kind : TypeKind,
    Modifiers : int,
    BaseTypes : [string],
    Interfaces : [string],
    Constructors : [Method],
    Methods : [Method],
    MethodNames : [string],
    NestedTypes : [Type],
    EnumValues : [string],
    Decorators : [string],
    Line : int,
    File : File?,
    Source : string,
    Documented : bool,
    Documentation : string?,
    Fields : [Field],
    Properties : [Property],
    Events : [Event]
}

export type Method = {
    Name : string,
    Modifiers : int,
    ReturnType : TypeReference?,
    Parameters : [Parameter],
    Statements : [Statement],
    Decorators : [string],
    Line : int,
    Documented : bool,
    Documentation : string?,
    File : File?,
    Source : string
}

export type Constructor = Method & {}

export type Field = {
    Name : string,
    Type : TypeReference?,
    Modifiers : int,
    Line : int
}

export type Property = {
    Name : string,
    Type : TypeReference?,
    Modifiers : int,
    HasGetter : bool,
    HasSetter : bool,
    Documented : bool,
    Documentation : string?,
    Line : int
}

export type Event = {
    Name : string,
    Type : TypeReference?,
    Modifiers : int,
    Line : int
}

export type Api = {
    Kind : ApiKind,
    TypeName : string,
    MemberName : string,
    Signature : string,
    Line : int,
    File : File?,
    Source : string
}

export type Parameter = {
    Name : string,
    Type : TypeReference?,
    Variadic : bool,
    Kwargs : bool,
    Defaulted : bool,
    DefaultValue : string?,
    Line : int
}

export type TypeReference = {
    Name : string,
    Namespace : string?,
    Generic : bool,
    GenericArguments : [TypeReference],
    Length : int
}

export type Statement = {
    Kind : StatementKind,
    Keywords : [string],
    TypeName : string?,
    MemberName : string?,
    Arguments : [string],
    Line : int,
    InMethod : bool,
    Rethrows : bool,
    Generic : bool,
    ErrorHandler : bool,
    Braced : bool,
    File : File?,
    Source : string,
    Method : Method?,
    Parent : Statement?,
    Children : [Statement],
    Ancestors : [Statement],
    Condition : string?,
    Expression : string?,
    CopIgnore : string,
    ConstructedTypeInterfaces : [string]
}

export type Call = Statement & {
    Signature : string
}

export type Declaration = Statement & {}

export type ErrorHandler = Statement & {}

export type Attribute = Statement & {}

# Modifier predicates — test flags on Type, Method, Field, Property, Event
export predicate isPublic(Type) => Type.Modifiers:isSet(Public)
export predicate isSealed(Type) => Type.Modifiers:isSet(Sealed)
export predicate isAbstract(Type) => Type.Modifiers:isSet(Abstract)
export predicate isStatic(Type) => Type.Modifiers:isSet(Static)
export predicate isDocumented(Type) => Type.Documented

export predicate isPublic(Method) => Method.Modifiers:isSet(Public)
export predicate isProtected(Method) => Method.Modifiers:isSet(Protected)
export predicate isPrivate(Method) => Method.Modifiers:isSet(Private)
export predicate isInternal(Method) => Method.Modifiers:isSet(Internal)
export predicate isAsync(Method) => Method.Modifiers:isSet(Async)
export predicate isStatic(Method) => Method.Modifiers:isSet(Static)
export predicate isAbstract(Method) => Method.Modifiers:isSet(Abstract)
export predicate isVirtual(Method) => Method.Modifiers:isSet(Virtual)
export predicate isOverride(Method) => Method.Modifiers:isSet(Override)
export predicate isDocumented(Method) => Method.Documented

export predicate isPublic(Field) => Field.Modifiers:isSet(Public)
export predicate isPrivate(Field) => Field.Modifiers:isSet(Private)
export predicate isProtected(Field) => Field.Modifiers:isSet(Protected)
export predicate isInternal(Field) => Field.Modifiers:isSet(Internal)
export predicate isStatic(Field) => Field.Modifiers:isSet(Static)
export predicate isReadonly(Field) => Field.Modifiers:isSet(Readonly)
export predicate isConst(Field) => Field.Modifiers:isSet(Const)

export predicate isPublic(Property) => Property.Modifiers:isSet(Public)
export predicate isProtected(Property) => Property.Modifiers:isSet(Protected)
export predicate isPrivate(Property) => Property.Modifiers:isSet(Private)
export predicate isInternal(Property) => Property.Modifiers:isSet(Internal)
export predicate isStatic(Property) => Property.Modifiers:isSet(Static)
export predicate isAbstract(Property) => Property.Modifiers:isSet(Abstract)
export predicate isVirtual(Property) => Property.Modifiers:isSet(Virtual)
export predicate isOverride(Property) => Property.Modifiers:isSet(Override)
export predicate hasGetter(Property) => Property.HasGetter
export predicate hasSetter(Property) => Property.HasSetter
export predicate isDocumented(Property) => Property.Documented

export predicate isPublic(Event) => Event.Modifiers:isSet(Public)
export predicate isProtected(Event) => Event.Modifiers:isSet(Protected)
export predicate isPrivate(Event) => Event.Modifiers:isSet(Private)
export predicate isInternal(Event) => Event.Modifiers:isSet(Internal)
export predicate isStatic(Event) => Event.Modifiers:isSet(Static)

# Narrowing predicates — filter Statements and narrow to subtypes
export predicate isCall(Statement) : Call => Statement.Kind == call
export predicate isDeclaration(Statement) : Declaration => Statement.Kind == declaration
export predicate isErrorHandler(Statement) : ErrorHandler => Statement.ErrorHandler == true
export predicate isAttribute(Statement) : Attribute => Statement.Kind == attribute
export predicate isControlFlow(Statement) => Statement.Kind == if || Statement.Kind == else || Statement.Kind == for || Statement.Kind == foreach || Statement.Kind == while

# ErrorHandler predicates
export predicate isGeneric(ErrorHandler) => ErrorHandler.Generic == true

export type Line = {
    Text : string,
    Number : int,
    Kind : LineKind,
    File : File?,
    Source : string,
    CopIgnore : string,
    PreviousText : string,
    NextText : string
}

export predicate isComment(Line) => Line.Kind == comment
export predicate isBlank(Line) => Line.Kind == blank

export type Region = {
    Name : string,
    StartLine : int,
    EndLine : int,
    Content : string,
    ContentHash : string,
    File : File?,
    Source : string
}

export type File = {
    Path : string,
    Language : Language?,
    Namespace : string?,
    Usings : [string],
    Types : [Type]
}

export type ProjectProperty = {
    Name : string,
    Value : string
}

export type Project = {
    Name : string,
    Path : string,
    Language : Language?,
    References : [string],
    Packages : [string],
    Frameworks : [string],
    Properties : [ProjectProperty]
}

export type Codebase = {
    Files : [File],
    Types : [Type],
    Statements : [Statement],
    Methods : [Method],
    Calls : [Statement],
    Lines : [Line],
    Regions : [Region],
    Projects : [Project]
}

## Creates a unified Codebase from one or more language providers.
## Example: let cb = codebase(Program.Providers)
export function codebase(providers : [Codebase]) : Codebase => {
    Types: reduce(providers, (acc, p) => acc + p.Types, []),
    Lines: reduce(providers, (acc, p) => acc + p.Lines, []),
    Statements: reduce(providers, (acc, p) => acc + p.Statements, []),
    Methods: reduce(providers, (acc, p) => acc + p.Methods, []),
    Files: reduce(providers, (acc, p) => acc + p.Files, []),
    Calls: reduce(providers, (acc, p) => acc + p.Calls, []),
    Regions: reduce(providers, (acc, p) => acc + p.Regions, []),
    Projects: reduce(providers, (acc, p) => acc + p.Projects, [])
}

# Language filter predicates
export predicate isCSharp(Type) => Type.File.Language == csharp
export predicate isCSharp(Statement) => Statement.File.Language == csharp
export predicate isCSharp(Method) => Method.File.Language == csharp
export predicate isCSharp(Line) => Line.File.Language == csharp
export predicate isCSharp(Region) => Region.File.Language == csharp
export predicate isCSharp(Api) => Api.File.Language == csharp

export predicate isPython(Type) => Type.File.Language == python
export predicate isPython(Statement) => Statement.File.Language == python
export predicate isPython(Method) => Method.File.Language == python
export predicate isPython(Line) => Line.File.Language == python
export predicate isPython(Region) => Region.File.Language == python
export predicate isPython(Api) => Api.File.Language == python

export predicate isJavaScript(Type) => Type.File.Language == javascript
export predicate isJavaScript(Statement) => Statement.File.Language == javascript
export predicate isJavaScript(Method) => Method.File.Language == javascript
export predicate isJavaScript(Line) => Line.File.Language == javascript
export predicate isJavaScript(Region) => Region.File.Language == javascript
export predicate isJavaScript(Api) => Api.File.Language == javascript

export predicate isRust(Type) => Type.File.Language == rust
export predicate isRust(Statement) => Statement.File.Language == rust
export predicate isRust(Method) => Method.File.Language == rust
export predicate isRust(Line) => Line.File.Language == rust
export predicate isRust(Region) => Region.File.Language == rust
export predicate isRust(Api) => Api.File.Language == rust

export predicate isGo(Type) => Type.File.Language == go
export predicate isGo(Statement) => Statement.File.Language == go
export predicate isGo(Method) => Method.File.Language == go
export predicate isGo(Line) => Line.File.Language == go
export predicate isGo(Region) => Region.File.Language == go
export predicate isGo(Api) => Api.File.Language == go

export predicate isJava(Type) => Type.File.Language == java
export predicate isJava(Statement) => Statement.File.Language == java
export predicate isJava(Method) => Method.File.Language == java
export predicate isJava(Line) => Line.File.Language == java
export predicate isJava(Region) => Region.File.Language == java
export predicate isJava(Api) => Api.File.Language == java
