import code
import csharp

# Language-independent predicate works on any Method regardless of source language
predicate isLong(Method) => Method.Statements.count() > 50

# Use explicit provider proxy
let cb : Codebase = provider('csharp')

command MAIN = foreach cb.Types => '{item.Name} ({item.File.Language})':Methods:isLong
    => '  {item.Name} ({item.Statements.count()} statements)'
