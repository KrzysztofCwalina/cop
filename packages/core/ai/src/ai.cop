# AI Judge Package
# Reviews a parsed codebase against a natural-language requirement using an LLM.
#
# Usage:
#   import ai
#   import code
#   import csharp
#   let cb = csharp.parse()
#   let violations = ai.judge('The core must remain general-purpose.', cb)
#   command MAIN = CHECK(violations)
#
# ai.judge(requirement: string, codebase: Codebase) returns [Violation].
# Use parse('path') to scope the codebase, or codebase(...) to combine languages.
# The provider supplies numbered source, file metadata, declarations, calls, and
# project dependencies. Strings and individual collections are not accepted.
#
# Configuration: create ~/.cop/ai.json (an OpenAI-compatible chat-completions
# endpoint). See ai.example.json for the format:
#   { "endpoint": "...", "model": "...", "apiKey": "..." }
#
# Example using GitHub Models (free with a GitHub account):
#   endpoint: https://models.github.ai/inference/chat/completions
#   model:    openai/gpt-4.1   (recommended — large context + strong judgment;
#             avoid gpt-4o-mini for codebase-scale checks: its ~8000-token
#             request cap is too small and its judgment is weaker)
#   apiKey:   a GitHub token with the 'models' scope
#            (e.g. run `gh auth token`, or create a PAT at
#             https://github.com/settings/tokens with Models access)
#
# Engine/CLI executions default to branch changes. The initial request sends only
# selected diffs; a tool-capable endpoint is REQUIRED (no silent fallback).
# Read/search tools can inspect unchanged eligible source anywhere under -t.
# Use --scope branch --base <ref> or --scope pr --pr <number-or-url> explicitly.
# --scope full opts into sending complete parsed source and architectural facts.
# Full scope still requires Codebase input, never strings or collections.
# No applicable changes means skipped review, zero model requests.
# Only use endpoints approved for the code being reviewed. Full mode rejects empty
# codebases. Diff mode accepts deletion-only empty Codebases with parser-stamped
# SourceScopes (preserved by codebase(...)). Missing provenance/source is an error.
# COP_AI_CONFIG can select another config file, for example for isolated CI tests.
#
# Transparency: pass --ai-log <path> to append a full
# transcript of each agent↔judge interaction (the request the runtime sent and
# the raw judge response) — useful for debugging and auditing LLM rules.
#
# ~/.cop/ai.json lives outside any repo and must never be committed.

import code
import markdown

## Reviews a parsed `codebase` against a natural-language `requirement`.
## Defaults to selected branch diffs, with bounded read/search source tools.
## Requires a tool-capable endpoint; --scope full explicitly reviews full parsed
## source, declarations and dependencies instead. Neither mode accepts strings
## or individual collections. Empty changes skip the review without model calls.
## Use language.parse('path') to scope input or codebase(...) to combine languages.
## Requires ~/.cop/ai.json, or the config file selected by COP_AI_CONFIG.
## Full mode rejects empty codebases; diff mode can review deletions using parser
## SourceScopes even after the last file was removed. Pass --ai-log <path>
## to record the full interaction. Strings and individual collections are unsupported.
## Limits: 8 requests, 16 tool calls, 256 KiB initial prompt, 2 MiB exchanges, 90s.
## Findings outside selected changed hunks and incomplete reviews are errors.
export function judge(requirement : string, codebase : Codebase) : [Violation] => intrinsic

## Reviews each section at ruleLevel (1-6) as one complete rule, including all
## paragraphs and nested content. Parent headings and prose supply context.
## Selected rules share one review and the existing source tools and budgets.
## An invalid level, missing rule sections, or a rule without a body is an error.
## Example: CHECK(ai.judge(markdown.parse('architecture.md'), csharp.parse(), 2))
export function judge(document : MarkdownContent, codebase : Codebase, ruleLevel : int) : [Violation] => intrinsic
