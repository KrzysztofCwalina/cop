# HTTP Server Package
# Provides helper functions for building HTTP responses in cop pipelines.
# Import with: import http
# Usage:
#   async foreach requests() => handle => responses()

let req : [Request] = source('http', { })
let resp : [Response] = sink('http', { })

## Returns the stream of incoming HTTP requests.
export function requests() : [Request] => req

## Returns the HTTP response sink for writing responses.
export function responses() : [Response] => resp

export enum HttpMethod = GET | POST | PUT | DELETE | PATCH | HEAD | OPTIONS
export enum ContentType = 'application/json' | 'text/plain' | 'text/html' | 'application/xml' | 'multipart/form-data' | 'application/octet-stream'

# Header entry — a single name/value pair
export type Header = {
    Name : string,
    Value : string
}

# Response type produced by helper functions
export type Response = {
    StatusCode : int,
    Body : bytes,
    ContentType : ContentType,
    Headers : [Header]
}

# Request type provided by the http streaming source
export type Request = {
    Method : HttpMethod,
    Uri : string,
    Body : bytes,
    ContentType : ContentType,
    Headers : [Header]
}

# Creates a 200 OK response with JSON body from a string value
export function ok(string) => Response {
    StatusCode = 200,
    Body = string,
    ContentType = 'application/json'
}

# Creates a 200 OK response with JSON body
export function ok(Request, body: string) => Response {
    StatusCode = 200,
    Body = body,
    ContentType = 'application/json'
}

# Creates a 200 OK response with empty body
export function ok(Request) => Response {
    StatusCode = 200,
    Body = 'OK',
    ContentType = 'application/json'
}

# Creates a 404 Not Found response
export function notFound(Request) => Response {
    StatusCode = 404,
    Body = 'Not Found',
    ContentType = 'application/json'
}

# Creates a 201 Created response
export function created(Request) => Response {
    StatusCode = 201,
    Body = 'Created',
    ContentType = 'application/json'
}

# Creates a 400 Bad Request response
export function badRequest(Request) => Response {
    StatusCode = 400,
    Body = 'Bad Request',
    ContentType = 'application/json'
}

# Creates a 500 Internal Server Error response
export function serverError(Request) => Response {
    StatusCode = 500,
    Body = 'Internal Server Error',
    ContentType = 'application/json'
}

# Creates a 500 Internal Server Error response from an error message
export function serverError(string) => Response {
    StatusCode = 500,
    Body = string,
    ContentType = 'application/json'
}
