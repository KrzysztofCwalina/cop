# TypeSpec HTTP protocol graph types

export enum HttpVerb = get | put | post | patch | delete | head
export enum HttpStatusCode = 200 | 201 | 204 | 304 | default
export enum HttpParameterLocation = path | query | header | body | cookie

export type TspDecorator = {
    Name : string,
    Arguments : [string]
}

export type HttpParameter = {
    Name : string,
    Type : string,
    In : HttpParameterLocation,
    Optional : bool,
    Style : string?
}

export type HttpHeader = {
    Name : string,
    Type : string
}

export type HttpResponse = {
    StatusCode : HttpStatusCode,
    Description : string?,
    Body : string?,
    Headers : [HttpHeader]
}

export type HttpOperation = {
    Name : string,
    Verb : HttpVerb,
    Path : string,
    UriTemplate : string,
    Parameters : [HttpParameter],
    Responses : [HttpResponse],
    Interface : string?,
    Decorators : [TspDecorator]
}

export type HttpService = {
    Name : string,
    Namespace : string,
    Operations : [HttpOperation],
    Auth : string?
}

# Provides TypeSpec HTTP protocol graph data
let tsp = provider('typespec-http', nic)

## Returns all HTTP operations defined in the TypeSpec project.
export function operations() : [HttpOperation] => tsp.Operations

## Returns all HTTP services defined in the TypeSpec project.
export function services() : [HttpService] => tsp.Services

# Common HTTP predicates
export predicate isGet(HttpOperation) => HttpOperation.Verb == get
export predicate isPut(HttpOperation) => HttpOperation.Verb == put
export predicate isPost(HttpOperation) => HttpOperation.Verb == post
export predicate isPatch(HttpOperation) => HttpOperation.Verb == patch
export predicate isDelete(HttpOperation) => HttpOperation.Verb == delete
