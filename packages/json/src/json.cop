# Cop JSON Package v1.0
# Provides json.Parse() for loading and querying JSON files.
# Import with: import json

## Parses a JSON file into a typed collection.
## The path is relative to the project root.
## The typeName must match a type declared in the current script.
## Example: json.Parse('settings.json', 'Config') returns [Config]
export function Parse(path : string, typeName : string) : Collection = provider
