# Checkov integration — runs Checkov and produces cop diagnostics
# Prerequisites: Checkov must be installed

import code-analysis

let data = provider('analysis-checkov', nic)

## Returns the Checkov diagnostics collection
export function diagnostics() : [Diagnostic] => data.Diagnostics
export let checkov-checks = data.Diagnostics

command main = foreach checkov-checks => '{item.FilePath}({item.Line}): {item.Severity}: {item.RuleId}: {item.Message}'
