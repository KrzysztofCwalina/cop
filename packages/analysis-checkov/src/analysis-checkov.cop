# Checkov integration — runs Checkov and produces cop Violations
# Prerequisites: Checkov must be installed

import code-analysis

let data = provider('analysis-checkov', nic)

## Returns the Checkov violations collection.
export function diagnostics() : [Violation] => data.Violations

## All Checkov violations as a collection.
export let checkov-checks = data.Violations

command MAIN = CHECK(checkov-checks)
