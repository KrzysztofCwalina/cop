# CodeQL Data Provider v1.0
# Reads CodeQL analysis results (SARIF format) and exposes them as cop Violations.
# Import with: import analysis-codeql
#
# Prerequisites:
#   - CodeQL CLI installed (https://github.com/github/codeql-cli-binaries)
#   - A CodeQL database created for your project
#   - SARIF results generated via: codeql database analyze <db> --format=sarif-latest --output=results.sarif
#
# The provider reads SARIF files from the target directory or a configured path.

import code-analysis

let data = provider('analysis-codeql', nic)

## All CodeQL violations as a collection.
export let codeql-checks = data.Violations

## A CodeQL rule definition
export type Rule
  Id : string
  Name : string
  Description : string
  Severity : string
  Tags : string
  Precision : string

## A CodeQL SARIF run (one per tool/suite)
export type Run
  Tool : string
  Version : string
  ResultCount : int

## Loads CodeQL SARIF results from a file path.
## Returns a collection of Result items.
## Example: analysis-codeql.Load('results.sarif')
export function Load(path : string) : object => provider('analysis-codeql', path)

command MAIN = CHECK(codeql-checks)
