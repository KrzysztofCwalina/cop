# Python checks — correctness, style, and idioms

import code
import python

let cb = codebase(python.parse())

## Correctness Checks

# Avoid print() — use logging
predicate isPrintCall(Statement) => Statement.Kind == 'call' && Statement.MemberName == 'print'

## Avoid print() — use logging instead
export let print-calls = cb.Statements:isPrintCall
    :toWarning('Avoid print() — use logging instead')

# Do not use bare except — catch a specific exception type
predicate isBareExcept(Statement) => Statement.ErrorHandler == true && Statement.TypeName == nic

## Do not use bare except — catch a specific exception type
export let bare-except-clauses = cb.Statements:isBareExcept
    :toWarning('Do not use bare except — catch a specific exception type')

# Do not silence Exception — reraise or catch a specific type
predicate isCatchingException(Statement) => Statement.ErrorHandler == true
    && Statement.Generic == true

predicate isSwallowingException(Statement) => Statement.ErrorHandler == true
    && Statement.Generic == true && !Statement.Rethrows

## Do not silence Exception — reraise or catch a specific type
export let silenced-exceptions = cb.Statements:isSwallowingException
    :toWarning('Do not silence Exception — reraise or catch a specific type')

# Do not import the six package (Python 2 compatibility layer)
predicate isImportingSix(Line) => Line.Text:matches('^(import six|from six)')

## Do not import the six package — Python 2 is no longer supported
export let no-six-import = cb.Lines:isImportingSix
    :toError('Do not import six — Python 2 is no longer supported')

# Do not use legacy typing via comments — use Python 3.9+ type hints
predicate hasLegacyTypingComment(Line) => Line.Text:matches('#\\s*type:')

## Do not use legacy type comments — use Python 3.9+ type annotations
export let no-legacy-typing = cb.Lines:hasLegacyTypingComment
    :toWarning('Do not use type comments — use Python 3.9+ type annotations')

# eval() is a security risk
predicate isEvalCall(Statement) => Statement.Kind == 'call' && Statement.MemberName == 'eval'

## Do not use eval() — it is a security risk
export let no-eval = cb.Statements:isEvalCall
    :toError('Do not use eval() — it is a security risk')

## Combined correctness checks
export let python-correctness-checks = print-calls + bare-except-clauses + silenced-exceptions + no-six-import + no-legacy-typing + no-eval

## Style Checks

# Class names should use PascalCase (CapWords)
predicate isNonPascalCaseClass(Type) => Type.Kind == 'Class'
    && !Type.Name:matches('^_?[A-Z][a-zA-Z0-9]*$')
    && !Type.Name:startsWith('__')

## Class names should use PascalCase (CapWords convention)
export let class-name-casing = cb.Types:isNonPascalCaseClass
    :toWarning('{item.Name} — class names should use PascalCase (CapWords)')

# Function/method names should use snake_case
predicate isNonSnakeCaseMethod(Method) => !Method.Name:matches('^_*[a-z][a-z0-9_]*$')
    && !Method.Name:startsWith('__')

predicate hasNonSnakeCaseMethods(Type) => Type.Methods:any(isNonSnakeCaseMethod)

## Function and method names should use snake_case
export let function-name-casing = cb.Types:hasNonSnakeCaseMethods
    :toWarning('{item.Name} has methods that do not follow snake_case naming')

# Wildcard imports: from x import *
predicate isWildcardImport(Line) => Line.Text:matches('^\\s*from\\s+\\S+\\s+import\\s+\\*')

## Avoid wildcard imports — import specific names instead
export let import-wildcard = cb.Lines:isWildcardImport
    :toWarning('Avoid wildcard imports — import specific names instead')

# Mutable default arguments
predicate hasMutableDefault(Parameter) => Parameter.Defaulted
    && (Parameter.DefaultValue == '[]' || Parameter.DefaultValue == '{}'
        || Parameter.DefaultValue:startsWith('list(') || Parameter.DefaultValue:startsWith('dict(')
        || Parameter.DefaultValue:startsWith('set('))

predicate hasMutableDefaultParam(Method) => Method.Parameters:any(hasMutableDefault)

predicate hasMutableDefaults(Type) => Type.Methods:any(hasMutableDefaultParam)

## Do not use mutable default arguments — use None and assign inside the function
export let mutable-default-arg = cb.Types:hasMutableDefaults
    :toWarning('{item.Name} has methods with mutable default arguments — use None instead')

# Trailing whitespace
predicate hasTrailingWhitespace(Line) => Line.Text:matches('\\S\\s+$')

## Lines should not have trailing whitespace
export let trailing-whitespace = cb.Lines:hasTrailingWhitespace
    :toInfo('Line has trailing whitespace')

# Mixed indentation (tabs)
predicate hasTabs(Line) => Line.Text:matches('^\\t')

## Use spaces for indentation, not tabs
export let mixed-indentation = cb.Lines:hasTabs
    :toWarning('Use spaces for indentation, not tabs (PEP 8)')

## Combined style checks
export let python-style-checks = class-name-casing + function-name-casing + import-wildcard + mutable-default-arg + trailing-whitespace + mixed-indentation

## Idiom Checks

# Use 'is None' / 'is not None' instead of '== None' / '!= None'
predicate isNoneEquality(Line) => Line.Text:matches('==\\s*None') || Line.Text:matches('!=\\s*None')

## Use 'is None' or 'is not None' instead of '== None' / '!= None'
export let none-comparison = cb.Lines:isNoneEquality
    :toWarning('Use "is None" or "is not None" instead of equality comparison')

# Use isinstance() instead of type() comparison
predicate isTypeComparison(Line) => Line.Text:matches('type\\s*\\(.*\\)\\s*==')
    || Line.Text:matches('type\\s*\\(.*\\)\\s*is\\s')

## Use isinstance() instead of type() comparison
export let type-comparison = cb.Lines:isTypeComparison
    :toWarning('Use isinstance() instead of type() comparison')

# Prefer f-strings over % formatting
predicate isPercentFormat(Line) => Line.Text:matches('%[sdrf]') && Line.Text:matches('%\\s*\\(')
    || Line.Text:matches('\\.format\\s*\\(')

## Prefer f-strings over %-style string formatting
export let old-style-format = cb.Lines:isPercentFormat
    :toInfo('Prefer f-strings over %-style string formatting')

# Prefer enumerate() over range(len(...))
predicate isRangeLen(Line) => Line.Text:matches('range\\s*\\(\\s*len\\s*\\(')

## Use enumerate() instead of range(len(...))
export let range-len-pattern = cb.Lines:isRangeLen
    :toWarning('Use enumerate() instead of range(len(...))')

# Avoid global statement
predicate isGlobalStatement(Line) => Line.Text:matches('^\\s*global\\s+')

## Avoid the global statement — pass values as parameters or use a class
export let global-statement = cb.Lines:isGlobalStatement
    :toWarning('Avoid the global statement — pass values as parameters or use a class')

## Combined idiom checks
export let python-idiom-checks = none-comparison + type-comparison + old-style-format + range-len-pattern + global-statement

## Quality Checks

# Too many parameters (>5, excluding self/cls)
predicate hasExcessiveParams(Method) => Method:isPublic
    && Method.Parameters.Count > 5
    && !Method.Name:startsWith('_')

predicate hasTooManyParams(Type) => Type.Methods:any(hasExcessiveParams)

## Functions should not have more than 5 parameters — consider using a config object or **kwargs
export let too-many-params = cb.Types:hasTooManyParams
    :toWarning('{item.Name} has methods with more than 5 parameters')

# Empty except body (except with only pass)
predicate isEmptyExcept(Statement) => Statement.ErrorHandler == true
    && Statement.Children.Count == 0

## Do not use empty except blocks — handle or log the exception
export let empty-except-body = cb.Statements:isEmptyExcept
    :toWarning('Empty except block — handle or log the exception instead of silencing it')

# Raising generic Exception()
predicate isRaisingGenericException(Statement) => Statement.Kind == 'throw'
    && (Statement.TypeName == 'Exception' || Statement.TypeName == 'BaseException')

## Raise specific exception types instead of generic Exception
export let broad-exception-raise = cb.Statements:isRaisingGenericException
    :toWarning('Raise a specific exception type instead of generic Exception')

## Combined quality checks
export let python-quality-checks = too-many-params + empty-except-body + broad-exception-raise

## Documentation Checks

# Missing class docstring
predicate isPublicClass(Type) => Type.Kind == 'Class'
    && !Type.Name:startsWith('_')

predicate isUndocumentedPublicClass(Type) => isPublicClass && !Type.Documented

## Public classes should have a docstring
export let missing-class-docstring = cb.Types:isUndocumentedPublicClass
    :toWarning('{item.Name} — public classes should have a docstring')

# Missing function/method docstring
predicate isUndocumentedPublicMethod(Method) => Method:isPublic
    && !Method.Name:startsWith('_')
    && !Method.Documented

predicate hasUndocumentedMethods(Type) => Type.Methods:any(isUndocumentedPublicMethod)

## Public functions and methods should have a docstring
export let missing-function-docstring = cb.Types:hasUndocumentedMethods
    :toWarning('{item.Name} has public methods without docstrings')

## Combined documentation checks
export let python-doc-checks = missing-class-docstring + missing-function-docstring

## All Python checks combined
export let python-checks = python-correctness-checks + python-style-checks + python-idiom-checks + python-quality-checks + python-doc-checks

command MAIN = CHECK(python-checks)
