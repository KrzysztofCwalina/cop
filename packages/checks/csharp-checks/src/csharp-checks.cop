# C# checks — correctness, style, and Framework Design Guidelines

import code
import csharp

let cb = codebase(csharp.parse())

# Honor `// cop-ignore: <check>` comments on the next statement or line.
predicate notIgnored(Statement) =>
    isUnsuppressed(Statement)
predicate lineNotIgnored(Line) =>
    isUnsuppressed(Line)

## Correctness Checks

# Typing

# Anonymous types, including generic arguments, have no explicit C# type spelling.
predicate containsAnonymousType(TypeReference) =>
    TypeReference.IsAnonymous == true ||
    TypeReference.GenericArguments:any(containsAnonymousType)

predicate isVarDeclaration(Statement) =>
    Statement.Kind == declaration &&
    Statement.Keywords:contains('var') &&
    (Statement.ValueType == nic ||
        !Statement.ValueType:containsAnonymousType)

predicate isDynamicDeclaration(Statement) =>
    Statement.Kind == 'declaration' &&
    Statement.Keywords:contains('dynamic')

## Disallow implicit typing with var — use explicit types
export function varDeclarations(cb: Codebase) : [Violation] => cb.Statements:isVarDeclaration:notIgnored
        :toError('Do not use \'var\' for {item.MemberName}', nameof(var-declarations))

export let var-declarations = varDeclarations(cb)

## Disallow dynamic typing
export function dynamicDeclarations(cb: Codebase) : [Violation] => cb.Statements:isDynamicDeclaration:notIgnored
        :toError('Do not use \'dynamic\'', nameof(dynamic-declarations))

export let dynamic-declarations = dynamicDeclarations(cb)

# Async and threading

predicate isThreadSleep(Statement) =>
    Statement.Kind == call &&
    hasTypeName(Statement, ['Thread']) &&
    hasMemberName(Statement, ['Sleep'])

predicate isConfigureAwaitTrue(Statement) =>
    Statement.Kind == call &&
    Statement.MemberName == 'ConfigureAwait' &&
    Statement.ArgumentExpressions.Count == 1 &&
    Statement.ArgumentExpressions[0].Kind == booleanLiteral &&
    Statement.ArgumentExpressions[0].BooleanValue == true

predicate isGetAwaiterGetResult(Statement) => Statement.Kind == 'call'
    && Statement.MemberName == 'GetResult'

predicate hasAsyncContinuationsOption(CodeExpression) =>
    (CodeExpression.Kind == memberAccess &&
        CodeExpression.Name == 'RunContinuationsAsynchronously' &&
        CodeExpression.Target != nic &&
        CodeExpression.Target.Name == 'TaskCreationOptions') ||
    (CodeExpression.Kind == binary &&
        CodeExpression.Name == 'BitwiseOrExpression' &&
        CodeExpression.Children:any(hasAsyncContinuationsOption))

predicate isTaskCompletionSourceNew(Statement) =>
    Statement.Kind == call &&
    Statement.MemberName == nic &&
    Statement.ValueType.Name == 'TaskCompletionSource' &&
    Statement.ValueType.Namespace == 'System.Threading.Tasks' &&
    !Statement.ArgumentExpressions:any(hasAsyncContinuationsOption)

# Sync-blocking call patterns (reusable by any check)
export predicate isSyncBlockingCall(Statement) =>
    Statement.Kind == call &&
    hasMemberName(Statement, ['Wait', 'GetResult'])

# Statement is inside an async method
export predicate isInAsyncMethod(Statement) =>
    Statement.Method != nic &&
    Statement.Method.Modifiers:isSet(Async)

# Statement is inside a non-async method
export predicate isInSyncMethod(Statement) =>
    Statement.Method != nic &&
    Statement.Method.Modifiers:isClear(Async)

## Use Task.Delay instead of blocking Thread.Sleep
export function threadSleepCalls(cb: Codebase) : [Violation] => cb.Statements:isThreadSleep:notIgnored
        :toError('Use Task.Delay instead of Thread.Sleep', nameof(thread-sleep-calls))

export let thread-sleep-calls = threadSleepCalls(cb)

## ConfigureAwait(true) is the default and should not be used explicitly
export function configureAwaitTrueCalls(cb: Codebase) : [Violation] => cb.Statements:isConfigureAwaitTrue:notIgnored
        :toWarning(
            'Do not use ConfigureAwait(true) — it is the default',
            nameof(configure-await-true-calls))

export let configure-await-true-calls = configureAwaitTrueCalls(cb)

## Do not block on async code with GetAwaiter().GetResult()
export function syncOverAsyncCalls(cb: Codebase) : [Violation] => cb.Statements:isGetAwaiterGetResult:notIgnored
        :toWarning(
            'Do not use GetAwaiter().GetResult() — use await instead',
            nameof(sync-over-async-calls))

export let sync-over-async-calls = syncOverAsyncCalls(cb)

## TaskCompletionSource should be created with RunContinuationsAsynchronously
export function bareTaskCompletionSources(cb: Codebase) : [Violation] => cb.Statements:isTaskCompletionSourceNew:notIgnored
        :toWarning(
            'Create TaskCompletionSource with RunContinuationsAsynchronously',
            nameof(bare-task-completion-sources))

export let bare-task-completion-sources = bareTaskCompletionSources(cb)

## Do not use sync-blocking calls (.Wait(), .GetResult()) inside async methods (AZC0103)
export function syncWaitInAsync(cb: Codebase) : [Violation] => cb.Statements:isSyncBlockingCall:isInAsyncMethod:notIgnored
        :toError(
            'Do not use {item.MemberName} in async method — use await instead',
            nameof(sync-wait-in-async))

export let sync-wait-in-async = syncWaitInAsync(cb)

# Console output

predicate isConsoleCall(Statement) =>
    Statement.Kind == call &&
    hasTypeName(Statement, ['Console'])

predicate isExecutableProject(Project) =>
    hasProjectPropertyValue(Project, 'OutputType', 'Exe') ||
    hasProjectPropertyValue(Project, 'OutputType', 'WinExe')

function consoleCallsOutsideFiles(statements: [Statement], executable-files: [string])
    : [Statement] =>
    statements:isConsoleCall:notIgnored
        .Where(!item.File.FullPath:in(executable-files) &&
            !item.File.Path:in(executable-files))

## Avoid Console output in library code
export function consoleCalls(cb: Codebase) : [Violation] => consoleCallsOutsideFiles(cb.Statements, reduce(cb.Projects:isExecutableProject,
        (files, project) => files +
            (project.SourceFiles == nic ? [] : project.SourceFiles), []))
        :toWarning(
            'Don\'t use Console.{item.MemberName} in library code',
            nameof(console-calls))

export let console-calls = consoleCalls(cb)

# Exception handling

predicate isCatchingBaseException(CSharpStatement) =>
    CSharpStatement.ErrorHandler &&
    CSharpStatement.Generic &&
    !CSharpStatement.HasTypeRestrictedCatchFilter

# Empty catch — catches base Exception and does nothing (no statements in catch body)
predicate isEmptyCatch(CSharpStatement) =>
    isSwallowingBaseException(CSharpStatement) &&
    CSharpStatement.Children.count() == 0

predicate isSwallowingBaseException(CSharpStatement) =>
    isCatchingBaseException(CSharpStatement) &&
    !alwaysRethrowsOriginalException(CSharpStatement)

## Catch specific exception types instead of bare Exception
export function baseExceptionCatches(cb: Codebase) : [Violation] => cb.Statements:asCSharp:isCatchingBaseException
        :!alwaysRethrowsOriginalException:notIgnored
        :toWarning(
            'Catch a specific exception type instead of Exception',
            nameof(base-exception-catches))

export let base-exception-catches = baseExceptionCatches(cb)

## Do not swallow base exceptions — always rethrow
export function swallowedExceptions(cb: Codebase) : [Violation] => cb.Statements:asCSharp:isSwallowingBaseException:notIgnored
        :toWarning(
            'Do not swallow Exception — rethrow or catch a specific type',
            nameof(swallowed-exceptions))

export let swallowed-exceptions = swallowedExceptions(cb)

## Empty catch — catches base Exception and does absolutely nothing
export function emptyCatches(cb: Codebase) : [Violation] => cb.Statements:asCSharp:isEmptyCatch:notIgnored
        :toError(
            'Empty catch block swallows all exceptions silently',
            nameof(empty-catches))

export let empty-catches = emptyCatches(cb)

# Banned APIs

# Banned API: Uri.ToString() — prefer Uri.AbsoluteUri for consistent output
predicate isUriToString(Statement) => Statement.Kind == 'call'
    && Statement.MemberName == 'ToString'
    && Statement.TypeName != nic && Statement.TypeName:matches('[Uu]ri')

## Banned API: Uri.ToString() — use Uri.AbsoluteUri for consistent output
export function uriTostring(cb: Codebase) : [Violation] => cb.Statements:isUriToString:notIgnored
        :toWarning('Use Uri.AbsoluteUri instead of Uri.ToString()', nameof(uri-tostring))

export let uri-tostring = uriTostring(cb)

# Naming

# CA1716: Identifiers should not match C# reserved keywords
let csharpKeywords = ['abstract' 'as' 'base' 'bool' 'break' 'byte' 'case' 'catch'
    'char' 'checked' 'class' 'const' 'continue' 'decimal' 'default' 'delegate'
    'do' 'double' 'else' 'enum' 'event' 'explicit' 'extern' 'false' 'finally'
    'fixed' 'float' 'for' 'foreach' 'goto' 'if' 'implicit' 'in' 'int'
    'interface' 'internal' 'is' 'lock' 'long' 'namespace' 'new' 'null'
    'object' 'operator' 'out' 'override' 'params' 'private' 'protected' 'public'
    'readonly' 'ref' 'return' 'sbyte' 'sealed' 'short' 'sizeof' 'stackalloc'
    'static' 'string' 'struct' 'switch' 'this' 'throw' 'true' 'try' 'typeof'
    'uint' 'ulong' 'unchecked' 'unsafe' 'ushort' 'using' 'virtual' 'void'
    'volatile' 'while']
predicate hasKeywordName(Type) => csharpKeywords:contains(Type.Name)

## CA1716: Type names should not match C# reserved keywords
export function typeNameIsKeyword(cb: Codebase) : [Violation] => cb.Types:hasKeywordName
        :toWarning(
            'CA1716: Type name {item.Name} matches a C# reserved keyword',
            nameof(type-name-is-keyword))

export let type-name-is-keyword = typeNameIsKeyword(cb)

# Code analysis rules

# CA1812: Avoid uninstantiated internal classes
predicate isInternalConcreteClass(Type) =>
    Type.Kind == Class &&
    Type:!isPublic &&
    Type:!isAbstract &&
    Type:!isStatic

function internalTypesWithoutCalls(types: [Type], constructedNames: [string]) : [Type] =>
    types:isInternalConcreteClass
        .Where(!constructedNames:contains(declarationIdentity(item)))

function declarationIdentity(Type) : string =>
    '{Type.Namespace}:{Type.Name}:{Type.TypeParameters.Count}'

function referenceIdentity(reference: TypeReference) : string =>
    '{reference.Namespace}:{reference.Name}:{reference.GenericArguments.Count}'

## CA1812: Find concrete internal classes without a constructor call in this codebase.
## Reflection and construction in unparsed source are not visible to this heuristic.
export function uninstantiatedInternal(cb: Codebase) : [Violation] => internalTypesWithoutCalls(cb.Types, cb.Calls
        .Where(item.MemberName == nic && item.ValueType.Name != nic)
        .Select(referenceIdentity(item.ValueType)))
        :toWarning(
            'CA1812: No constructor call found for internal class {item.Name}',
            nameof(uninstantiated-internal))

export let uninstantiated-internal = uninstantiatedInternal(cb)

# CA2000: IDisposable not in using statement
predicate isDisposableNew(CSharpStatement) => CSharpStatement.Kind == call
    && CSharpStatement.MemberName == nic
    && CSharpStatement.ConstructedTypeInterfaces:contains('IDisposable')
    && !CSharpStatement.IsUsingResource
    && !CSharpStatement.IsOwnershipTransferred

## CA2000: Dispose objects before losing scope
export function undisposedNew(cb: Codebase) : [Violation] => cb.Statements:asCSharp:isDisposableNew:notIgnored
        :toWarning(
            'CA2000: Review disposal or ownership of {item.TypeName}',
            nameof(undisposed-new))

export let undisposed-new = undisposedNew(cb)

# Project files

# TODO: readme-install-package and cpm-compliance checks require a text/line provider
# for .md and .csproj files.

## Combined correctness checks
export function csharpCorrectnessChecks(cb: Codebase) : [Violation] =>
    varDeclarations(cb) +
    dynamicDeclarations(cb) +
    threadSleepCalls(cb) +
    consoleCalls(cb) +
    baseExceptionCatches(cb) +
    swallowedExceptions(cb) +
    configureAwaitTrueCalls(cb) +
    syncOverAsyncCalls(cb) +
    bareTaskCompletionSources(cb) +
    syncWaitInAsync(cb) +
    uriTostring(cb) +
    typeNameIsKeyword(cb) +
    uninstantiatedInternal(cb) +
    undisposedNew(cb)

export let csharp-correctness-checks = csharpCorrectnessChecks(cb)

## Style Checks (StyleCop)

# SA1302: Interface names must begin with 'I' followed by an uppercase letter
predicate isMissingIPrefix(Type) =>
    Type.Kind == 'Interface' &&
    !Type.Name:matches('^I[A-Z]')

# SA1300: Type names must begin with an uppercase letter (PascalCase)
predicate hasLowercaseTypeName(Type) => Type.Name:matches('^[a-z]')

# SA1300: Public method names must begin with an uppercase letter (PascalCase)
predicate isLowercasePublicMethod(Method) =>
    Method:isPublic &&
    Method.Name:matches('^[a-z]')
predicate hasLowercasePublicMethod(Type) => Type.Methods:any(isLowercasePublicMethod)

## SA1302: Interface names must begin with 'I' followed by an uppercase letter
export function interfacePrefix(cb: Codebase) : [Violation] => cb.Types:isMissingIPrefix
        :toWarning(
            'SA1302: Interface {item.Name} needs an I + uppercase prefix',
            nameof(interface-prefix))

export let interface-prefix = interfacePrefix(cb)

## SA1300: Type names must begin with an uppercase letter (PascalCase)
export function typeNameCasing(cb: Codebase) : [Violation] => cb.Types:hasLowercaseTypeName
        :toWarning(
            'SA1300: Type {item.Name} should begin with an uppercase letter',
            nameof(type-name-casing))

export let type-name-casing = typeNameCasing(cb)

## SA1300: Public method names must begin with an uppercase letter (PascalCase)
export function methodNameCasing(cb: Codebase) : [Violation] => cb.Types:hasLowercasePublicMethod
        :toWarning(
            'SA1300: Public methods on {item.Name} need uppercase names',
            nameof(method-name-casing))

export let method-name-casing = methodNameCasing(cb)

# File structure

# SA1402: File may only contain a single type
predicate hasMultipleTypesInFile(Type) => Type.File.Types.Count > 1

# SA1633: File must have a header (first line should be a comment)
predicate isMissingFileHeader(Line) =>
    Line.Number == 1 &&
    Line.Kind != comment

## SA1402: A file may only contain a single type
export function singleTypePerFile(cb: Codebase) : [Violation] => cb.Types:hasMultipleTypesInFile
        :toWarning(
            'SA1402: {item.Name} — file should contain only a single type',
            nameof(single-type-per-file))

export let single-type-per-file = singleTypePerFile(cb)

## SA1633: File must have a header
export function fileHeaderRequired(cb: Codebase) : [Violation] => cb.Lines:isMissingFileHeader:lineNotIgnored
        :toWarning(
            'SA1633: File should begin with a header comment',
            nameof(file-header-required))

export let file-header-required = fileHeaderRequired(cb)

# Whitespace and formatting

# SA1005: Single-line comment must begin with a space after //
predicate isUnspacedComment(Comment) =>
    Comment.Kind == 'singleLine' &&
    Comment.Content.Length > 0 &&
    !Comment.Content:startsWith(' ') &&
    !Comment.Content:startsWith('/') &&
    !Comment.Content:startsWith('!')
predicate isCommentMissingSpace(Line) =>
    Line.Comments:any(isUnspacedComment)

# SA1027: Code must not contain tabs
predicate hasTab(Line) => Line.Text:matches('\t')

# SA1028: Code must not contain trailing whitespace
predicate hasTrailingWhitespace(Line) => Line.Text:matches('[ \t]+$')

# SA1106: Code must not contain empty statements (stray semicolons)
predicate isEmptyStatement(Statement) =>
    Statement.Kind == empty

# SA1122: Use string.Empty for empty strings in comparisons
predicate isEmptyStringLiteral(CodeExpression) =>
    CodeExpression.Kind == stringLiteral &&
    CodeExpression.StringValue == ''
predicate isEmptyStringComparison(CodeExpression) =>
    CodeExpression.Kind == binary &&
    CodeExpression.Name:in(['EqualsExpression', 'NotEqualsExpression']) &&
    CodeExpression.Children:any(isEmptyStringLiteral)
predicate containsEmptyStringComparison(CodeExpression) =>
    isEmptyStringComparison ||
    CodeExpression.Children:any(containsEmptyStringComparison)
predicate hasEmptyStringLiteral(Statement) =>
    (Statement.ValueExpression.Kind != nic &&
        Statement.ValueExpression:containsEmptyStringComparison) ||
    (Statement.ConditionExpression.Kind != nic &&
        Statement.ConditionExpression:containsEmptyStringComparison) ||
    Statement.ArgumentExpressions:any(containsEmptyStringComparison)

## SA1005: Single-line comment must begin with a space after //
export function commentSpacing(cb: Codebase) : [Violation] => cb.Lines:isCommentMissingSpace:lineNotIgnored
        :toWarning(
            'SA1005: Single-line comment should begin with a space',
            nameof(comment-spacing))

export let comment-spacing = commentSpacing(cb)

## SA1027: Code must not contain tabs
export function noTabs(cb: Codebase) : [Violation] => cb.Lines:hasTab:lineNotIgnored
        :toWarning('SA1027: Use spaces instead of tabs', nameof(no-tabs))

export let no-tabs = noTabs(cb)

## SA1028: Code must not contain trailing whitespace
export function noTrailingWhitespace(cb: Codebase) : [Violation] => cb.Lines:hasTrailingWhitespace:lineNotIgnored
        :toWarning('SA1028: Remove trailing whitespace', nameof(no-trailing-whitespace))

export let no-trailing-whitespace = noTrailingWhitespace(cb)

## SA1106: Code must not contain empty statements
export function noEmptyStatements(cb: Codebase) : [Violation] => cb.Statements:isEmptyStatement:notIgnored
        :toWarning('SA1106: Remove empty statement', nameof(no-empty-statements))

export let no-empty-statements = noEmptyStatements(cb)

## SA1122: Use string.Empty instead of ""
export function useStringEmpty(cb: Codebase) : [Violation] => cb.Statements:hasEmptyStringLiteral:notIgnored
        :toWarning('SA1122: Use string.Empty instead of ""', nameof(use-string-empty))

export let use-string-empty = useStringEmpty(cb)

# Braces

# SA1503: Braces must not be omitted from control flow
predicate isElseIf(Statement) =>
    Statement.Kind == else &&
    Statement.Children.Count == 1 &&
    Statement.Children[0].Kind == if

predicate isMissingBraces(Statement) => Statement.Braced == false
    && !isElseIf
    && (Statement.Kind == 'if' ||
        Statement.Kind == 'else' ||
        Statement.Kind == 'for' ||
        Statement.Kind == 'foreach' ||
        Statement.Kind == 'while')

## SA1503: Braces must not be omitted
export function requiredBraces(cb: Codebase) : [Violation] => cb.Statements:isMissingBraces:notIgnored
        :toWarning(
            'SA1503: Braces must not be omitted from control flow statement',
            nameof(required-braces))

export let required-braces = requiredBraces(cb)

# Documentation

# SA1600: Public elements should be documented (have XML doc comments)
predicate isPublicUndocumented(Type) => Type:isPublic && !Type.Documented
predicate isUndocumentedPublicMethod(Method) => Method:isPublic && !Method.Documented
predicate hasUndocumentedPublicMethod(Type) =>
    Type.Methods:any(isUndocumentedPublicMethod)

# SA1600: Public properties should be documented
predicate isUndocumentedPublicProperty(Property) =>
    Property:isPublic &&
    !Property.Documented
predicate hasUndocumentedPublicProperty(Type) =>
    Type.Properties:any(isUndocumentedPublicProperty)

## SA1600: Public elements should be documented
export function publicDocumented(cb: Codebase) : [Violation] => cb.Types:isPublicUndocumented
        :toWarning(
            'SA1600: Public type {item.Name} should have XML documentation',
            nameof(public-documented))

export let public-documented = publicDocumented(cb)

export function publicMethodDocumented(cb: Codebase) : [Violation] => cb.Types:hasUndocumentedPublicMethod
        :toWarning(
            'SA1600: {item.Name} has a public method without XML documentation',
            nameof(public-method-documented))

export let public-method-documented = publicMethodDocumented(cb)

## SA1600: Public properties should be documented
export function publicPropertyDocumented(cb: Codebase) : [Violation] => cb.Types:hasUndocumentedPublicProperty
        :toWarning(
            'SA1600: {item.Name} has a public property without XML documentation',
            nameof(public-property-documented))

export let public-property-documented = publicPropertyDocumented(cb)

# Fields

# SA1401: Fields should be private (non-const, non-static-readonly public fields are bad)
predicate isPublicNonConstField(Field) =>
    Field:isPublic &&
    Field:!isConst &&
    !(Field:isStatic &&
    Field:isReadonly)
predicate hasPublicField(Type) => Type.Fields:any(isPublicNonConstField)

# .editorconfig naming: private fields should start with _
predicate isPrivateFieldMissingUnderscore(Field) =>
    Field:isPrivate &&
    Field:!isStatic &&
    Field:!isConst &&
    !Field.Name:matches('^_')
predicate hasPrivateFieldNamingViolation(Type) =>
    Type.Fields:any(isPrivateFieldMissingUnderscore)

# .editorconfig naming: private static fields should start with s_
predicate isStaticFieldMissingSPrefix(Field) =>
    Field:isPrivate &&
    Field:isStatic &&
    Field:!isConst &&
    !Field.Name:matches('^s_')
predicate hasStaticFieldNamingViolation(Type) =>
    Type.Fields:any(isStaticFieldMissingSPrefix)

# .editorconfig naming: constants should be PascalCase
predicate isConstFieldNotPascalCase(Field) =>
    Field:isConst &&
    !Field.Name:matches('^[A-Z]')
predicate hasConstNamingViolation(Type) => Type.Fields:any(isConstFieldNotPascalCase)

## SA1401: Fields on public or protected types should be private.
## Internal structs may expose fields for performance.
export function noPublicFields(cb: Codebase) : [Violation] => cb.Types:isPublic:hasPublicField
        :toWarning(
            'SA1401: {item.Name} has a public non-const field; use a property instead',
            nameof(no-public-fields))

export let no-public-fields = noPublicFields(cb)

## .editorconfig naming: private field underscore prefix
export function privateFieldNaming(cb: Codebase) : [Violation] => cb.Types:hasPrivateFieldNamingViolation
        :toWarning(
            '{item.Name} has a private field that should start with underscore (_)',
            nameof(private-field-naming))

export let private-field-naming = privateFieldNaming(cb)

## .editorconfig naming: static field s_ prefix
export function staticFieldNaming(cb: Codebase) : [Violation] => cb.Types:hasStaticFieldNamingViolation
        :toWarning(
            '{item.Name} has a private static field that should start with s_',
            nameof(static-field-naming))

export let static-field-naming = staticFieldNaming(cb)

## .editorconfig naming: const PascalCase
export function constNaming(cb: Codebase) : [Violation] => cb.Types:hasConstNamingViolation
        :toWarning(
            '{item.Name} has a constant that should be PascalCase',
            nameof(const-naming))

export let const-naming = constNaming(cb)

## Combined style checks
export function csharpStyleChecks(cb: Codebase) : [Violation] =>
    interfacePrefix(cb) +
    typeNameCasing(cb) +
    methodNameCasing(cb) +
    singleTypePerFile(cb) +
    commentSpacing(cb) +
    noTabs(cb) +
    noTrailingWhitespace(cb) +
    noEmptyStatements(cb) +
    useStringEmpty(cb) +
    fileHeaderRequired(cb) +
    publicDocumented(cb) +
    publicMethodDocumented(cb) +
    noPublicFields(cb) +
    privateFieldNaming(cb) +
    staticFieldNaming(cb) +
    constNaming(cb) +
    requiredBraces(cb) +
    publicPropertyDocumented(cb)

export let csharp-style-checks = csharpStyleChecks(cb)

## Framework Design Guidelines — Naming

# Types inheriting from Exception must end with 'Exception'
let exception-base-names = [
    'Exception', 'SystemException', 'ApplicationException',
    'InvalidOperationException', 'ArgumentException', 'IOException'
]

predicate isExceptionBase(Type) =>
    derivesFromAny(Type, exception-base-names)

predicate isMissingExceptionSuffix(Type) =>
    Type:isExceptionBase &&
    !Type.Name:endsWith('Exception')

## FDG: Types inheriting from Exception must end with 'Exception'
export function exceptionSuffix(cb: Codebase) : [Violation] => cb.Types:isMissingExceptionSuffix
        :toWarning(
            '{item.Name} derives from Exception; use an Exception suffix',
            nameof(exception-suffix))

export let exception-suffix = exceptionSuffix(cb)

# Types inheriting from Attribute must end with 'Attribute'
predicate isAttributeBase(Type) =>
    derivesFromAny(Type, ['Attribute'])
predicate isMissingAttributeSuffix(Type) =>
    Type:isAttributeBase &&
    !Type.Name:endsWith('Attribute')

## FDG: Types inheriting from Attribute must end with 'Attribute'
export function attributeSuffix(cb: Codebase) : [Violation] => cb.Types:isMissingAttributeSuffix
        :toWarning(
            '{item.Name} derives from Attribute; use an Attribute suffix',
            nameof(attribute-suffix))

export let attribute-suffix = attributeSuffix(cb)

# Types inheriting from EventArgs must end with 'EventArgs'
predicate isEventArgsBase(Type) =>
    derivesFromAny(Type, ['EventArgs'])
predicate isMissingEventArgsSuffix(Type) =>
    Type:isEventArgsBase &&
    !Type.Name:endsWith('EventArgs')

## FDG: Types inheriting from EventArgs must end with 'EventArgs'
export function eventargsSuffix(cb: Codebase) : [Violation] => cb.Types:isMissingEventArgsSuffix
        :toWarning(
            '{item.Name} derives from EventArgs; use an EventArgs suffix',
            nameof(eventargs-suffix))

export let eventargs-suffix = eventargsSuffix(cb)

# Types inheriting from Stream must end with 'Stream'
predicate isStreamBase(Type) =>
    derivesFromAny(Type, ['Stream'])
predicate isMissingStreamSuffix(Type) =>
    Type:isStreamBase &&
    !Type.Name:endsWith('Stream')

## FDG: Types inheriting from Stream must end with 'Stream'
export function streamSuffix(cb: Codebase) : [Violation] => cb.Types:isMissingStreamSuffix
        :toWarning(
            'FDG Naming: {item.Name} inherits from Stream but does not end with Stream',
            nameof(stream-suffix))

export let stream-suffix = streamSuffix(cb)

# Classes should not use Hungarian notation (C prefix)
let familiar-c-prefixes =
    '^(CSharp|Cli[a-z]|Client|Cloud|Clone|Clos|Cluster|Collection|Column|Comma|' +
    'Compar|Compil|Compo|Comput|Concat|Concurr|Config|Connect|Console|Constraint|' +
    'Convert|Crypt|Custom|Context|Contract|Controller|Cursor)'

predicate hasHungarianPrefix(Type) => Type.Kind == 'Class'
    && Type.Name:matches('^C[A-Z][a-z]')
    && !Type.Name:matches(familiar-c-prefixes)

## FDG: Classes should not use Hungarian notation (C prefix)
export function noHungarianPrefix(cb: Codebase) : [Violation] => cb.Types:hasHungarianPrefix
        :toWarning(
            'FDG Naming: {item.Name} uses Hungarian C prefix — remove it',
            nameof(no-hungarian-prefix))

export let no-hungarian-prefix = noHungarianPrefix(cb)

# Boolean properties should use affirmative naming (Is/Has/Can/Should/Was/Will)
let affirmative-bool-prefixes =
    '^(Is|Has|Can|Should|Was|Will|Are|Supports|Allows|Needs|Contains|Includes|' +
    'Requires|Enables)'
let descriptive-bool-prefixes =
    '^(Value|BooleanValue|Exists|Enabled|Visible|Active|Valid|Available|Ready|Empty|Open|Closed|' +
    'Connected|Locked)'

predicate isBoolProperty(Property) => Property:isPublic && Property.Type.Name == 'bool'
predicate hasBadBoolName(Property) => Property:isBoolProperty
    && !Property.Name:matches(affirmative-bool-prefixes)
    && !Property.Name:matches(descriptive-bool-prefixes)
predicate hasBadBoolProperty(Type) => Type.Properties:any(hasBadBoolName)

## FDG: Boolean properties should use affirmative naming
export function boolPropertyNaming(cb: Codebase) : [Violation] => cb.Types:hasBadBoolProperty
        :toInfo(
            'Name bool properties on {item.Name} with Is, Has, Can, or similar',
            nameof(bool-property-naming))

export let bool-property-naming = boolPropertyNaming(cb)

# Namespace should have at least two segments (Company.Product)
predicate hasShortNamespace(Type) =>
    Type.File.Namespace != nic &&
    !Type.File.Namespace:contains('.')

## FDG: Namespace should have at least two segments
export function namespaceSegments(cb: Codebase) : [Violation] => cb.Types:hasShortNamespace
        :toInfo(
            'Namespace {item.File.Namespace} needs two segments, e.g. Company.Product',
            nameof(namespace-segments))

export let namespace-segments = namespaceSegments(cb)

## Combined FDG naming checks
export function fdgNaming(cb: Codebase) : [Violation] =>
    exceptionSuffix(cb) +
    attributeSuffix(cb) +
    eventargsSuffix(cb) +
    streamSuffix(cb) +
    noHungarianPrefix(cb) +
    boolPropertyNaming(cb) +
    namespaceSegments(cb)

export let fdg-naming = fdgNaming(cb)

## Framework Design Guidelines — Type Design

# Enum types should not have 'Enum' or 'Flags' suffix
predicate hasEnumBadSuffix(Type) => Type.Kind == 'Enum'
    && (Type.Name:endsWith('Enum') || Type.Name:endsWith('Flags'))

## FDG: Enum types should not use Enum/Flags suffix
export function enumNoSuffix(cb: Codebase) : [Violation] => cb.Types:hasEnumBadSuffix
        :toWarning(
            'FDG Type Design: Enum {item.Name} should not use Enum/Flags suffix',
            nameof(enum-no-suffix))

export let enum-no-suffix = enumNoSuffix(cb)

# [Flags] enums should use plural names
predicate isFlagsEnum(Type) =>
    Type.Kind == Enum &&
    hasDecorator(Type, 'Flags')
predicate hasFlagsSingularName(Type) =>
    Type:isFlagsEnum &&
    !Type.Name:matches('[sx]$|ies$|ata$')

## FDG: [Flags] enums should use plural names
export function flagsPluralName(cb: Codebase) : [Violation] => cb.Types:hasFlagsSingularName
        :toWarning(
            'FDG Type Design: [Flags] enum {item.Name} should use a plural name',
            nameof(flags-plural-name))

export let flags-plural-name = flagsPluralName(cb)

# Abstract classes should have a protected constructor (not public)
predicate isPublicCtor(Method) => Method.Modifiers:isSet(Public)
predicate hasAbstractPublicCtor(Type) =>
    Type:isAbstract &&
    Type.Constructors:any(isPublicCtor)

## FDG: Abstract classes should have protected constructors
export function abstractProtectedCtor(cb: Codebase) : [Violation] => cb.Types:hasAbstractPublicCtor
        :toWarning(
            '{item.Name}: make abstract-class constructors protected',
            nameof(abstract-protected-ctor))

export let abstract-protected-ctor = abstractProtectedCtor(cb)

# Static classes should not have instance members
predicate isInstanceMethod(Method) =>
    Method:!isStatic &&
    Method.Kind:in(['method', 'operator', 'destructor']) &&
    Method.Name != '.ctor'
predicate isInstanceField(Field) =>
    Field:!isStatic &&
    Field:!isConst
predicate isInstanceProperty(Property) =>
    Property:!isStatic
predicate isInstanceEvent(Event) =>
    Event:!isStatic
predicate hasStaticWithInstanceMember(Type) =>
    Type:isStatic &&
    (Type.Methods:any(isInstanceMethod) ||
        Type.Fields:any(isInstanceField) ||
        Type.Properties:any(isInstanceProperty) ||
        Type.Events:any(isInstanceEvent))

## FDG: Static classes should not have instance members
export function staticNoInstance(cb: Codebase) : [Violation] => cb.Types:hasStaticWithInstanceMember
        :toWarning(
            'FDG Type Design: Static class {item.Name} should not have instance members',
            nameof(static-no-instance))

export let static-no-instance = staticNoInstance(cb)

# Marker interfaces (no members) should be avoided
predicate isMarkerInterface(Type) => Type.Kind == 'Interface'
    && Type.Methods.Count == 0 && Type.Properties.Count == 0 && Type.Events.Count == 0

## FDG: Marker interfaces should be avoided
export function noMarkerInterfaces(cb: Codebase) : [Violation] => cb.Types:isMarkerInterface
        :toInfo(
            '{item.Name} has no members; consider an attribute instead',
            nameof(no-marker-interfaces))

export let no-marker-interfaces = noMarkerInterfaces(cb)

# Classes with only static members should be marked static
predicate hasAllMethodsStatic(CSharpType) => CSharpType.Kind == 'Class'
    && !CSharpType.IsRecord
    && CSharpType:!isStatic && CSharpType:!isAbstract
    && CSharpType.Methods.Count > 0
    && CSharpType.Methods:none(isInstanceMethod)
    && CSharpType.Fields:none(isInstanceField)
    && CSharpType.Constructors.Count == 0
    && CSharpType.Properties.Count == 0
    && CSharpType.Events.Count == 0

predicate requiresInstance(Type) =>
    Type.Methods:any(isInstanceMethod) ||
    Type.Fields:any(isInstanceField) ||
    Type.Constructors.Count > 0 ||
    Type.Properties.Count > 0 ||
    Type.Events.Count > 0 ||
    Type.BaseTypes.Count > 0 ||
    Type.Interfaces.Count > 0

function staticClassCandidates(types: [Type], instanceTypes: [string]) : [Type] =>
    types:asCSharp:hasAllMethodsStatic
        .Where(!instanceTypes:contains(declarationIdentity(item)))

## FDG: Classes with only static members should be static
## An instance member or base type in another partial declaration also prevents this suggestion.
export function shouldBeStatic(cb: Codebase) : [Violation] => staticClassCandidates(
        cb.Types,
        cb.Types:requiresInstance.Select(declarationIdentity(item)))
        :toInfo(
            '{item.Name} has only static members; consider a static class',
            nameof(should-be-static))

export let should-be-static = shouldBeStatic(cb)

# Structs should be small (4 or fewer fields)
predicate isLargeStruct(Type) => Type.Kind == 'Struct' && Type.Fields.Count > 4

## FDG: Structs should be small
export function structSize(cb: Codebase) : [Violation] => cb.Types:isLargeStruct
        :toInfo(
            '{item.Name} has {item.Fields.Count} fields; consider a class',
            nameof(struct-size))

export let struct-size = structSize(cb)

## Combined FDG type design checks
export function fdgTypeDesign(cb: Codebase) : [Violation] =>
    enumNoSuffix(cb) +
    flagsPluralName(cb) +
    abstractProtectedCtor(cb) +
    staticNoInstance(cb) +
    noMarkerInterfaces(cb) +
    shouldBeStatic(cb) +
    structSize(cb)

export let fdg-type-design = fdgTypeDesign(cb)

## Framework Design Guidelines — Member Design

# Methods with more than 5 parameters
predicate hasExcessiveParams(Method) =>
    Method:isPublic &&
    hasParameterCountAbove(Method, 5)
predicate hasTooManyParams(Type) => Type.Methods:any(hasExcessiveParams)

## FDG: Methods should not have more than 5 parameters
export function maxParameters(cb: Codebase) : [Violation] => cb.Types:hasTooManyParams
        :toWarning(
            '{item.Name}: public methods should have at most 5 parameters',
            nameof(max-parameters))

export let max-parameters = maxParameters(cb)

# Write-only properties (setter without getter)
predicate isWriteOnlyProp(Property) =>
    Property:isPublic &&
    Property:hasSetter &&
    !Property:hasGetter
predicate hasWriteOnlyProp(Type) => Type.Properties:any(isWriteOnlyProp)

## FDG: No write-only properties
export function noWriteOnlyProperties(cb: Codebase) : [Violation] => cb.Types:hasWriteOnlyProp
        :toWarning(
            'FDG Member Design: {item.Name} has a write-only property — add a getter',
            nameof(no-write-only-properties))

export let no-write-only-properties = noWriteOnlyProperties(cb)

# Extension methods should be in *Extensions classes
predicate isExtensionMethod(Method) => Method:isStatic && Method.Parameters.Count > 0
    && Method.Decorators:contains('Extension')
predicate hasExtensionMethods(Type) =>
    Type:isStatic &&
    Type.Methods:any(isExtensionMethod)
predicate isExtensionClassBadName(Type) =>
    Type:hasExtensionMethods &&
    !Type.Name:endsWith('Extensions')

## FDG: Extension methods should be in *Extensions classes
export function extensionClassNaming(cb: Codebase) : [Violation] => cb.Types:isExtensionClassBadName
        :toWarning(
            '{item.Name}: extension-method containers need an Extensions suffix',
            nameof(extension-class-naming))

export let extension-class-naming = extensionClassNaming(cb)

# Constructors with too many parameters (prefer options/builder)
predicate hasCtorTooManyParams(Method) =>
    hasParameterCountAbove(Method, 5)
predicate hasComplexCtor(Type) => Type.Constructors:any(hasCtorTooManyParams)

## FDG: Constructors should not have too many parameters
export function ctorParameterCount(cb: Codebase) : [Violation] => cb.Types:hasComplexCtor
        :toInfo(
            '{item.Name}: group constructor parameters in an options type',
            nameof(ctor-parameter-count))

export let ctor-parameter-count = ctorParameterCount(cb)

# Boolean inputs are allowed; their names should describe a state, choice, or data value.
let bool-parameter-prefixes =
    '^(is|has|can|should|was|will|are|supports|allows|needs|contains|includes|' +
    'requires|enables|include|exclude|allow|enable|disable|ignore|skip|prefer|' +
    'use|keep|remove|create|overwrite|append|in)[A-Z].*$'
let descriptive-bool-parameter-names =
    '^(value|recursive|enabled|disabled|visible|active|valid|available|ready|' +
    'empty|open|closed|connected|locked|required|optional|nullable|changed|' +
    'found|success|completed|strict|quiet|overwrite|append)$'

predicate isBoolParam(Parameter) =>
    Parameter.Type.Name == 'bool' ||
    (Parameter.Type.Name == 'Boolean' && Parameter.Type.Namespace == 'System')
predicate hasUnclearBoolName(Parameter) =>
    isBoolParam &&
    !Parameter.Name:matches(bool-parameter-prefixes) &&
    !Parameter.Name:matches(descriptive-bool-parameter-names)
predicate hasUnclearBoolParameter(Method) =>
    Method:isPublic &&
    Method.Parameters:any(hasUnclearBoolName)

## Boolean parameters are allowed when named affirmatively or descriptively, including `value`.
## Vague names such as `flag`, `b`, and `arg` do not communicate their meaning.
export function boolParameterNaming(cb: Codebase) : [Violation] => cb.Methods:hasUnclearBoolParameter
        :toInfo(
            '{item.Name}: name bool parameters affirmatively or descriptively',
            nameof(bool-parameter-naming))

export let bool-parameter-naming = boolParameterNaming(cb)

## Compatibility name for boolParameterNaming; bool inputs are no longer prohibited.
export function avoidBoolParams(cb: Codebase) : [Violation] =>
    boolParameterNaming(cb)

export let avoid-bool-params = bool-parameter-naming

# Properties that return arrays (prefer ReadOnlyCollection or IReadOnlyList)
predicate isArrayProperty(Property) =>
    Property:isPublic &&
    Property.Type.Name:matches('\\[\\]$')
predicate hasArrayProperty(Type) => Type.Properties:any(isArrayProperty)

## FDG: Properties should not return arrays
export function noArrayProperties(cb: Codebase) : [Violation] => cb.Types:hasArrayProperty
        :toInfo(
            '{item.Name}: prefer IReadOnlyList<T> to public array properties',
            nameof(no-array-properties))

export let no-array-properties = noArrayProperties(cb)

## Combined FDG member design checks
export function fdgMemberDesign(cb: Codebase) : [Violation] =>
    maxParameters(cb) +
    noWriteOnlyProperties(cb) +
    extensionClassNaming(cb) +
    ctorParameterCount(cb) +
    boolParameterNaming(cb) +
    noArrayProperties(cb)

export let fdg-member-design = fdgMemberDesign(cb)

## Framework Design Guidelines — Exception Design

# Custom exceptions must end in 'Exception' (extended base list)
let extended-exception-base-names = exception-base-names + [
    'FormatException', 'NotSupportedException', 'UnauthorizedAccessException'
]

predicate isExceptionType(Type) =>
    Type.Kind == Class &&
    derivesFromAny(Type, extended-exception-base-names)
predicate hasExceptionBadName(Type) =>
    Type:isExceptionType &&
    !Type.Name:endsWith('Exception')

## FDG: Custom exceptions must end in 'Exception'
export function exceptionNaming(cb: Codebase) : [Violation] => cb.Types:hasExceptionBadName
        :toError(
            '{item.Name}: exception types need an Exception suffix',
            nameof(exception-naming))

export let exception-naming = exceptionNaming(cb)

# Custom exceptions should have standard constructors
predicate isParameterlessCtor(Method) => Method.Parameters.Count == 0
predicate isMessageCtor(Method) => Method.Parameters.Count == 1
predicate isMessageAndInnerCtor(Method) => Method.Parameters.Count == 2
predicate isMissingStandardCtors(Type) => Type:isExceptionType
    && (!Type.Constructors:any(isParameterlessCtor)
        || !Type.Constructors:any(isMessageCtor)
        || !Type.Constructors:any(isMessageAndInnerCtor))

## FDG: Custom exceptions should have standard constructors
export function exceptionStandardCtors(cb: Codebase) : [Violation] => cb.Types:isMissingStandardCtors
        :toWarning(
            '{item.Name}: add (), (string), and (string, Exception) constructors',
            nameof(exception-standard-ctors))

export let exception-standard-ctors = exceptionStandardCtors(cb)

# Do not throw banned exception types
predicate isThrowingBannedException(Statement) => Statement.Kind == 'throw'
    && (Statement.TypeName == 'Exception'
        || Statement.TypeName == 'SystemException'
        || Statement.TypeName == 'NullReferenceException'
        || Statement.TypeName == 'IndexOutOfRangeException'
        || Statement.TypeName == 'StackOverflowException'
        || Statement.TypeName == 'OutOfMemoryException'
        || Statement.TypeName == 'AccessViolationException')

## FDG: Do not throw banned exception types
export function noBannedThrows(cb: Codebase) : [Violation] => cb.Statements:isThrowingBannedException:notIgnored
        :toError(
            'Throw a more specific exception than {item.TypeName}',
            nameof(no-banned-throws))

export let no-banned-throws = noBannedThrows(cb)

# Methods with Try* prefix should return bool
predicate isBadTryMethod(Method) => Method:isPublic && Method.Name:startsWith('Try')
    && Method.ReturnType.Name != nic && Method.ReturnType.Name != 'bool'
predicate hasBadTryMethod(Type) => Type.Methods:any(isBadTryMethod)

## FDG: Try* methods should return bool
export function tryPatternReturnsBool(cb: Codebase) : [Violation] => cb.Types:hasBadTryMethod
        :toWarning(
            'FDG Exceptions: {item.Name} has a Try* method that does not return bool',
            nameof(try-pattern-returns-bool))

export let try-pattern-returns-bool = tryPatternReturnsBool(cb)

# Preserve caller cancellation; internal deadlines may be handled or mapped separately.
predicate isCatchingCancellation(CSharpStatement) =>
    CSharpStatement.IsCancellationHandler && !CSharpStatement.IsCallerCancellationPreserved

## FDG: Preserve caller cancellation through supported bound cancellation paths.
export function noSwallowCancellation(cb: Codebase) : [Violation] => cb.Statements:asCSharp:isCatchingCancellation:notIgnored
        :toError(
            'FDG Exceptions: Preserve caller cancellation; handle internal deadlines separately',
            nameof(no-swallow-cancellation))

export let no-swallow-cancellation = noSwallowCancellation(cb)

## Combined FDG exception design checks
export function fdgExceptions(cb: Codebase) : [Violation] =>
    exceptionNaming(cb) +
    exceptionStandardCtors(cb) +
    noBannedThrows(cb) +
    tryPatternReturnsBool(cb) +
    noSwallowCancellation(cb)

export let fdg-exceptions = fdgExceptions(cb)

## Combined FDG checks
export function fdgChecks(cb: Codebase) : [Violation] =>
    fdgNaming(cb) +
    fdgTypeDesign(cb) +
    fdgMemberDesign(cb) +
    fdgExceptions(cb)

export let fdg-checks = fdgChecks(cb)

## All C# checks combined
export function csharpChecks(cb: Codebase) : [Violation] =>
    csharpCorrectnessChecks(cb) +
    csharpStyleChecks(cb) +
    fdgChecks(cb)

export let csharp-checks = csharpChecks(cb)

command MAIN = CHECK(csharp-checks)
