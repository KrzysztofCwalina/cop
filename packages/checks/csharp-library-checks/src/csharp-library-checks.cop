# C# library and client library design checks

import csharp
import csharp-checks
import code

let cb = codebase(csharp.parse())

## Library API Design

# Public API surface

predicate hasAsyncBoolParam(Parameter) => Parameter.Name == 'async' && Parameter.Type == 'bool'
predicate isPublicWithAsyncBool(Method) => Method:isPublic && Method.Parameters:any(hasAsyncBoolParam)
predicate isExposingAsyncBool(Type) => Type.Methods:any(isPublicWithAsyncBool)

predicate isNonPublicAsync(Method) => Method:!isPublic && Method:isAsync
predicate isMissingAsyncParam(Method) => Method.Parameters:!any(hasAsyncBoolParam)
predicate hasNonPublicAsyncWithoutParam(Type) => Type.Methods.Where(isNonPublicAsync):any(isMissingAsyncParam)

export predicate hasBannedInternalType(Parameter) => Parameter.Type.Namespace == 'System.Runtime.CompilerServices'
    || Parameter.Type.Namespace == 'System.Runtime.InteropServices'
export predicate hasBannedParamType(Method) => Method:isPublic && Method.Parameters:any(hasBannedInternalType)
export predicate hasBannedParams(Type) => Type.Methods:any(hasBannedParamType)

## Public methods should not have a bool parameter named 'async'
export let public-async-bool-params = cb.Types:isExposingAsyncBool
    :toWarning('{item.Name} should not have a bool \'async\' parameter in public API')

## Non-public async methods should accept a bool 'async' parameter
export let async-missing-bool-param = cb.Types:hasNonPublicAsyncWithoutParam
    :toWarning('{item.Name} non-public async method should have \'async\' parameter')

# ConfigureAwait

predicate isAwaitUsingDefault(Statement) => Statement.Kind == 'await'
    && (Statement.MemberName != 'ConfigureAwait' || Statement.Arguments:contains('true'))

## Library code must use ConfigureAwait(false) on all await expressions
export let awaits-using-default = cb.Statements:isAwaitUsingDefault
    :toWarning('Library code must use ConfigureAwait(false) on await expressions')

# Dual-mode method patterns

# Method uses the dual-mode async bool parameter pattern
export predicate hasSyncAndAsyncVariants(Method) => Method.Parameters:any(hasAsyncBoolParam)

# Statement is in a dual-mode method (has async bool parameter)
export predicate isInDualModeMethod(Statement) => Statement.Method != nic
    && Statement.Method:hasSyncAndAsyncVariants

# Statement has an ancestor if-statement whose condition references 'async'
predicate isAsyncGuard(Statement) => Statement.Kind == 'if' && Statement.Condition:contains('async')
export predicate isGuardedByAsyncCheck(Statement) => Statement.Ancestors:any(isAsyncGuard)

# Unconditional await in dual-mode method (AZC0110)
predicate isUnconditionalAwait(Statement) => Statement.Kind == 'await'
    && isInDualModeMethod && !isGuardedByAsyncCheck

## Unconditional await in dual-mode method (AZC0110)
export let unconditional-await-in-dual-mode = cb.Statements:isUnconditionalAwait
    :toError('Await must be guarded by if (async) in dual-mode methods')

# Unconditional EnsureCompleted in dual-mode method (AZC0111)
predicate isUnconditionalEnsureCompleted(Statement) => Statement.Kind == 'call'
    && Statement.MemberName == 'EnsureCompleted' && isInDualModeMethod && !isGuardedByAsyncCheck

## Unconditional EnsureCompleted in dual-mode method (AZC0111)
export let unconditional-sync-in-dual-mode = cb.Statements:isUnconditionalEnsureCompleted
    :toError('EnsureCompleted must be guarded by if (!async) in dual-mode methods')

# AZC0108: Detect wrong async argument values in guarded branches

predicate isPositiveAsyncGuard(Statement) => Statement.Kind == 'if' && Statement.Condition == 'async'
predicate isInPositiveAsyncGuard(Statement) => Statement.Ancestors:any(isPositiveAsyncGuard)
predicate isNegatedAsyncGuard(Statement) => Statement.Kind == 'if' && Statement.Condition:contains('!async')
predicate isElseBranch(Statement) => Statement.Kind == 'else'
predicate isInNegatedAsyncGuard(Statement) => Statement.Ancestors:any(isNegatedAsyncGuard)
    || Statement.Ancestors:any(isElseBranch)
export predicate hasWrongAsyncFalseInAsyncGuard(Statement) => Statement.Kind == 'call'
    && isInDualModeMethod && isInPositiveAsyncGuard
    && Statement.Arguments:any((a) => a:contains('async: false'))
export predicate hasWrongAsyncTrueInSyncGuard(Statement) => Statement.Kind == 'call'
    && isInDualModeMethod && isInNegatedAsyncGuard
    && Statement.Arguments:any((a) => a:contains('async: true'))

## Wrong async argument value in guarded branch (AZC0108)
export let wrong-async-arg-value = cb.Statements:hasWrongAsyncFalseInAsyncGuard
    :toError('Passing async: false inside async guard — should be async: true')
export let wrong-sync-arg-value = cb.Statements:hasWrongAsyncTrueInSyncGuard
    :toError('Passing async: true inside sync guard — should be async: false')

# AZC0109: async parameter used outside of if condition or ternary

export predicate isPassingAsyncParamAsArg(Statement) => Statement.Kind == 'call'
    && isInDualModeMethod && !isGuardedByAsyncCheck
    && Statement.Arguments:contains('async')

## Misuse of async parameter (AZC0109)
export let async-param-misuse = cb.Statements:isPassingAsyncParamAsArg
    :toWarning('Do not pass async parameter as argument — use if/else branching instead')

## Combined async/sync library checks
export let csharp-library-async-checks = public-async-bool-params + async-missing-bool-param + awaits-using-default + unconditional-await-in-dual-mode + unconditional-sync-in-dual-mode + wrong-async-arg-value + wrong-sync-arg-value + async-param-misuse

## Client Library Design

# Client type identification

export predicate isClient(Type) => Type.Name:endsWith('Client')
export predicate isClientOptionsType(Type) => Type.Name:endsWith('ClientOptions')
export let Clients = cb.Types:isClient

export predicate isModel(Type) => Type.Kind == 'Class' && Type:isPublic && !isClient && !isClientOptionsType
export let Models = cb.Types:isModel
export let ClientOptions = cb.Types:isClientOptionsType

# Naming suffixes

export predicate hasCollectionSuffix(Type) => Type.Name:endsWith('Collection')
export predicate hasRequestSuffix(Type) => Type.Name:endsWith('Request')
export predicate hasParameterSuffix(Type) => Type.Name:endsWith('Parameter') || Type.Name:endsWith('Parameters')
export predicate hasOptionSuffix(Type) => Type.Name:endsWith('Option') || Type.Name:endsWith('Options')

# Constructor checks

predicate isOptionsParam(Parameter) => Parameter.Type:endsWith('Options')
predicate isConstructorWithOptions(Constructor) => Constructor.Parameters:any(isOptionsParam)

export predicate isProtectedParameterless(Constructor) => Constructor:isProtected && Constructor.Parameters.Count == 0

predicate isMissingOptionsConstructor(Type) => Type.Constructors:!any(isConstructorWithOptions)
predicate isNotSealedOrAbstract(Type) => Type:!isSealed && Type:!isAbstract

export predicate isMissingMockingConstructor(Type) => Type.Constructors:!any(isProtectedParameterless)

## Client types must have a constructor that accepts an Options parameter
export let client-needs-options-ctor = Clients:isMissingOptionsConstructor
    :toWarning('{item.Name} should accept an options parameter')

## Client types must be sealed or abstract to prevent unintended inheritance
export let client-sealed-or-abstract = Clients:isNotSealedOrAbstract
    :toWarning('{item.Name} should be sealed or abstract')

# Method checks

predicate isCancellationToken(Parameter) => Parameter.Type == 'CancellationToken'
predicate isPublicAsync(Method) => Method:isPublic && Method:isAsync
predicate isMissingCancellationToken(Method) => Method.Parameters:!any(isCancellationToken)
predicate hasAsyncWithoutCancellation(Type) => Type.Methods.Where(isPublicAsync):any(isMissingCancellationToken)

predicate isPublicInstance(Method) => Method:isPublic && Method:!isStatic
predicate isNotVirtual(Method) => Method:!isVirtual && Method:!isOverride && Method:!isAbstract
predicate hasNonVirtualServiceMethod(Type) => Type.Methods.Where(isPublicInstance):any(isNotVirtual)

predicate isAsyncServiceMethod(Method) => Method:isPublic && Method:isVirtual && Method.Name:endsWith('Async')
predicate isMissingSyncCounterpart(Method) => !Type.MethodNames:contains(Method.Name.Trim('Async'))
predicate hasAsyncWithoutSync(Type) => Type.Methods.Where(isAsyncServiceMethod):any(isMissingSyncCounterpart)

## Async methods on client types must accept a CancellationToken parameter
export let async-needs-cancellation-token = Clients:hasAsyncWithoutCancellation
    :toWarning('{item.Name} is async without CancellationToken')

## Public instance methods on client types should be virtual for mocking
export let client-methods-virtual = Clients:hasNonVirtualServiceMethod
    :toWarning('{item.Name} has non-virtual service method')

## Every public async method on a client type must have a matching sync method
export let async-needs-sync-counterpart = Clients:hasAsyncWithoutSync
    :toWarning('{item.Name} has async method without sync counterpart')

# Content parameters

predicate isRequestContent(Parameter) => Parameter.Type == 'RequestContent' || Parameter.Type == 'RequestBody'
predicate hasRequestContent(Method) => Method.Parameters:any(isRequestContent)

## All client library checks combined
export let csharp-library-checks = csharp-library-async-checks + client-needs-options-ctor + client-sealed-or-abstract + async-needs-cancellation-token + client-methods-virtual + async-needs-sync-counterpart

## Public API Surface Predicates

# A public API entry (type, method, property, event, etc.)
export predicate isPublicApi(Api) => Api.Kind != ''

# Filter by API kind
export predicate isApiType(Api) => Api.Kind:in(['class' 'interface' 'struct' 'enum'])
export predicate isApiMethod(Api) => Api.Kind == 'method'
export predicate isApiProperty(Api) => Api.Kind == 'property'
export predicate isApiEvent(Api) => Api.Kind == 'event'
export predicate isApiCtor(Api) => Api.Kind == 'ctor'
export predicate isApiEnumValue(Api) => Api.Kind == 'enumvalue'

# API line representation for listings and diff
export type ApiLine = {
    Text : string,
    Kind : string,
    TypeName : string,
    MemberName : string,
    File : string,
    Line : int
}

export function toApiLine(Api) => ApiLine {
    Text = item.ApiAsText,
    Kind = item.Kind,
    TypeName = item.TypeName,
    MemberName = item.MemberName,
    File = item.File.Path,
    Line = item.Line
}

command MAIN = CHECK(csharp-library-checks)
