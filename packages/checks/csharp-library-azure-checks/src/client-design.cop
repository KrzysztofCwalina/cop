# Client design — authentication, structure, and mocking

import csharp-library-checks
import code

predicate isTokenCredential(Parameter) => Parameter.Type == 'TokenCredential'
predicate hasTokenCredentialParam(Constructor) => Constructor.Parameters:any(isTokenCredential)
predicate isMissingTokenCredential(Type) => Type.Constructors:!any(hasTokenCredentialParam)

## Azure clients must accept TokenCredential for authentication
export let client-needs-token-credential = Clients:isMissingTokenCredential
    :toWarning('{item.Name} must accept TokenCredential')

## Client types must provide a protected parameterless constructor for mocking
export let client-needs-mocking-ctor = Clients:isMissingMockingConstructor
    :toWarning('{item.Name} must provide a protected parameterless constructor')

predicate isOptionsParameter(Parameter) => Parameter.Type:endsWith('Options')
predicate hasCtorWithOptions(Type) => Type.Constructors:any(isCtorWithOptions)
predicate isCtorWithOptions(Constructor) => Constructor:isPublic && Constructor.Parameters:any(isOptionsParameter)
predicate hasCtorWithoutOptions(Type) => Type.Constructors:any(isCtorLackingOptions)
predicate isCtorLackingOptions(Constructor) => Constructor:isPublic && Constructor.Parameters:!any(isOptionsParameter)
    && Constructor.Parameters.Count > 0
predicate isMissingCtrWithOptions(Type) => !hasCtorWithOptions
predicate isMissingCtorWithoutOptions(Type) => hasCtorWithOptions && !hasCtorWithoutOptions

## Client types should have a constructor that accepts ClientOptions
export let client-needs-options-ctor = Clients:isMissingCtrWithOptions
    :toWarning('{item.Name} should have a constructor that accepts options')

## Client types should have a constructor without ClientOptions for simple scenarios
export let client-needs-simple-ctor = Clients:isMissingCtorWithoutOptions
    :toWarning('{item.Name} should have a constructor without options for simple usage')

predicate isRequestContent(Parameter) => Parameter.Type == 'RequestContent' || Parameter.Type == 'RequestBody'
predicate hasRequestContent(Method) => Method.Parameters:any(isRequestContent)
predicate isConvenience(Method) => Method:isPublic && Method:isVirtual
predicate hasConvenienceWithRequestContent(Type) => Type.Methods.Where(isConvenience):any(hasRequestContent)

## Convenience methods should not take RequestContent or RequestBody parameters
export let no-request-content-in-convenience = Clients:hasConvenienceWithRequestContent
    :toWarning('{item.Name} convenience method should not have RequestContent parameter')

# AZC0021: ClientSettings constructor should not combine settings param with other params
predicate isClientSettingsParam(Parameter) => Parameter.Type:endsWith('Settings')
predicate hasSettingsAndOtherParams(Constructor) => Constructor:isPublic
    && Constructor.Parameters:any(isClientSettingsParam)
    && Constructor.Parameters.Count > 1
predicate hasSettingsCtorOverloaded(Type) => Type.Constructors:any(hasSettingsAndOtherParams)

## ClientSettings constructor should not combine settings param with other params (AZC0021)
export let settings-ctor-isolation = Clients:hasSettingsCtorOverloaded
    :toWarning('{item.Name} constructor should not combine ClientSettings with other parameters')

let client-design = client-needs-token-credential + client-needs-mocking-ctor + client-needs-options-ctor + client-needs-simple-ctor + no-request-content-in-convenience + settings-ctor-isolation
