# Code Metrics Package v1.0
# Computes aggregate code quality metrics from violations and outputs as JSON.
# Import with: import code-metrics
# Run standalone: cop code-metrics -t <dir> -p csharp -p python

import code
import code

let cb = codebase(Program.Providers)

## Computes aggregate metrics from violations and lines, outputs as JSON.
## Usage: METRICS(violations, lines) where violations is [Violation] and lines is [Line].
## Output is a JSON object with total counts, severity breakdown, LOC, and per-KLOC rates.
## weightedScore = sum of all violation severities. weightedSlopPerKloc = weightedScore * 1000 / LOC.
export command METRICS(violations, lines) = {
    let total = violations.Count
    let errors = violations:count((v) => v.Severity >= 0.7)
    let warnings = violations:count((v) => v.Severity >= 0.4 && v.Severity < 0.7)
    let info = violations:count((v) => v.Severity < 0.4)
    let loc = lines:count((line) => line.Kind == 'code')
    let weightedScore = violations:sum((v) => v.Severity)
    let slopPerKloc = loc > 0 ? total * 1000 / loc : 0
    let weightedSlopPerKloc = loc > 0 ? weightedScore * 1000 / loc : 0
    print('{')
    print('  "totalViolations": {total},')
    print('  "errors": {errors},')
    print('  "warnings": {warnings},')
    print('  "info": {info},')
    print('  "weightedScore": {weightedScore},')
    print('  "linesOfCode": {loc},')
    print('  "slopPerKloc": {slopPerKloc},')
    print('  "weightedSlopPerKloc": {weightedSlopPerKloc}')
    print('}')
}

# Language-agnostic slop rules — universal code quality issues detected from any provider.
# These rules use ambient collections (Types, Statements, Lines) filled by -p providers.

predicate hasLongMethod(Type) => Type.Methods:any((m) => m.Statements.Count > 50)
predicate isUndocumentedPublic(Type) => Type.Documented == false && Type.Modifiers:isSet(Public)
predicate hasTooManyParams(Type) => Type.Methods:any((m) => m.Parameters.Count > 5)
predicate isEmptyCatch(Statement) => Statement.ErrorHandler == true && Statement.Generic == true

export let long-methods = cb.Types:hasLongMethod
    :toWarning('{item.Name} has a method with more than 50 statements')

export let undocumented-types = cb.Types:isUndocumentedPublic
    :toWarning('{item.Name} is a public type without documentation')

export let too-many-params = cb.Types:hasTooManyParams
    :toWarning('{item.Name} has a method with more than 5 parameters')

export let empty-catches = cb.Statements:isEmptyCatch
    :toError('Empty catch block swallows all exceptions')

## Curated language-agnostic slop rules with severity weights.
## Users can extend with language-specific rules via multi-package execution.
export let slop =
    long-methods:withSeverity(0.5) +
    undocumented-types:withSeverity(0.5) +
    too-many-params:withSeverity(0.5) +
    empty-catches:withSeverity(0.8)

## Default command: compute slop metrics using Lines from loaded providers.
## Run with: cop code-metrics -t <dir> -p csharp -p python
command main = METRICS(slop, cb.Lines)
