# Flags risky SQL statements: mass UPDATE/DELETE statements with no top-level WHERE,
# and SELECT statements whose select-list is exactly '*'.
#
# Run: cop packages\sql\samples\risky-dml-and-select-star.cop -t packages\sql\samples\fixtures

import sql
import code-analysis

predicate isUnscopedMutation(SqlStatement) =>
    (SqlStatement.Kind:equals('UPDATE') || SqlStatement.Kind:equals('DELETE'))
    && !SqlStatement.HasWhere

predicate isSelectStar(SqlStatement) => SqlStatement.SelectsStar

let unscoped-mutations = sql.parse().Statements:isUnscopedMutation
    :toError('SQL {item.Kind} statement has no WHERE clause')

let select-stars = sql.parse().Statements:isSelectStar
    :toWarning('SQL SELECT statement uses SELECT *')

command MAIN = CHECK(unscoped-mutations + select-stars)
