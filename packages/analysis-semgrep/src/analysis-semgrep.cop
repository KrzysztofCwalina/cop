# Semgrep integration — runs Semgrep and produces cop diagnostics
# Prerequisites: Semgrep must be installed

import code-analysis

let data = provider('analysis-semgrep', nic)

## Returns the Semgrep diagnostics collection
export function diagnostics() : [Diagnostic] => data.Diagnostics
export let semgrep-checks = data.Diagnostics

command MAIN = foreach semgrep-checks => '{item.FilePath}({item.Line}): {item.Severity}: {item.RuleId}: {item.Message}'
