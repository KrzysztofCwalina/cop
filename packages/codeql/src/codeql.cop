# CodeQL Data Provider v1.0
# Reads CodeQL analysis results (SARIF format) and exposes them as cop collections.
# Import with: import codeql
#
# Prerequisites:
#   - CodeQL CLI installed (https://github.com/github/codeql-cli-binaries)
#   - A CodeQL database created for your project
#   - SARIF results generated via: codeql database analyze <db> --format=sarif-latest --output=results.sarif
#
# The provider reads SARIF files from the target directory or a configured path.

## A CodeQL analysis result (alert/finding)
export type Result
  RuleId : string
  Message : string
  Severity : string
  FilePath : string
  StartLine : int
  EndLine : int
  StartColumn : int
  EndColumn : int

## A CodeQL rule definition
export type Rule
  Id : string
  Name : string
  Description : string
  Severity : string
  Tags : string
  Precision : string

## A CodeQL SARIF run (one per tool/suite)
export type Run
  Tool : string
  Version : string
  ResultCount : int

## Loads CodeQL SARIF results from a file path.
## Returns a collection of Result items.
## Example: codeql.Load('results.sarif')
export function Load(path : string) : collection => provider('codeql', path)

## Predicates for filtering results by severity
export predicate isError(Result) = Result.Severity:eq('error')
export predicate isWarning(Result) = Result.Severity:eq('warning')
export predicate isNote(Result) = Result.Severity:eq('note')
export predicate isRecommendation(Result) = Result.Severity:eq('recommendation')
