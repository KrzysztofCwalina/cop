import code
import python-library-checks

let cb : Codebase = provider('python')

# print API surface
export command api-listing = foreach cb.Api:isPublicApi => '{item.Signature}'

# save API surface to a file
let apiText = cb.Api:isPublicApi.text('{item.Signature}')
export command save-api = save('api-surface.txt', apiText)
