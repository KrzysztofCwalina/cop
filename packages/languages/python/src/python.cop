# Python source language provider
import code

## Parses Python source files in the target directory and returns a Codebase.
## Example: let cb = python.parse()
export function parse() : Codebase => provider('python')

## Parses Python source files in the specified directory and returns a Codebase.
## Example: let cb = python.parse('/path/to/project')
export function parse(path : string) : Codebase => provider('python', path)

## A Python-specific view of a Type, exposing Python-only facts
## that the language-agnostic model flattens. Obtain one by narrowing with `asPython`.
export type PythonType = Type & {
    IsDataclass : bool,
    IsEnum : bool,
    IsAbstract : bool,
    IsNamedTuple : bool,
    IsProtocol : bool,
    IsException : bool,
    HasSlots : bool,
    Methods : [PythonMethod]
}

## A Python-specific view of a Method, exposing Python-only facts.
## Reached via a narrowed type's `.Methods` or by narrowing with `asPython`.
export type PythonMethod = Method & {
    IsStaticmethod : bool,
    IsClassmethod : bool,
    IsProperty : bool,
    IsGenerator : bool,
    IsAbstractMethod : bool,
    IsDunder : bool
}

## A Python-specific view of a Statement, exposing Python statement kinds.
## Reached by narrowing with `asPython`.
export type PythonStatement = Statement & {
    IsWith : bool,
    IsAsyncWith : bool,
    IsRaise : bool,
    IsAssert : bool,
    IsComprehension : bool,
    IsGlobal : bool,
    IsNonlocal : bool
}

## Narrows a Type to a PythonType (Python types only), exposing Python-specific fields.
## Example: codebase.Types:asPython:isDataclass
export predicate asPython(Type) : PythonType => Type.File.Language == python

## Narrows a Method to a PythonMethod (Python methods only), exposing Python-specific fields.
## Example: codebase.Methods:asPython:isGeneratorMethod
export predicate asPython(Method) : PythonMethod => Method.File.Language == python

## Narrows a Statement to a PythonStatement (Python statements only), exposing Python-specific fields.
## Example: codebase.Statements:asPython:isRaise
export predicate asPython(Statement) : PythonStatement => Statement.File.Language == python

## True for classes decorated with `@dataclass`.
export predicate isDataclass(PythonType) => PythonType.IsDataclass

## True for classes deriving from `Enum` (IntEnum, StrEnum, Flag, ...).
export predicate isEnum(PythonType) => PythonType.IsEnum

## True for classes deriving from ABC/ABCMeta.
export predicate isAbstractClass(PythonType) => PythonType.IsAbstract

## True for classes deriving from NamedTuple.
export predicate isNamedTuple(PythonType) => PythonType.IsNamedTuple

## True for classes deriving from Protocol.
export predicate isProtocol(PythonType) => PythonType.IsProtocol

## True for classes deriving from Exception, Error, or BaseException.
export predicate isException(PythonType) => PythonType.IsException

## True for classes declaring __slots__.
export predicate hasSlots(PythonType) => PythonType.HasSlots

## True for methods decorated with @staticmethod.
export predicate isStaticmethod(PythonMethod) => PythonMethod.IsStaticmethod

## True for methods decorated with @classmethod.
export predicate isClassmethod(PythonMethod) => PythonMethod.IsClassmethod

## True for methods decorated with @property.
export predicate isProperty(PythonMethod) => PythonMethod.IsProperty

## True for async Python methods.
export predicate isAsyncMethod(PythonMethod) => PythonMethod.IsAsync

## True when a method body contains yield.
export predicate isGeneratorMethod(PythonMethod) => PythonMethod.IsGenerator

## True for methods decorated with @abstractmethod.
export predicate isAbstractMethod(PythonMethod) => PythonMethod.IsAbstractMethod

## True for Python dunder methods such as __str__.
export predicate isDunderMethod(PythonMethod) => PythonMethod.IsDunder

## True for a Python with statement.
export predicate isWith(PythonStatement) => PythonStatement.IsWith

## True for a Python async with statement.
export predicate isAsyncWith(PythonStatement) => PythonStatement.IsAsyncWith

## True for a Python raise statement.
export predicate isRaise(PythonStatement) => PythonStatement.IsRaise

## True for a Python assert statement.
export predicate isAssertStmt(PythonStatement) => PythonStatement.IsAssert

## True for a Python comprehension expression statement.
export predicate isComprehension(PythonStatement) => PythonStatement.IsComprehension

## True for a Python global statement.
export predicate isGlobalStmt(PythonStatement) => PythonStatement.IsGlobal

## True for a Python nonlocal statement.
export predicate isNonlocalStmt(PythonStatement) => PythonStatement.IsNonlocal
