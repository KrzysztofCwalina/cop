# Java source language provider
import code

## Parses Java with the installed JDK compiler-tree API, or warns and uses simpler syntax analysis.
## Native semantic fields demand javac attribution over locally available source and dependencies.
## No target code or annotation processor runs; missing semantic context is diagnosed.
## Example: let cb = java.parse()
export function parse() : Codebase => provider('java')

## Parses Java source files in the specified directory and returns a Codebase.
## Example: let cb = java.parse('/path/to/project')
export function parse(path : string) : Codebase => provider('java', path)

## True for Java interface declarations (including annotation interfaces).
export predicate isInterface(Type:isJava) => Type.Kind == Interface

## Matches syntactic System.getenv / java.lang.System.getenv calls, including enumeration.
## System properties are not environment variables. Static imports and aliases are not inferred.
export predicate isEnvironmentVariableAccess(Statement:isJava) =>
    Statement.Kind == call &&
    (Statement.TypeName == 'System' || Statement.TypeName == 'java.lang.System') &&
    Statement.MemberName == 'getenv'

## True for a named Java environment-variable read; zero-argument getenv enumerates variables.
export predicate isEnvironmentVariableRead(Statement:isJava) =>
    isEnvironmentVariableAccess(Statement) &&
    Statement.ArgumentExpressions.Count == 1

## A Java-specific view of a Type, exposing Java-only facts that are
## flattened in the language-agnostic model. Obtain one by narrowing with `asJava`.
export type JavaType = Type & {
    IsRecord : bool,
    IsEnum : bool,
    IsSealed : bool,
    IsNonSealed : bool,
    IsFinal : bool,
    IsGeneric : bool,
    Methods : [JavaMethod]
}

## A Java-specific view of a Method, exposing Java-only facts absent from the common model.
## Obtain one by narrowing with `asJava` or through a narrowed JavaType's `.Methods`.
export type JavaMethod = Method & {
    IsSynchronized : bool,
    IsNative : bool,
    IsDefault : bool,
    IsStrictfp : bool,
    IsGeneric : bool
}

## A Java-specific view of a Statement, exposing Java-only statement facts.
## Obtain one by narrowing with `asJava`.
export type JavaStatement = Statement & {
    IsSynchronized : bool,
    IsTryWithResources : bool,
    IsEnhancedFor : bool,
    IsThrow : bool,
    IsAssert : bool,
    IsOriginalExceptionAlwaysRethrown : bool,
    IsUsingResource : bool,
    IsOwnershipTransferred : bool,
    IsCancellationHandler : bool,
    IsCallerCancellationPreserved : bool
}

## Narrows a Type to a JavaType (Java types only), exposing Java-specific fields.
## Example: codebase.Types:asJava:isRecord
export predicate asJava(Type) : JavaType => Type.File.Language == java

## Narrows a Method to a JavaMethod (Java methods only), exposing Java-specific fields.
## Example: codebase.Methods:asJava:isSynchronizedMethod
export predicate asJava(Method) : JavaMethod => Method.File.Language == java

## Narrows a Statement to a JavaStatement (Java statements only), exposing Java-specific fields.
## Example: codebase.Statements:asJava:isEnhancedFor
export predicate asJava(Statement) : JavaStatement => Statement.File.Language == java

## True for Java `record` declarations.
export predicate isRecord(JavaType) => JavaType.IsRecord

## True for Java `enum` declarations.
export predicate isEnum(JavaType) => JavaType.IsEnum

## True for Java `sealed` type declarations.
export predicate isSealedClass(JavaType) => JavaType.IsSealed

## True for Java `non-sealed` type declarations.
export predicate isNonSealed(JavaType) => JavaType.IsNonSealed

## True for Java `final` type declarations.
export predicate isFinal(JavaType) => JavaType.IsFinal

## True for Java generic type declarations.
export predicate isGenericType(JavaType) => JavaType.IsGeneric

## True for Java `synchronized` method declarations.
export predicate isSynchronizedMethod(JavaMethod) => JavaMethod.IsSynchronized

## True for Java `native` method declarations.
export predicate isNativeMethod(JavaMethod) => JavaMethod.IsNative

## True for Java interface `default` method declarations.
export predicate isDefaultMethod(JavaMethod) => JavaMethod.IsDefault

## True for Java `strictfp` method declarations.
export predicate isStrictfp(JavaMethod) => JavaMethod.IsStrictfp

## True when the Java method declares generic type parameters.
export predicate isGenericMethod(JavaMethod) => JavaMethod.IsGeneric

## True for Java `synchronized` blocks.
export predicate isSynchronizedBlock(JavaStatement) => JavaStatement.IsSynchronized

## True for Java `try` statements with resources.
export predicate isTryWithResources(JavaStatement) => JavaStatement.IsTryWithResources

## True for Java enhanced `for` / for-each statements.
export predicate isEnhancedFor(JavaStatement) => JavaStatement.IsEnhancedFor

## True for Java `throw` statements.
export predicate isThrow(JavaStatement) => JavaStatement.IsThrow

## True for Java `assert` statements.
export predicate isAssert(JavaStatement) => JavaStatement.IsAssert

## Proves supported explicit paths rethrow the original catch binding.
## Single throws, nested blocks and side-effect-free if/else paths are supported.
## Reassignment, nested functions, unsupported flow and enclosing finally are not proofs.
## Implicit exception effects are outside this syntax proof.
export predicate alwaysRethrowsOriginalException(JavaStatement) =>
    JavaStatement.IsOriginalExceptionAlwaysRethrown

## True for a call directly initializing a try-with-resources variable.
## Nested argument/body calls and Java 9 existing-variable resources do not qualify.
export predicate isUsingResource(JavaStatement) => JavaStatement.IsUsingResource

## True for object creation directly returned or stored in a compiler-bound field.
## Proves the escape site, not eventual disposal. Local/argument/array storage is not a transfer.
## Direct returns work without a JDK; field storage requires attribution and is diagnosed if unavailable.
export predicate transfersResourceOwnership(JavaStatement) => JavaStatement.IsOwnershipTransferred

## True for a compiler-bound InterruptedException (or subtype) catch, not arbitrary cancellation errors.
## Requires JDK attribution; fallback returns false with a diagnostic.
export predicate isCancellationHandler(JavaStatement) => JavaStatement.IsCancellationHandler

## Proves original InterruptedException propagation or Thread.currentThread().interrupt() restoration.
## Supports explicit if/else paths and void returns after restoration, not arbitrary replacement throws.
## No finally, reassignment, nested function, clearing call or unknown flow is accepted.
## Requires JDK attribution; implicit exception effects and token/future cancellation are not modeled.
export predicate isCallerCancellationPreserved(JavaStatement) => JavaStatement.IsCallerCancellationPreserved
