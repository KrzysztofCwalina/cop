import code
import csharp-library-checks

let cb : Codebase = provider('csharp')

# print API surface as C# stubs
export command api-listing = foreach cb.Api => '{item.ApiAsText}'

# save API surface to a file
let apiText = cb.Api.text('{item.ApiAsText}')
export command save-api = save('api-surface.txt', apiText)
