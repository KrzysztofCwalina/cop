# Ruff linter integration — runs ruff and produces cop Violations
# Prerequisites: ruff must be installed (pip install ruff)
# Usage: import python-ruff

import code-analysis

let data = provider('python-ruff')

## Returns all ruff violations.
export function diagnostics() : [Violation] => data.Violations

## All ruff lint violations as a collection.
export let ruff-checks = data.Violations

command MAIN = CHECK(ruff-checks)
