# Ruff linter integration — runs ruff and produces cop Violations
# Prerequisites: ruff must be installed (pip install ruff)
# Usage: import python-ruff

import code-analysis

let data = provider('python-ruff', nic)

## Returns all ruff diagnostics.
export function diagnostics() : [Diagnostic] => data.Diagnostics

## All ruff lint diagnostics as a collection.
export let ruff-checks = data.Diagnostics

command MAIN = foreach ruff-checks => '{item.FilePath}({item.Line}): {item.Severity}: {item.RuleId}: {item.Message}'
