# Client library design definitions for Python

# Client type detection
export predicate isClient(Type) => Type.Name:endsWith('Client')
export predicate isAsyncClient(Type) => Type.Name:contains('Async') && isClient

# Naming
export predicate hasBadAsyncName(Type) => isClient && Type.Name:contains('Async')

# Constructor conventions
predicate isKwargsParam(Parameter) => Parameter.Kwargs
predicate isCredentialParam(Parameter) => Parameter.Name == 'credential'
predicate isConnectionStringParam(Parameter) => Parameter.Name:contains('connection_string')
    || Parameter.Name:contains('conn_str')

predicate isMissingKwargs(Type) => Type.Constructors.Count > 0
    && Type.Constructors.First.Parameters:!any(isKwargsParam)
predicate hasConnectionString(Type) => Type.Constructors.Count > 0
    && Type.Constructors.First.Parameters:any(isConnectionStringParam)

# Method conventions
predicate isPublicMethod(Method) => Method:isPublic && !Method.Name:startsWith('_')
predicate isStaticOnClient(Method) => Method:isStatic && isPublicMethod

# Method naming: approved prefixes for client methods
let approvedPrefixes = ['get' 'list' 'create' 'upsert' 'update' 'replace'
    'delete' 'add' 'set' 'remove' 'begin' 'send' 'query' 'close'
    'download' 'upload' 'analyze' 'extract' 'recognize' 'synthesize']

predicate hasBadMethodPrefix(Method) => isPublicMethod
    && !Method.Name:matches('^(get|list|create|upsert|update|replace|delete|add|set|remove|begin|send|query|close|download|upload|analyze|extract|recognize|synthesize|from|__)')
    && !Method.Name:matches('^_')

# Too many positional parameters (>5)
predicate hasTooManyPositionalParams(Method) => isPublicMethod && Method.Parameters.Count > 5

# Missing **kwargs on network methods
predicate isNetworkMethodMissingKwargs(Method) => isPublicMethod
    && Method:isAsync && Method.Parameters:!any(isKwargsParam)

# Static methods on client (should be module-level)
predicate hasStaticMethod(Type) => Type.Methods:any(isStaticOnClient)

# Method name validation
predicate isDoubleUnderscoreMethod(Method) => Method.Name:startsWith('__')
    && Method.Name != '__init__' && Method.Name != '__enter__' && Method.Name != '__exit__'
    && Method.Name != '__aenter__' && Method.Name != '__aexit__'
    && Method.Name != '__repr__' && Method.Name != '__str__'

# Client suffix detection: classes that look like service clients but don't end with Client
predicate isClientLike(Type) => Type.Kind == 'Class'
    && Type.Methods.Count > 3
    && !Type.Name:endsWith('Client')
    && (Type.Name:endsWith('Service') || Type.Name:endsWith('Manager') || Type.Name:endsWith('Handler'))

# LRO naming: methods returning LROPoller should be prefixed with begin_
predicate isLroMethod(Method) => isPublicMethod && Method.ReturnType != null
    && (Method.ReturnType.Name:contains('LROPoller') || Method.ReturnType.Name:contains('Poller'))
predicate hasLroBadName(Method) => isLroMethod && !Method.Name:startsWith('begin_')

# Paging: methods returning paging types should be prefixed with list_
predicate isPagingMethod(Method) => isPublicMethod && Method.ReturnType != null
    && (Method.ReturnType.Name:contains('ItemPaged') || Method.ReturnType.Name:contains('Pager')
        || Method.ReturnType.Name:contains('AsyncItemPaged'))
predicate hasPagingBadName(Method) => isPagingMethod && !Method.Name:startsWith('list_')
    && !Method.Name:startsWith('_list_')

# Name length
export predicate hasNameTooLong(Type) => Type.Name.Length > 40
predicate hasMethodNameTooLong(Method) => isPublicMethod && Method.Name.Length > 40
