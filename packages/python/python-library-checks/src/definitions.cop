# Library API design definitions for Python

predicate isUntypedParam(Parameter) => Parameter.Type == null
    && !Parameter.Variadic && !Parameter.Kwargs

predicate isMissingParamTypes(Method) => Method:isPublic
    && Method.Parameters:any(isUntypedParam)

predicate hasUntypedParams(Type) => Type.Methods:any(isMissingParamTypes)

predicate isMissingReturnType(Method) => Method:isPublic
    && Method.ReturnType == null

predicate hasMissingReturnTypes(Type) => Type.Methods:any(isMissingReturnType)
