# Library API design checks for Python

import code-analysis

## Public methods should have type hints on all parameters
export let untyped-public-params = Code.Types:python:hasUntypedParams
    :toWarning('{item.Name} has public methods with missing parameter type hints')

## Public methods should declare a return type
export let missing-return-types = Code.Types:python:hasMissingReturnTypes
    :toWarning('{item.Name} has public methods without return type annotations')

## All Python library checks combined
export let python-library = untyped-public-params + missing-return-types
