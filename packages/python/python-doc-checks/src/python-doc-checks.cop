# Python documentation checks

import python-checks
import code-analysis

# Missing class docstring
predicate isPublicClass(Type) => Type.Kind == 'Class'
    && !Type.Name:startsWith('_')

predicate isUndocumentedPublicClass(Type) => isPublicClass && !Type.Documented

## Public classes should have a docstring
let missing-class-docstring = Code.Types:python:isUndocumentedPublicClass
    :toWarning('{item.Name} — public classes should have a docstring')

# Missing function/method docstring
predicate isUndocumentedPublicMethod(Method) => Method:isPublic
    && !Method.Name:startsWith('_')
    && !Method.Documented

predicate hasUndocumentedMethods(Type) => Type.Methods:any(isUndocumentedPublicMethod)

## Public functions and methods should have a docstring
let missing-function-docstring = Code.Types:python:hasUndocumentedMethods
    :toWarning('{item.Name} has public methods without docstrings')

## All Python documentation checks combined
export let python-doc-checks = missing-class-docstring + missing-function-docstring
