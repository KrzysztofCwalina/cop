# Azure SDK client library checks for Python

import python-library-checks
import code-analysis

# Credential: constructor must accept a credential parameter
predicate isMissingCredential(Type) => Type.Constructors.Count > 0
    && Type.Constructors.First.Parameters:!any(isCredentialParam)

## Azure clients must accept a 'credential' parameter in the constructor
export let client-needs-credential = Clients:isMissingCredential
    :toWarning('{item.Name} constructor should accept a credential parameter')

# api_version keyword argument
predicate isApiVersionParam(Parameter) => Parameter.Name == 'api_version'
predicate isMissingApiVersion(Type) => Type.Constructors.Count > 0
    && Type.Constructors.First.Parameters:!any(isApiVersionParam)

## Azure clients must accept 'api_version' keyword argument
export let client-needs-api-version = Clients:isMissingApiVersion
    :toWarning('{item.Name} should accept an api_version keyword argument')

# Naming conventions: snake_case for methods
predicate isMethodNotSnakeCase(Method) => Method:isPublic && !Method.Name:startsWith('_')
    && Method.Name:matches('[A-Z]')
predicate hasNonSnakeCaseMethod(Type) => Type.Methods:any(isMethodNotSnakeCase)

## Method names must use snake_case
export let method-snake-case = Clients:hasNonSnakeCaseMethod
    :toWarning('{item.Name} has a method that does not use snake_case naming')

# PascalCase for types (first letter uppercase)
predicate isNotPascalCase(Type) => Type.Name:matches('^[a-z]')

## Type names must use PascalCase
export let type-pascal-case = Code.Types:python:isNotPascalCase
    :toWarning('{item.Name} should use PascalCase for type names')

# Delete operations should return None
predicate isDeleteMethod(Method) => Method:isPublic && (Method.Name:startsWith('delete')
    || Method.Name:startsWith('begin_delete'))
predicate isDeleteReturningValue(Method) => isDeleteMethod && Method.ReturnType != null
    && Method.ReturnType.Name != 'None' && !Method.ReturnType.Name:contains('LROPoller')
    && !Method.ReturnType.Name:contains('Poller')

predicate hasDeleteReturnsValue(Type) => Type.Methods:any(isDeleteReturningValue)

## Delete operations should return None
export let delete-returns-none = Clients:hasDeleteReturnsValue
    :toWarning('{item.Name} delete method should return None or LROPoller[None]')

# raise_with_traceback: use raise ... from instead
predicate isUsingRaiseWithTraceback(Statement) => Statement.Kind == 'call'
    && Statement.MemberName == 'raise_with_traceback'

## Do not use raise_with_traceback; use raise ... from syntax
export let no-raise-with-traceback = Code.Statements:python:isUsingRaiseWithTraceback
    :toError('Use raise ... from instead of raise_with_traceback')

# Legacy typing: type comments instead of annotations
predicate hasLegacyTypeComment(Line) => Line.Text:matches('#\\s*type:')

## Do not use legacy type comments; use Python 3.9+ type hints
export let no-legacy-typing = Code.Lines:python:hasLegacyTypeComment
    :toWarning('Do not use type comments — use Python 3.9+ type annotations instead')

# asyncio import when azure.core transport sleep should be used
predicate isImportingAsyncio(Statement) => Statement.Kind == 'call'
    && Statement.TypeName == 'asyncio' && Statement.MemberName == 'sleep'

## Do not use asyncio.sleep; use transport sleep from azure.core
export let no-asyncio-sleep = Code.Statements:python:isImportingAsyncio
    :toWarning('Use azure.core pipeline transport sleep instead of asyncio.sleep')

# Logging exceptions at non-debug levels
predicate isLoggingExceptionNotDebug(Statement) => Statement.Kind == 'call'
    && (Statement.TypeName:contains('log') || Statement.TypeName:contains('logger'))
    && (Statement.MemberName == 'warning' || Statement.MemberName == 'error'
        || Statement.MemberName == 'info' || Statement.MemberName == 'critical')
    && Statement.Arguments:contains('exc_info')

## Do not log exceptions at non-debug levels (may reveal sensitive info)
export let no-log-exceptions-above-debug = Code.Statements:python:isLoggingExceptionNotDebug
    :toWarning('Do not log exceptions at levels above debug — may reveal sensitive information')

# Missing tracing decorator
predicate hasTracingDecorator(Method) => Method.Decorators:contains('distributed_trace')
    || Method.Decorators:contains('distributed_trace_async')
predicate isPublicServiceMethod(Method) => Method:isPublic && !Method.Name:startsWith('_')
    && Method.Name != 'close' && !Method.Name:startsWith('from_')
predicate isMissingTracing(Method) => isPublicServiceMethod && !hasTracingDecorator

predicate hasMissingTracing(Type) => Type.Methods:any(isMissingTracing)

## Client service methods should have distributed tracing decorator
export let missing-tracing-decorator = Clients:hasMissingTracing
    :toWarning('{item.Name} has a public method without @distributed_trace decorator')

# Deprecated imports: six
predicate isImportingSix(Statement) => Statement.Kind == 'call'
    && Statement.TypeName == 'six'

# Enum values must be uppercase
predicate isEnumBase(Type) => Type.BaseTypes:contains('Enum')
    || Type.BaseTypes:contains('str')
predicate isEnumLike(Type) => Type.Kind == 'Class' && isEnumBase

## All Azure Python client library checks combined
export let python-library-azure-checks = client-needs-credential + client-needs-api-version + method-snake-case + type-pascal-case + delete-returns-none + no-raise-with-traceback + no-legacy-typing + no-asyncio-sleep + no-log-exceptions-above-debug + missing-tracing-decorator
