# Mypy type checker integration — runs mypy and produces cop diagnostics
# Prerequisites: mypy must be installed (pip install mypy)
# Usage: import python-mypy

import code-analysis

let data = provider('python-mypy', nic)

## Returns all mypy diagnostics.
export function diagnostics() : [Diagnostic] => data.Diagnostics

## All mypy type-checking diagnostics as a collection.
export let mypy-checks = data.Diagnostics

command MAIN = foreach mypy-checks => '{item.FilePath}({item.Line}): {item.Severity}: {item.RuleId}: {item.Message}'
