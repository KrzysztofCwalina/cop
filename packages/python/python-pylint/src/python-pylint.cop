# Pylint integration — runs pylint and produces cop diagnostics
# Prerequisites: pylint must be installed (pip install pylint)
# Usage: import python-pylint

import code-analysis

let data = provider('python-pylint', nic)

## Returns all pylint diagnostics.
export function diagnostics() : [Diagnostic] => data.Diagnostics

## All pylint diagnostics as a collection.
export let pylint-checks = data.Diagnostics

command main = foreach pylint-checks => '{item.FilePath}({item.Line}): {item.Severity}: {item.RuleId}: {item.Message}'
