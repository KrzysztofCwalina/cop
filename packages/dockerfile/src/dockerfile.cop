# Dockerfile Package — types for analyzing Dockerfile instructions and build stages.
# Import with: import dockerfile

import code-analysis

## A single Dockerfile instruction with its uppercased keyword, argument, 1-based line number,
## and 0-based FROM stage index. Instructions before the first FROM use Stage -1.
export type DockerInstruction = {
    Instruction : string,
    Argument : string,
    Line : int,
    Stage : int,
    File : File?,
    Source : string
}

## A build stage introduced by FROM. Name is the AS alias or an empty string.
export type DockerStage = {
    Name : string,
    Image : string,
    Index : int,
    Line : int,
    File : File?,
    Source : string
}

export type DockerfileContent = {
    Instructions : [DockerInstruction],
    Stages : [DockerStage]
}

## Parses Dockerfile, Dockerfile.*, and *.dockerfile files in the target directory.
## Example: let d = dockerfile.parse()
export function parse() : DockerfileContent => provider('dockerfile')

## Parses Dockerfile, Dockerfile.*, and *.dockerfile files in the specified directory.
## Example: let d = dockerfile.parse('containers')
export function parse(path : string) : DockerfileContent => provider('dockerfile', path)

# Violation overloads for Dockerfile types — via TextFilePosition trait conformance.
export type DockerInstruction : TextFilePosition = { filePath => item.File.Path, line => item.Line }
export type DockerStage : TextFilePosition = { filePath => item.File.Path, line => item.Line }
