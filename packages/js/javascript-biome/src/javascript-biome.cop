# Biome integration — runs biome and produces cop diagnostics
# Prerequisites: biome must be installed (npm install @biomejs/biome)

import code-analysis

let data = provider('javascript-biome', nic)

## Returns the Biome diagnostics collection
export function diagnostics() : [Diagnostic] => data.Diagnostics
export let biome-checks = data.Diagnostics

command MAIN = foreach biome-checks => '{item.FilePath}({item.Line}): {item.Severity}: {item.RuleId}: {item.Message}'
