# JavaScript/TypeScript source language provider
import code

## Parses JavaScript/TypeScript source files in the target directory and returns a Codebase.
## Example: let cb = javascript.parse()
export function parse() : Codebase => provider('javascript')

## Parses JavaScript/TypeScript source files in the specified directory and returns a Codebase.
## Example: let cb = javascript.parse('/path/to/project')
export function parse(path : string) : Codebase => provider('javascript', path)
