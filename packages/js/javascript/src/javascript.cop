# JavaScript/TypeScript source language provider
import code

let cb : Codebase = provider('javascript', nic)

## Returns all types (classes, interfaces) in the JavaScript/TypeScript codebase.
export function types() : [Type] => cb.Types

## Returns all statements in the JavaScript/TypeScript codebase.
export function statements() : [Statement] => cb.Statements

## Returns all source lines in the JavaScript/TypeScript codebase.
export function lines() : [Line] => cb.Lines

## Returns all method/function calls in the JavaScript/TypeScript codebase.
export function calls() : [Call] => cb.Calls

## Returns all source files in the JavaScript/TypeScript codebase.
export function files() : [File] => cb.Files

## Returns all code regions in the JavaScript/TypeScript codebase.
export function regions() : [Region] => cb.Regions

## Returns all projects in the JavaScript/TypeScript workspace.
export function projects() : [Project] => cb.Projects
