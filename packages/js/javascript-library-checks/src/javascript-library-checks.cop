# Library design definitions for JavaScript/TypeScript

import code-analysis

## Do not use default exports — use named exports only
predicate isDefaultExport(Line) => Line.Text:matches('^export\\s+default\\s')
predicate hasDefaultExport(Type) => Type.File.Lines:any(isDefaultExport)
export let no-default-exports = Code.Lines:javascript:isDefaultExport
    :toError('Do not use default exports — use named exports')

## Do not import Promise from external libraries (use native Promise)
predicate isImportingBluebird(Line) => Line.Text:matches('from\\s+[\'"]bluebird[\'"]')
    || Line.Text:matches('require\\([\'"]bluebird[\'"]\\)')
export let no-external-promises = Code.Lines:javascript:isImportingBluebird
    :toError('Use native Promise — do not import from bluebird or other polyfill libraries')

## Do not use const enums (problematic for consumers)
predicate isConstEnumDeclaration(Line) => Line.Text:matches('^\\s*(export\\s+)?const\\s+enum\\s')
export let no-const-enums = Code.Lines:javascript:isConstEnumDeclaration
    :toWarning('Do not use const enum — use regular enum instead')

## Do not reference window global — use self for cross-platform compatibility
predicate isWindowUsage(Statement) => Statement.Kind == 'call'
    && Statement.TypeName == 'window'
predicate hasWindowReference(Line) => Line.Text:matches('\\bwindow\\.')
    && !Line.Text:matches('//') && !Line.Text:matches('\\*')
export let no-window-reference = Code.Lines:javascript:hasWindowReference
    :toError('Do not use window — use self for cross-platform compatibility')

# Error handling: only throw built-in error types
predicate isThrowingNonStandardError(Statement) => Statement.Kind == 'throw'
    && Statement.TypeName != null
    && Statement.TypeName != 'Error'
    && Statement.TypeName != 'TypeError'
    && Statement.TypeName != 'RangeError'
    && Statement.TypeName != 'ReferenceError'
    && Statement.TypeName != 'SyntaxError'
    && Statement.TypeName != 'URIError'
    && !Statement.TypeName:endsWith('Error')

## All JavaScript library checks combined
export let javascript-library-checks = no-default-exports + no-external-promises + no-const-enums + no-window-reference
