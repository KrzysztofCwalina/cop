# TypeScript compiler integration — runs tsc and produces cop diagnostics
# Prerequisites: typescript must be installed (npm install typescript)

import code-analysis

let data = provider('typescript-tsc', nic)

## Returns the TypeScript compiler diagnostics collection
export function diagnostics() : [Diagnostic] => data.Diagnostics
export let tsc-checks = data.Diagnostics

command main = foreach tsc-checks => '{item.FilePath}({item.Line}): {item.Severity}: {item.RuleId}: {item.Message}'
