# Azure-specific client library definitions for JavaScript/TypeScript

import javascript-library-client-checks
import code-analysis

## Azure client constructors must accept a TokenCredential parameter
predicate isConstructorMethod(Method) => Method.Name == 'constructor'
predicate hasCredentialParam(Parameter) => Parameter.Name:contains('credential')
    || (Parameter.Type != null && Parameter.Type.Name:contains('Credential'))
predicate isCtorWithCredential(Method) => isConstructorMethod
    && Method.Parameters:any(hasCredentialParam)
predicate isMissingCredential(Type) => isClient
    && Type.Constructors.Count > 0
    && Type.Constructors:!any(isCtorWithCredential)
export let client-needs-credential = Clients:isMissingCredential
    :toError('{item.Name} constructor must accept a TokenCredential parameter')

# Client names should follow Azure pattern: <ServiceName>Client
predicate hasTooShortName(Type) => isClient && Type.Name.Length < 8

# Async methods parameter conventions
predicate isUsingInterfaceParam(Parameter) => Parameter.Type != null
    && !Parameter.Type.Name:startsWith('class ')
    && (Parameter.Type.Name:endsWith('Options')
        || Parameter.Type.Name:endsWith('Settings')
        || Parameter.Type.Name:endsWith('Config'))

## Source files must have a copyright header on the first line
predicate hasCopyrightHeader(Line) => Line.Number == 1
    && Line.Text:contains('Copyright')
predicate isMissingCopyright(File) => File.Lines.Count > 0
    && File.Lines:!any(hasCopyrightHeader)
export let copyright-header = Code.Lines:javascript:isMissingCopyright
    :toWarning('Source file is missing a copyright header comment')

# Azure Core imports: clients should use @azure/core-client
predicate isImportingAzureCore(File) => File.Imports:any(isAzureCoreImport)
predicate isAzureCoreImport(Import) => Import:contains('@azure/core')

## Client methods must only throw Error, TypeError, RangeError, or RestError
predicate isThrowingCustomError(Statement) => Statement.Kind == 'throw'
    && Statement.TypeName != null
    && Statement.TypeName != 'Error'
    && Statement.TypeName != 'TypeError'
    && Statement.TypeName != 'RangeError'
    && Statement.TypeName != 'RestError'
    && !Statement.TypeName:endsWith('Error')
export let error-handling = Code.Statements:javascript:isThrowingCustomError
    :toError('Only throw Error, TypeError, RangeError, or RestError — do not throw custom non-Error types')

## Azure clients should not use console for logging — use @azure/logger
predicate isUsingConsoleLog(Statement) => Statement.Kind == 'call'
    && Statement.TypeName == 'console'
export let no-console-logging = Clients.Methods.Statements:isUsingConsoleLog
    :toError('Do not use console for logging — use @azure/logger instead')

## All Azure-specific JavaScript client library checks combined
export let javascript-library-client-azure-checks = client-needs-credential + copyright-header + error-handling + no-console-logging
