# ESLint integration — runs eslint and produces cop diagnostics
# Prerequisites: eslint must be installed (npm install eslint)

import code-analysis

let data = provider('javascript-eslint', nic)

## Returns the ESLint diagnostics collection
export function diagnostics() : [Diagnostic] => data.Diagnostics
export let eslint-checks = data.Diagnostics

command main = foreach eslint-checks => '{item.FilePath}({item.Line}): {item.Severity}: {item.RuleId}: {item.Message}'
