# Client library design definitions for JavaScript/TypeScript

import javascript-checks
import code-analysis

# Client type detection
export predicate isClient(Type) => Type.Name:endsWith('Client')
export predicate Clients(Types) => javascript && isClient

# Shared method predicates
predicate isPublicMethod(Method) => Method:isPublic && !Method.Name:startsWith('_')

## Client methods must use approved verb prefixes (not erase, fetch, make, pop, push, etc.)
let bannedPrefixes = ['erase' 'fetch' 'getAll' 'insertOrUpdate' 'make' 'pop' 'push' 'updateOrInsert']
predicate hasBannedVerb(Method) => isPublicMethod
    && (Method.Name:startsWith('erase')
        || Method.Name:startsWith('fetch')
        || Method.Name:startsWith('getAll')
        || Method.Name:startsWith('insertOrUpdate')
        || Method.Name:startsWith('make')
        || Method.Name:startsWith('pop')
        || Method.Name:startsWith('push')
        || Method.Name:startsWith('updateOrInsert'))
predicate hasBannedVerb(Type) => Type.Methods:any(hasBannedVerb)
export let standardized-verbs = Clients:hasBannedVerb
    :toError('{item.Name} uses a banned method verb prefix — use get, list, create, upsert, update, replace, delete, add, set, or remove')

## Methods returning a subclient must be named get*Client
predicate isReturningClient(Method) => isPublicMethod && Method.ReturnType != null
    && Method.ReturnType.Name:endsWith('Client')
predicate hasSubclientBadName(Method) => isReturningClient
    && !Method.Name:startsWith('get')
predicate hasSubclientBadName(Type) => Type.Methods:any(hasSubclientBadName)
export let subclient-naming = Clients:hasSubclientBadName
    :toError('{item.Name} returns a subclient but is not named get*Client')

# Drop noun: methods returning own type should not include the service name
predicate isReturningSelf(Method) => isPublicMethod && Method.ReturnType != null
    && Method.ReturnType.Name == Type.Name

## Async client methods must support cancellation (AbortSignal or options)
predicate isOptionsParam(Parameter) => Parameter.Name == 'options'
    || Parameter.Type != null && Parameter.Type.Name:endsWith('Options')
predicate isAsyncPublicMethod(Method) => Method:isAsync && isPublicMethod
predicate hasAbortSignal(Parameter) => Parameter.Type != null
    && (Parameter.Type.Name:contains('AbortSignal') || Parameter.Type.Name:endsWith('Options'))
predicate isAsyncMissingCancellation(Method) => isAsyncPublicMethod
    && Method.Parameters.Count > 0
    && Method.Parameters:!any(hasAbortSignal)
    && Method.Parameters:!any(isOptionsParam)
predicate hasMissingCancellation(Type) => Type.Methods:any(isAsyncMissingCancellation)
export let support-cancellation = Clients:hasMissingCancellation
    :toError('{item.Name} has an async method without cancellation support — accept AbortSignalLike or an options parameter')

## list methods should return PagedAsyncIterableIterator
predicate isListMethod(Method) => isPublicMethod && Method.Name:startsWith('list')
predicate hasPagingBadReturn(Method) => isListMethod && Method.ReturnType != null
    && !Method.ReturnType.Name:contains('Paged')
    && !Method.ReturnType.Name:contains('PagedAsyncIterableIterator')
predicate hasPagingBadReturn(Type) => Type.Methods:any(hasPagingBadReturn)
export let pagination-list-return = Clients:hasPagingBadReturn
    :toWarning('{item.Name} list method should return PagedAsyncIterableIterator')

## LRO methods should be prefixed with begin
predicate hasPollerReturn(Method) => isPublicMethod && Method.ReturnType != null
    && (Method.ReturnType.Name:contains('Poller')
        || Method.ReturnType.Name:contains('PollerLike'))
predicate hasLroBadName(Method) => hasPollerReturn && !Method.Name:startsWith('begin')
predicate hasLroBadName(Type) => Type.Methods:any(hasLroBadName)
export let lro-begin-prefix = Clients:hasLroBadName
    :toError('{item.Name} returns a Poller but is not prefixed with begin')

## All JavaScript client library checks combined
export let javascript-library-client-checks = standardized-verbs + support-cancellation + subclient-naming + lro-begin-prefix + pagination-list-return
