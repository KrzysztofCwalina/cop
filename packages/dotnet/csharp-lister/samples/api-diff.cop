import csharp-library-checks
import code-analysis

# Baseline: C# stub files in api/ directory
predicate isBaselineApi(Api) => publicApi && Api.File.Path:matches('[/\\]api[/\\]')
# Source: everything NOT in api/
predicate isSourceApi(Api) => publicApi && !Api.File.Path:matches('[/\\]api[/\\]')

# Build lookup lists from current source and baseline
let baselineSignatures = Code.Api:isCSharp:isBaselineApi.Select(item.Signature)
let currentSignatures = Code.Api:isCSharp:isSourceApi.Select(item.Signature)

# Diff predicates
predicate isRemovedApi(Api) => isBaselineApi && !Api.Signature:in(currentSignatures)
predicate isAddedApi(Api) => isSourceApi && !Api.Signature:in(baselineSignatures)

# Report results
export let api-removed = Code.Api:isRemovedApi
    :toError('API REMOVED (breaking): {item.Signature}')
export let api-added = Code.Api:isAddedApi
    :toInfo('API ADDED: {item.Signature}')
