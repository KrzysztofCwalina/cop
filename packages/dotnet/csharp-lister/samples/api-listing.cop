# @sample skip-validation — depends on csharp-library-checks package source bug
import csharp-library-checks

# print API surface as C# stubs
export command api-listing = foreach Code.Api:isCSharp:publicApi => '{item.ApiAsText}'

# save API surface to a file
let apiText = Code.Api:isCSharp:publicApi.text('{item.ApiAsText}')
export command save-api = save('api-surface.txt', apiText)
