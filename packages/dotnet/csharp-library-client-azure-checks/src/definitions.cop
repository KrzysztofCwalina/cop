# Azure SDK client library definitions for C#

import csharp-library-client
import csharp-library
import csharp

predicate isTokenCredential(Parameter) => Parameter.Type == 'TokenCredential'
predicate hasTokenCredentialParam(Constructor) => Constructor.Parameters:any(isTokenCredential)

predicate isInheritingClientOptions(Type) => Type:inheritsFrom('ClientOptions') || Type:inheritsFrom('ClientPipelineOptions')

predicate isOptionsParameter(Parameter) => Parameter.Type:endsWith('Options')
predicate hasCtorWithOptions(Type) => Type.Constructors:any(isCtorWithOptions)
predicate isCtorWithOptions(Constructor) => Constructor:isPublic && Constructor.Parameters:any(isOptionsParameter)
predicate hasCtorWithoutOptions(Type) => Type.Constructors:any(isCtorLackingOptions)
predicate isCtorLackingOptions(Constructor) => Constructor:isPublic && Constructor.Parameters:!any(isOptionsParameter)
    && Constructor.Parameters.Count > 0

predicate isRequestContent(Parameter) => Parameter.Type == 'RequestContent' || Parameter.Type == 'RequestBody'
predicate hasRequestContent(Method) => Method.Parameters:any(isRequestContent)
predicate isConvenience(Method) => Method:isPublic && Method:isVirtual

predicate hasResourceSuffix(Type) => Type.Name:endsWith('Resource')

predicate isServiceVersionEnum(Type) => Type.Kind == 'Enum' && Type.Name == 'ServiceVersion'

predicate isCancellation(Parameter) => Parameter.Type == 'CancellationToken' || Parameter.Type == 'RequestContext'
predicate isPublicServiceMethod(Method) => Method:isPublic && Method:isVirtual && Method:!isStatic

predicate isModelReaderWriterRead(Statement) => Statement.Kind == 'call'
    && Statement.TypeName == 'ModelReaderWriter' && Statement.MemberName == 'Read'

predicate isRequestContextParam(Parameter) => Parameter.Type == 'RequestContext'
predicate isProtocolMethodByContext(Method) => Method:isPublic && Method:isVirtual
    && Method.Parameters:any(isRequestContextParam)

predicate isProtocolMethod(Method) => Method:isPublic && Method:isVirtual && Method.Parameters:any(isRequestContent)
predicate isConvenienceMethod(Method) => Method:isPublic && Method:isVirtual && Method.Parameters:!any(isRequestContent)
predicate isSameNameMethod(Method2) => Method2.Name == Method.Name
predicate hasConvenienceCounterpart(Method) => Type.Methods.Where(isConvenienceMethod):any(isSameNameMethod)

predicate isInternalsVisibleTo(Statement) => Statement.Kind == 'attribute'
    && Statement.TypeName == 'InternalsVisibleTo'

# AZC0112: InternalsVisibleTo targeting non-test assemblies
predicate isInternalsVisibleToNonTest(Statement) => isInternalsVisibleTo
    && !Statement.Arguments.First:contains('Test')

# AZC0021: ClientSettings constructor should not combine settings param with other params
predicate isClientSettingsParam(Parameter) => Parameter.Type:endsWith('Settings')
predicate hasSettingsAndOtherParams(Constructor) => Constructor:isPublic
    && Constructor.Parameters:any(isClientSettingsParam)
    && Constructor.Parameters.Count > 1
predicate hasSettingsCtorOverloaded(Type) => Type.Constructors:any(hasSettingsAndOtherParams)

# AZC0034: Duplicate type names across SDK and .NET BCL
let bclTypeNames = [
    'Action' 'Activator' 'AppContext' 'AppDomain' 'Array' 'Attribute'
    'BitConverter' 'Boolean' 'Buffer' 'Byte' 'Char' 'CharEnumerator'
    'CLSCompliantAttribute' 'Console' 'Convert' 'DateTime' 'DateTimeOffset'
    'Decimal' 'Delegate' 'Double' 'Enum' 'Environment' 'EventArgs'
    'EventHandler' 'Exception' 'FlagsAttribute' 'FormattableString' 'Func'
    'GC' 'Guid' 'Half' 'HashCode' 'IAsyncDisposable' 'IAsyncResult'
    'ICloneable' 'IComparable' 'IConvertible' 'IDisposable' 'IEquatable'
    'IFormattable' 'IFormatProvider' 'Index' 'Int16' 'Int32' 'Int64'
    'IntPtr' 'InvalidCastException' 'InvalidOperationException'
    'IObservable' 'IObserver' 'IProgress' 'IServiceProvider'
    'Lazy' 'MarshalByRefObject' 'Math' 'MathF' 'Memory'
    'MulticastDelegate' 'Nullable' 'Object' 'ObsoleteAttribute'
    'OperatingSystem' 'OperationCanceledException' 'OutOfMemoryException'
    'OverflowException' 'Path' 'Predicate' 'Progress'
    'Random' 'Range' 'ReadOnlyMemory' 'ReadOnlySpan'
    'SByte' 'Single' 'Span' 'StackOverflowException' 'Stream'
    'String' 'StringComparer' 'StringComparison' 'StringBuilder'
    'Task' 'TaskCompletionSource' 'TimeOnly' 'DateOnly'
    'TimeProvider' 'TimeSpan' 'TimeZoneInfo' 'Timeout'
    'Tuple' 'Type' 'TypeCode' 'UInt16' 'UInt32' 'UInt64'
    'UIntPtr' 'UnauthorizedAccessException' 'Uri' 'UriBuilder'
    'ValueTask' 'ValueTuple' 'Version' 'Void' 'WeakReference'
    'BinaryReader' 'BinaryWriter' 'Directory' 'DirectoryInfo'
    'File' 'FileInfo' 'FileStream' 'MemoryStream' 'StreamReader'
    'StreamWriter' 'TextReader' 'TextWriter'
    'Channel' 'Pipe' 'PipeReader' 'PipeWriter'
    'CancellationToken' 'CancellationTokenSource' 'Mutex'
    'Semaphore' 'SemaphoreSlim' 'Timer'
    'Dictionary' 'HashSet' 'KeyValuePair' 'LinkedList' 'List'
    'Queue' 'SortedDictionary' 'SortedList' 'SortedSet' 'Stack'
    'HttpClient' 'HttpContent' 'HttpRequestMessage' 'HttpResponseMessage'
    'JsonDocument' 'JsonElement' 'JsonSerializer' 'JsonSerializerOptions'
    'Regex' 'Match' 'Group' 'Capture'
    'Assembly' 'Module' 'FieldInfo' 'MethodInfo' 'PropertyInfo'
    'IPAddress' 'IPEndPoint' 'Socket'
    'Encoding' 'UTF8Encoding'
    'BigInteger' 'Complex' 'Matrix' 'Vector'
    'Color' 'Point' 'Rectangle' 'Size'
    'Credential' 'Certificate'
    'Configuration' 'Options' 'Settings' 'Policy'
    'Expression' 'Claim' 'ClaimsIdentity' 'ClaimsPrincipal'
    'Notification' 'Subscription' 'Message' 'Endpoint' 'Connection'
]
predicate isDuplicatingBclTypeName(Type) => bclTypeNames:contains(Type.Name)

# AZC0035: Output model types need a ModelFactory method
predicate isModelFactory(Type) => Type.Name:endsWith('ModelFactory')
let factoryTypes = Code.Types:isModelFactory
predicate isFactoryMethod(Method) => Method:isStatic && Method:isPublic && Method.ReturnType.Name == Type.Name
predicate hasFactoryMethodFor(FactoryType) => FactoryType.Methods:any(isFactoryMethod)
predicate hasFactory(Type) => factoryTypes:any(hasFactoryMethodFor)
predicate isMissingFactory(Type) => isModel && !hasFactory

# AZC0104: Use EnsureCompleted() instead of GetAwaiter().GetResult() in sync methods
predicate isGetResultInSyncMethod(Statement) => Statement.Kind == 'call'
    && Statement.MemberName == 'GetResult' && isInSyncMethod

# AZC0107: Don't call *Async methods from sync context
predicate isAsyncCallInSyncMethod(Statement) => Statement.Kind == 'call'
    && Statement.MemberName:endsWith('Async') && isInSyncMethod

# AZC0012: Single-word public type names are too generic
predicate hasSingleWordName(Type) => Type:isPublic && Type.Name:matches('^[A-Z][a-z]+$')

# AZC0020: Async calls/awaits should propagate CancellationToken or RequestContext
predicate isInMethodWithCancellation(Statement) => Statement.Method != null
    && Statement.Method.Parameters:any(isCancellation)
predicate isReferringToToken(Argument) => Argument:contains('cancellationToken')
    || Argument:contains('cancellation') || Argument:contains('context')
predicate isAsyncCallMissingToken(Statement) => Statement.Kind == 'await'
    && isInMethodWithCancellation
    && !Statement.Arguments:any(isReferringToToken)