# Options design — ClientOptions type validation

import csharp-library-client-checks
import code-analysis

predicate isInheritingClientOptions(Type) => Type:inheritsFrom('ClientOptions') || Type:inheritsFrom('ClientPipelineOptions')
predicate isMissingBaseClass(Type) => !isInheritingClientOptions

## Options types must inherit from ClientOptions or ClientPipelineOptions
export let options-inherits-base = ClientOptions:isMissingBaseClass
    :toWarning('{item.Name} must inherit from ClientOptions or ClientPipelineOptions')

predicate hasTooManyCtorParams(Constructor) => Constructor:isPublic && Constructor.Parameters.Count > 1
predicate hasOverloadedOptionsCtor(Type) => Type.Constructors:any(hasTooManyCtorParams)

## ClientOptions constructors should not take more than one parameter
export let options-single-ctor-param = ClientOptions:hasOverloadedOptionsCtor
    :toWarning('{item.Name} constructor should only accept an optional ServiceVersion parameter')

predicate isServiceVersionEnum(Type) => Type.Kind == 'Enum' && Type.Name == 'ServiceVersion'

predicate isFirstParamNotServiceVersion(Constructor) => Constructor:isPublic
    && Constructor.Parameters.Count > 0
    && !Constructor.Parameters.First.Type:endsWith('ServiceVersion')
predicate hasOptionsBadFirstParam(Type) => Type.Constructors:any(isFirstParamNotServiceVersion)

## ClientOptions constructor first parameter should be ServiceVersion
export let options-first-param-service-version = ClientOptions:hasOptionsBadFirstParam
    :toWarning('{item.Name} constructor first parameter should be ServiceVersion')

predicate isMissingServiceVersionEnum(Type) => Type.NestedTypes:!any(isServiceVersionEnum)

## ClientOptions types should contain a nested ServiceVersion enum
export let options-needs-service-version-enum = ClientOptions:isMissingServiceVersionEnum
    :toWarning('{item.Name} should contain a nested ServiceVersion enum')

predicate hasBadVersionName(Name) => !Name:matches('^V\\d+(_\\d+)*$')
predicate hasServiceVersionBadNames(Type) => Type.Kind == 'Enum' && Type.Name == 'ServiceVersion'
    && Type.EnumValues:any(hasBadVersionName)
predicate hasBadServiceVersionNames(Type) => Type.NestedTypes:any(hasServiceVersionBadNames)

## ServiceVersion enum members should follow 'V{major}_{minor}' naming pattern
export let service-version-naming = ClientOptions:hasBadServiceVersionNames
    :toWarning('{item.Name} ServiceVersion member names should follow pattern V1_0')

predicate isServiceVersionParamNoDefault(Constructor) => Constructor:isPublic
    && Constructor.Parameters.Count > 0
    && Constructor.Parameters.First.Type:endsWith('ServiceVersion')
    && !Constructor.Parameters.First.Defaulted
predicate hasOptionsCtorMissingDefault(Type) => Type.Constructors:any(isServiceVersionParamNoDefault)

## ServiceVersion parameter should have a default value (latest version)
export let service-version-default-value = ClientOptions:hasOptionsCtorMissingDefault
    :toWarning('{item.Name} ServiceVersion parameter should default to the latest version')

let options-design = options-inherits-base + options-single-ctor-param + options-first-param-service-version + options-needs-service-version-enum + service-version-naming + service-version-default-value
