# Method design — method signatures and patterns

import csharp-library-client-checks
import code-analysis

predicate isCancellation(Parameter) => Parameter.Type == 'CancellationToken' || Parameter.Type == 'RequestContext'
predicate isPublicServiceMethod(Method) => Method:isPublic && Method:isVirtual && Method:!isStatic
predicate isMissingCancellation(Method) => Method.Parameters:!any(isCancellation)
predicate hasCancellationNotOptional(Method) => Method.Parameters:any(isCancellation)
    && !Method.Parameters.Last.Defaulted
    && (Method.Parameters.Last.Type == 'CancellationToken' || Method.Parameters.Last.Type == 'RequestContext')
predicate hasMethodMissingCancellation(Type) => Type.Methods.Where(isPublicServiceMethod):any(isMissingCancellation)

## Public virtual service methods must accept CancellationToken or RequestContext
export let service-method-needs-cancellation = Clients:hasMethodMissingCancellation
    :toWarning('{item.Name} must accept CancellationToken or RequestContext')

predicate hasBannedReturnType(Method) => Method:isPublic
    && Method.ReturnType != null
    && (Method.ReturnType.Name == 'HttpResponseMessage'
        || Method.ReturnType.Name == 'HttpRequestMessage'
        || Method.ReturnType.Name == 'HttpClient')
predicate hasBannedReturn(Type) => Type.Methods:any(hasBannedReturnType)

## Client methods should return azure-specific types, not raw HTTP types
export let no-raw-http-return-types = Clients:hasBannedReturn
    :toWarning('{item.Name} should not return raw HTTP types')

predicate isRequestContextParam(Parameter) => Parameter.Type == 'RequestContext'
predicate isProtocolMethodByContext(Method) => Method:isPublic && Method:isVirtual
    && Method.Parameters:any(isRequestContextParam)

let AllowedProtocolReturns = [
    'Response' 'Task<Response>'
    'Response<bool>' 'Task<Response<bool>>'
    'Operation' 'Task<Operation>'
    'Operation<BinaryData>' 'Task<Operation<BinaryData>>'
    'Pageable<BinaryData>' 'AsyncPageable<BinaryData>'
    'Operation<Pageable<BinaryData>>'
    'Task<Operation<AsyncPageable<BinaryData>>>'
    'Task<Operation<Pageable<BinaryData>>>'
]

predicate hasAllowedProtocolReturn(Method) => Method.ReturnType:in(AllowedProtocolReturns)
predicate hasInvalidProtocolReturn(Method) => isProtocolMethodByContext && !hasAllowedProtocolReturn
predicate hasProtocolWithInvalidReturn(Type) => Type.Methods:any(hasInvalidProtocolReturn)

## Protocol methods (with RequestContext) must return allowed types only
export let protocol-method-return-type = Clients:hasProtocolWithInvalidReturn
    :toWarning('{item.Name} protocol method has invalid return type')

predicate isProtocolMethod(Method) => Method:isPublic && Method:isVirtual && Method.Parameters:any(isRequestContent)
predicate isConvenienceMethod(Method) => Method:isPublic && Method:isVirtual && Method.Parameters:!any(isRequestContent)
predicate isSameNameMethod(Method2) => Method2.Name == Method.Name
predicate hasConvenienceCounterpart(Method) => Type.Methods.Where(isConvenienceMethod):any(isSameNameMethod)
predicate hasAmbiguousOverload(Type) => Type.Methods.Where(isProtocolMethod):any(hasConvenienceCounterpart)

## Avoid ambiguous overloads between protocol and convenience methods
export let no-ambiguous-overloads = Clients:hasAmbiguousOverload
    :toWarning('{item.Name} may have ambiguous protocol/convenience overloads')

let method-design = service-method-needs-cancellation + no-raw-http-return-types + protocol-method-return-type + no-ambiguous-overloads
