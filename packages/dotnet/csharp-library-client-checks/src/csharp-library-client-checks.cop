# Client library design checks for C#

import csharp-checks
import code-analysis

# Client type identification

export predicate isClient(Type) => Type.Name:endsWith('Client')
export predicate isClientOptionsType(Type) => Type.Name:endsWith('ClientOptions')
export predicate Clients(Types) => csharp && isClient

export predicate isModel(Type) => Type.Kind == 'Class' && Type:isPublic && !isClient && !isClientOptionsType
export predicate Models(Types) => csharp && isModel
export predicate ClientOptions(Types) => csharp && isClientOptionsType

# Naming suffixes

export predicate hasCollectionSuffix(Type) => Type.Name:endsWith('Collection')
export predicate hasRequestSuffix(Type) => Type.Name:endsWith('Request')
export predicate hasParameterSuffix(Type) => Type.Name:endsWith('Parameter') || Type.Name:endsWith('Parameters')
export predicate hasOptionSuffix(Type) => Type.Name:endsWith('Option') || Type.Name:endsWith('Options')

# Constructor checks

predicate isOptionsParam(Parameter) => Parameter.Type:endsWith('Options')
predicate isConstructorWithOptions(Constructor) => Constructor.Parameters:any(isOptionsParam)

export predicate isProtectedParameterless(Constructor) => Constructor:isProtected && Constructor.Parameters.Count == 0

predicate isMissingOptionsConstructor(Type) => Type.Constructors:!any(isConstructorWithOptions)
predicate isNotSealedOrAbstract(Type) => Type:!isSealed && Type:!isAbstract

export predicate isMissingMockingConstructor(Type) => Type.Constructors:!any(isProtectedParameterless)

## Client types must have a constructor that accepts an Options parameter
export let client-needs-options-ctor = Clients:isMissingOptionsConstructor
    :toWarning('{item.Name} should accept an options parameter')

## Client types must be sealed or abstract to prevent unintended inheritance
export let client-sealed-or-abstract = Clients:isNotSealedOrAbstract
    :toWarning('{item.Name} should be sealed or abstract')

# Method checks

predicate isCancellationToken(Parameter) => Parameter.Type == 'CancellationToken'
predicate isPublicAsync(Method) => Method:isPublic && Method:isAsync
predicate isMissingCancellationToken(Method) => Method.Parameters:!any(isCancellationToken)
predicate hasAsyncWithoutCancellation(Type) => Type.Methods.Where(isPublicAsync):any(isMissingCancellationToken)

predicate isPublicInstance(Method) => Method:isPublic && Method:!isStatic
predicate isNotVirtual(Method) => Method:!isVirtual && Method:!isOverride && Method:!isAbstract
predicate hasNonVirtualServiceMethod(Type) => Type.Methods.Where(isPublicInstance):any(isNotVirtual)

predicate isAsyncServiceMethod(Method) => Method:isPublic && Method:isVirtual && Method.Name:endsWith('Async')
predicate isMissingSyncCounterpart(Method) => !Type.MethodNames:contains(Method.Name.Trim('Async'))
predicate hasAsyncWithoutSync(Type) => Type.Methods.Where(isAsyncServiceMethod):any(isMissingSyncCounterpart)

## Async methods on client types must accept a CancellationToken parameter
export let async-needs-cancellation-token = Clients:hasAsyncWithoutCancellation
    :toWarning('{item.Name} is async without CancellationToken')

## Public instance methods on client types should be virtual for mocking
export let client-methods-virtual = Clients:hasNonVirtualServiceMethod
    :toWarning('{item.Name} has non-virtual service method')

## Every public async method on a client type must have a matching sync method
export let async-needs-sync-counterpart = Clients:hasAsyncWithoutSync
    :toWarning('{item.Name} has async method without sync counterpart')

## All client library checks combined
export let csharp-library-client-checks = client-needs-options-ctor + client-sealed-or-abstract + async-needs-cancellation-token + client-methods-virtual + async-needs-sync-counterpart
