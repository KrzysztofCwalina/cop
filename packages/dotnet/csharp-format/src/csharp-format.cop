# dotnet format integration — runs dotnet format and produces cop diagnostics
# Prerequisites: dotnet format must be installed

import code-analysis

let data = provider('csharp-format', nic)

## Returns the dotnet format diagnostics collection
export function diagnostics() : [Diagnostic] => data.Diagnostics
export let csharp-format-checks = data.Diagnostics

command main = foreach csharp-format-checks => '{item.FilePath}({item.Line}): {item.Severity}: {item.RuleId}: {item.Message}'
