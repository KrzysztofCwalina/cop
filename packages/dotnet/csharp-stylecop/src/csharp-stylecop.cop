# StyleCop integration — runs StyleCop and produces cop violations
# Prerequisites: StyleCop must be installed

import code-analysis

let data = provider('csharp-stylecop')

## Returns the StyleCop violations collection
export function violations() : [Violation] => data.Violations
export function diagnostics() : [Violation] => data.Violations
export let stylecop-checks = data.Violations

command MAIN = CHECK(stylecop-checks)
