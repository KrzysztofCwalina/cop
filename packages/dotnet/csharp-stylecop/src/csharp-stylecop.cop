# StyleCop integration — runs StyleCop and produces cop diagnostics
# Prerequisites: StyleCop must be installed

import code-analysis

let data = provider('csharp-stylecop', nic)

## Returns the StyleCop diagnostics collection
export function diagnostics() : [Diagnostic] => data.Diagnostics
export let stylecop-checks = data.Diagnostics

command MAIN = foreach stylecop-checks => '{item.FilePath}({item.Line}): {item.Severity}: {item.RuleId}: {item.Message}'
