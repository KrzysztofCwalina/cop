# HTTP Server Package
# Provides helper functions for building HTTP responses in cop pipelines.
# Import with: import http
# Usage:
#   async foreach Requests => handle => RESPONSES

export let Requests : [Request] = source('http')
export let RESPONSES : [Response] = sink('http')

export enum HttpMethod = GET | POST | PUT | DELETE | PATCH | HEAD | OPTIONS
export enum ContentType = 'application/json' | 'text/plain' | 'text/html' | 'application/xml' | 'multipart/form-data' | 'application/octet-stream'

# Response type produced by helper functions
export type Response = {
    StatusCode : int,
    Body : bytes,
    ContentType : ContentType,
    Headers : Headers
}

# Dynamic headers object — fields are header names, values are header values
export type Headers = {}

# Request type provided by the http streaming source
export type Request = {
    Method : HttpMethod,
    Uri : string,
    Body : bytes,
    ContentType : ContentType
}

# Creates a 200 OK response with JSON body from a string value
export function ok(string) => Response {
    StatusCode = 200,
    Body = string,
    ContentType = 'application/json'
}

# Creates a 200 OK response with JSON body
export function ok(Request, body: string) => Response {
    StatusCode = 200,
    Body = body,
    ContentType = 'application/json'
}

# Creates a 200 OK response with empty body
export function ok(Request) => Response {
    StatusCode = 200,
    Body = '{"status": "ok"}',
    ContentType = 'application/json'
}

# Creates a 404 Not Found response
export function notFound(Request) => {
    StatusCode = 404
    Body = '{"error": "Not Found"}'
    ContentType = 'application/json'
}

# Creates a 201 Created response
export function created(Request) => {
    StatusCode = 201
    Body = Body
    ContentType = 'application/json'
}

# Creates a 400 Bad Request response
export function badRequest(Request) => {
    StatusCode = 400
    Body = '{"error": "Bad Request"}'
    ContentType = 'application/json'
}

# Creates a 500 Internal Server Error response
export function serverError(Request) => {
    StatusCode = 500
    Body = '{"error": "Internal Server Error"}'
    ContentType = 'application/json'
}

# Creates a 500 Internal Server Error response from an Error value
export function serverError(Error) => Response {
    StatusCode = 500,
    Body = Error.Message,
    ContentType = 'application/json'
}
