# Code Metrics Package v1.0
# Computes aggregate code quality metrics from violations and outputs as JSON.
# Import with: import code-metrics
# Run standalone: cop code-metrics -t <dir> -p csharp

import code
import code-analysis
import csharp-checks

## Computes aggregate metrics from violations and lines, outputs as JSON.
## Usage: METRICS(violations, lines) where violations is [Violation] and lines is [Line].
## Output is a JSON object with total counts, severity breakdown, LOC, and per-KLOC rates.
## weightedScore = sum of all violation severities. weightedSlopPerKloc = weightedScore * 1000 / LOC.
export command METRICS(violations, lines) = {
    let total = violations.Count
    let errors = violations:count((v) => v.Severity >= 0.7)
    let warnings = violations:count((v) => v.Severity >= 0.4 && v.Severity < 0.7)
    let info = violations:count((v) => v.Severity < 0.4)
    let loc = lines:count((line) => line.Kind == 'code')
    let weightedScore = violations:sum((v) => v.Severity)
    let slopPerKloc = loc > 0 ? total * 1000 / loc : 0
    let weightedSlopPerKloc = loc > 0 ? weightedScore * 1000 / loc : 0
    print('{')
    print('  "totalViolations": {total},')
    print('  "errors": {errors},')
    print('  "warnings": {warnings},')
    print('  "info": {info},')
    print('  "weightedScore": {weightedScore},')
    print('  "linesOfCode": {loc},')
    print('  "slopPerKloc": {slopPerKloc},')
    print('  "weightedSlopPerKloc": {weightedSlopPerKloc}')
    print('}')
}

# Curated high-confidence slop rules with severity overrides
# These are rules with very low false-positive rates from Roslyn semantic analysis and naming conventions.
# Users can filter this collection or extend it with their own rules.

export let slop =
    empty-catches:withSeverity(0.8) +
    no-banned-throws:withSeverity(0.8) +
    no-public-fields:withSeverity(0.5) +
    interface-prefix:withSeverity(0.5) +
    type-name-casing:withSeverity(0.5) +
    method-name-casing:withSeverity(0.5) +
    exception-suffix:withSeverity(0.5) +
    attribute-suffix:withSeverity(0.5) +
    param-camel-case:withSeverity(0.3)

## Default command: compute slop metrics using ambient Lines from loaded providers.
## Run with: cop code-metrics -t <dir> -p csharp
command main = METRICS(slop, Lines)
