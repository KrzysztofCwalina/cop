# Trivy integration — runs Trivy and produces cop diagnostics
# Prerequisites: Trivy must be installed

import code-analysis

let data = provider('analysis-trivy', nic)

## Returns the Trivy diagnostics collection
export function diagnostics() : [Diagnostic] => data.Diagnostics
export let trivy-checks = data.Diagnostics

command MAIN = foreach trivy-checks => '{item.FilePath}({item.Line}): {item.Severity}: {item.RuleId}: {item.Message}'
