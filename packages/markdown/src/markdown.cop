# Markdown Package — Type definitions for markdown document analysis
# Provides Heading, Link, Section, FenceBlock types and the Markdown aggregate.

import code-analysis

export type Heading = {
    Text : string,
    Level : int,
    Line : int,
    File : File?,
    Source : string
}

export type Link = {
    Url : string,
    Text : string?,
    Line : int,
    File : File?,
    Source : string
}

export type Section = {
    Heading : string,
    Level : int,
    Content : string,
    StartLine : int,
    EndLine : int,
    File : File?,
    Source : string
}

export type FenceBlock = {
    Language : string?,
    Tag : string?,
    StartLine : int,
    EndLine : int,
    Content : string,
    ContentHash : string,
    File : File?,
    Source : string
}

export type MarkdownContent = {
    Headings : [Heading],
    Links : [Link],
    Sections : [Section],
    FenceBlocks : [FenceBlock]
}

# Provides markdown content via the built-in markdown provider

## Parses markdown files in the target directory and returns their structured content.
## Example: let md = markdown.parse()
export function parse() : MarkdownContent => provider('markdown')

## Parses markdown files in the specified directory and returns their structured content.
## Example: let md = markdown.parse('docs/')
export function parse(path : string) : MarkdownContent => provider('markdown', path)

# Violation overloads for markdown types — via TextFilePosition trait conformance
export type FenceBlock : TextFilePosition = { filePath => item.File.Path, line => item.StartLine }
export type Heading : TextFilePosition = { filePath => item.File.Path, line => item.Line }
export type Link : TextFilePosition = { filePath => item.File.Path, line => item.Line }
export type Section : TextFilePosition = { filePath => item.File.Path, line => item.StartLine }
