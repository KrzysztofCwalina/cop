# Markdown Package — Type definitions for markdown document analysis
# Provides Heading, Link, Section, FenceBlock types and the Markdown aggregate.

import code-analysis

export type Heading = {
    Text : string,
    Level : int,
    Line : int,
    File : File?,
    Source : string
}

export type Link = {
    Url : string,
    Text : string?,
    Line : int,
    File : File?,
    Source : string
}

export type Section = {
    Heading : string,
    Level : int,
    Content : string,
    StartLine : int,
    EndLine : int,
    File : File?,
    Source : string
}

export type FenceBlock = {
    Language : string?,
    Tag : string?,
    StartLine : int,
    EndLine : int,
    Content : string,
    ContentHash : string,
    File : File?,
    Source : string
}

export type MarkdownContent = {
    Headings : [Heading],
    Links : [Link],
    Sections : [Section],
    FenceBlocks : [FenceBlock]
}

# Provides markdown content via the built-in markdown provider
let md : MarkdownContent = provider('markdown')

## Returns all headings found in markdown files.
export function headings() : [Heading] => md.Headings

## Returns all links found in markdown files.
export function links() : [Link] => md.Links

## Returns all sections found in markdown files.
export function sections() : [Section] => md.Sections

## Returns all fenced code blocks found in markdown files.
export function fenceBlocks() : [FenceBlock] => md.FenceBlocks

# Violation overloads for markdown types — via TextFilePosition trait conformance
export type FenceBlock : TextFilePosition = { filePath => item.File.Path, line => item.StartLine }
export type Heading : TextFilePosition = { filePath => item.File.Path, line => item.Line }
export type Link : TextFilePosition = { filePath => item.File.Path, line => item.Line }
export type Section : TextFilePosition = { filePath => item.File.Path, line => item.StartLine }
