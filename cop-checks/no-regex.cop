# No regex usage except for implementing the :matches() intrinsic
# Regex-based parsing is not acceptable — use recursive descent parsers.

import code
import code-analysis
import csharp

predicate hasRegex(Line) =>
    Line.Text:contains('Regex') || Line.Text:contains('RegularExpressions')

predicate notMatchesInfra(Line) =>
    Line.File.Path:contains('Filter') == false
    && Line.File.Path:endsWith('RegexCache.cs') == false
    && Line.File.Path:endsWith('StandardLibrary.cs') == false

let allLines : [Line] = csharp.parse().Lines
export let no-regex = allLines:hasRegex:notMatchesInfra
    :toError('Regex usage not allowed (use recursive descent parsers): {item.File.Path}:{item.Number}')
