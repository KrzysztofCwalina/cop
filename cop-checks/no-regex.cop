# No regex usage except for implementing the :matches() intrinsic
# Regex-based parsing is not acceptable — use recursive descent parsers.

import code
import code
import csharp

# A type is in a file that uses regex if the file imports RegularExpressions
predicate inRegexFile(Type) =>
    Type.File.Usings:contains('System.Text.RegularExpressions')

# Exclude types in files that implement the :matches() intrinsic:
#   - RegexCache: the compiled regex cache
#   - FilterCompiler/FilterEvaluator: filter dispatch for :matches()
#   - StandardLibrary: the matches() function and glob expansion
predicate notMatchesInfra(Type) =>
    Type.Name:contains('RegexCache') == false
    && Type.Name:contains('FilterCompiler') == false
    && Type.Name:contains('FilterEvaluator') == false
    && Type.Name:contains('StandardLibrary') == false

let allTypes : [Type] = csharp.parse().Types
export let no-regex = allTypes:inRegexFile:notMatchesInfra
    :toError('{item.Name} is in a file that imports System.Text.RegularExpressions — use recursive descent parsers: {item.File.Path}')
