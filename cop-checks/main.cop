# Run repository self-checks; use -c DERIVED or -c AI for the optional suites.
# Usage: cop cop-checks/main.cop -t .

import code
import csharp
import csharp-checks
import cop

let codebase = codebase(csharp.parse(), cop.parse())

let source-files = codebase.Files.Where(!inTestsOrSamples(item))
let source-files-without-examples = codebase.Files.Where(!inTestsSamplesOrExamples(item))
let non-test-files = codebase.Files.Where(!inTests(item))
let files-without-samples-or-examples = codebase.Files.Where(!inSamplesOrExamples(item))

let source-types-without-examples = codebase.Types
    .Where(item.File.Path:in(source-files-without-examples.Path))

let source-calls = codebase.Calls:isCSharp
    .Where(item.File.Path:in(source-files.Path))
let non-test-calls = codebase.Calls
    .Where(item.File.Path:in(non-test-files.Path))

predicate inTestsOrSamples(File) =>
    File.Path:startsWith('tests/') ||
    File.Path:startsWith('samples/')
predicate inSamplesOrExamples(File) =>
    File.Path:startsWith('samples/') ||
    File.Path:startsWith('examples/')
predicate inTestsSamplesOrExamples(File) =>
    inTestsOrSamples ||
    File.Path:startsWith('examples/')
predicate inTests(File) =>
    File.Path:startsWith('tests/')
predicate inShared(File) =>
    File.Path:contains('cop/shared/')
predicate inRuntime(File) =>
    File.Path:contains('cop/runtime/')
predicate inCore(File) =>
    inShared ||
    inRuntime
predicate inInterpreter(File) =>
    File.Path:contains('cop/shared/interpreter/')
predicate inProviders(File) =>
    File.Path:startsWith('providers/')
predicate importsCliCommandsOrRepl(File) =>
    importsAny(File, ['Cop.Cli.Commands', 'Cop.Repl'])
predicate inChecks(File) =>
    File.Path:contains('cop-checks/')

predicate extendsDataProvider(Type) =>
    derivesFromAny(Type, ['DataProvider'])
predicate hasTestFixture(Type) =>
    hasDecorator(Type, 'TestFixture')
predicate hasExceptionBase(Type) =>
    derivesFromAny(Type, ['Exception'])
predicate hasExceptionSuffix(Type) =>
    Type.Name:endsWith('Exception')

export let default-violations =
    csharp-checks +
    intrinsics-in-wrong-file +
    types-without-namespace +
    no-new-interfaces +
    layering-violations +
    no-aspnet-in-cli +
    no-new-ffi +
    no-regex +
    no-environment

command MAIN = CHECK(default-violations)

# Opt-in AI checks require network access and ~/.cop/ai.json.
export let ai-violations =
    core-purity-violations

command AI = CHECK(ai-violations)

# Repository architecture and conventions.
export let derived-violations =
    # Layering & the general-purpose-core boundary
    derived-language-no-code-model +
    derived-core-domain-purity +
    derived-core-network-isolation +
    derived-core-no-cli-dependency +
    derived-core-no-roslyn +
    derived-commandline-confined-to-cli +
    derived-providers-no-cli-dependency +
    derived-interpreter-no-process-launch +
    derived-no-console-in-pure-core +
    # Provider plugin conventions
    derived-provider-naming +
    derived-provider-namespace +
    derived-provider-sources-under-src +
    derived-provider-isolation +
    # cop-checks authoring conventions
    derived-single-command-in-checks +
    derived-no-foreach-in-checks +
    derived-ai-imports-only-in-ai-checks +
    # CLI conventions
    derived-cli-commands-are-static +
    # C# naming
    derived-exception-naming +
    derived-exception-suffix-implies-base +
    # C# safety
    derived-no-async-void +
    derived-no-datetime-now +
    derived-no-nullable-disable +
    # Project settings
    derived-target-framework +
    derived-nullable-enabled +
    derived-implicit-usings +
    derived-single-target-framework +
    # Test layout
    derived-tests-location +
    derived-test-class-naming +
    derived-test-projects-use-nunit

command DERIVED = CHECK(derived-violations)
