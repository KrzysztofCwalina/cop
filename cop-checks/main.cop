# Cop Self-Checks
# Run all checks: cop cop-checks/main.cop -t .
# Run AI checks:  cop cop-checks/main.cop -t . -c ai

import code
import code-analysis
import csharp
import cop

let codebase = codebase(csharp.parse(), cop.parse())

export let all-violations = 
    intrinsics-in-wrong-file +
    types-without-namespace + 
    no-new-interfaces + 
    layering-violations +
    no-aspnet-in-cli +
    no-new-ffi +
    no-regex

command MAIN = CHECK(all-violations)

# Environment / env-var usage audit. Flags every System.Environment.* usage in .cs
# for review — env vars are discouraged unless absolutely necessary; prefer explicit
# options/flags. Kept as its own command (not in MAIN) so the triage of existing,
# mostly-legitimate framework usages (GetFolderPath, Exit, NewLine, ...) doesn't gate
# CI before review. Run with: cop cop-checks/main.cop -t . -c ENV
command ENV = CHECK(no-environment)

# AI-based checks (require network + ~/.cop/ai.json)
export let all-ai-violations =
    core-purity-violations

command AI = CHECK(all-ai-violations)

# Derived checks — architectural & design rules specific to the cop codebase
# (cop-checks/derived/). Each codifies a decision a newcomer wouldn't know from
# standard .NET tooling. Run with: cop cop-checks/main.cop -t . -c DERIVED
export let all-derived-violations =
    # Layering & the general-purpose-core boundary
    derived-language-no-code-model +
    derived-core-domain-purity +
    derived-core-network-isolation +
    derived-core-no-cli-dependency +
    derived-core-no-roslyn +
    derived-commandline-confined-to-cli +
    derived-providers-no-cli-dependency +
    derived-interpreter-no-process-launch +
    derived-no-console-in-pure-core +
    # Provider plugin conventions
    derived-provider-naming +
    derived-provider-namespace +
    derived-provider-sources-under-src +
    derived-provider-isolation +
    # cop-checks authoring conventions
    derived-single-command-in-checks +
    derived-no-foreach-in-checks +
    derived-ai-imports-only-in-ai-checks +
    # CLI conventions
    derived-cli-commands-are-static +
    # C# naming
    derived-exception-naming +
    derived-exception-suffix-implies-base +
    # C# safety
    derived-no-async-void +
    derived-no-datetime-now +
    derived-no-nullable-disable +
    # Per-project build settings (no central Directory.Build.props exists)
    derived-target-framework +
    derived-nullable-enabled +
    derived-implicit-usings +
    derived-single-target-framework +
    # Test layout
    derived-tests-location +
    derived-test-class-naming +
    derived-test-projects-use-nunit

command DERIVED = CHECK(all-derived-violations)
