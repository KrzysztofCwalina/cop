# Every C# project must enable nullable reference types. There is no central
# Directory.Build.props, so this stops a newly-added project from silently turning it off.

import code-layering

predicate neBadNullable(ProjectProperty) => ProjectProperty.Name:equals('Nullable') && ProjectProperty.Value:notEquals('enable')
predicate neNullableNotEnabled(Project) => Project.Properties:any(neBadNullable)

export let derived-nullable-enabled = codebase.Projects:neNullableNotEnabled
    :toError('Project {item.Name} must set <Nullable>enable</Nullable>')
