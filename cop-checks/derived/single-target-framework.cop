# Projects use a single <TargetFramework>, never multi-targeting (<TargetFrameworks>).
# The repo builds one framework everywhere; multi-targeting would complicate build/publish.

import code-layering

predicate stHasMultiTfm(ProjectProperty) => ProjectProperty.Name:equals('TargetFrameworks')
predicate stIsMultiTargeted(Project) => Project.Properties:any(stHasMultiTfm)

export let derived-single-target-framework = codebase.Projects:stIsMultiTargeted
    :toError('Project {item.Name} uses TargetFrameworks (multi-targeting) — use a single TargetFramework')
