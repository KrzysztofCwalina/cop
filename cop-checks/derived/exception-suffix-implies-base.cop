# Derived rule: a type named *Exception must actually derive from Exception.
# Complements exception-naming (the reverse direction): guards against non-exception
# types accidentally named *Exception. (Excludes tests/samples, which hold intentional
# bad examples.)

predicate esSuffix(Type) => Type.Name:endsWith('Exception')
predicate esNoExceptionBase(Type) => !Type.BaseTypes:contains('Exception')
predicate esNotTest(Type) => !Type.File.Path:startsWith('tests/') && !Type.File.Path:startsWith('samples/')

export let derived-exception-suffix-implies-base = codebase.Types:esSuffix:esNoExceptionBase:esNotTest
    :toError('{item.Name} is named *Exception but does not derive from Exception ({item.File.Path})')
