# Package-authoring self-checks.
# These inspect cop PACKAGE source (.cop files), which the root suite excludes
# (packages/ is an excluded directory), so this sub-suite is run against packages:
#
#   cop cop-checks/packages/main.cop -t packages
#
# It only parses .cop source (cop.parse()); no language provider / -p flag needed.

import code
import code
import cop

let codebase = codebase(cop.parse())

export let all-package-violations =
    lang-provider-hardcoded-violations

command MAIN = CHECK(all-package-violations)
