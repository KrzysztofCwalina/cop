# Environment variables must not control cop's behavior — use CLI flags or config instead.
# The ONLY acceptable use of an environment variable is reading a SECRET (e.g. GITHUB_TOKEN)
# that must not be passed on a command line (it would leak into process listings / shell history).
#
# This flags every Environment.GetEnvironmentVariable / SetEnvironmentVariable call whose line
# does not reference a secret (TOKEN/SECRET/PASSWORD). Detection is line-based because env-var
# calls nested inside expressions have no Statement/Call node in the code model.

predicate envIsCSharp(Line) => Line.File.Path:endsWith('.cs')
predicate envNotTest(Line) => !Line.File.Path:startsWith('tests/') && !Line.File.Path:startsWith('samples/')
predicate readsEnvVar(Line) => Line.Text:contains('GetEnvironmentVariable') || Line.Text:contains('SetEnvironmentVariable')
predicate notSecret(Line) => !Line.Text:contains('TOKEN') && !Line.Text:contains('SECRET') && !Line.Text:contains('PASSWORD')

export let no-environment = codebase.Lines:readsEnvVar:envIsCSharp:envNotTest:notSecret
    :toError('Environment variable used to control behavior — use a CLI flag or config instead ({item.File.Path}:{item.Number})')
