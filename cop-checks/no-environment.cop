# Flag every use of System.Environment.* for review.
#
# Environment access is hidden, machine-global, side-effecting state. Environment-variable
# configuration in particular is discouraged in this codebase — behavior should be driven by
# explicit options/flags, not by env vars a caller can't discover. Every Environment.* usage
# must be deliberately reviewed and justified (or removed).
#
# Detection is line-based on purpose: property accesses (e.g. Environment.ProcessorCount) and
# calls nested inside arguments (e.g. if (...Environment.GetEnvironmentVariable("CI"))) have no
# Statement/Call node in the code model, so the semantic model cannot see every usage. The \b
# word boundary matches `Environment.` and `System.Environment.` while excluding unrelated
# members such as GlobalEnvironment.* and RuntimeEnvironment.*.

predicate envIsCSharp(Line) => Line.File.Path:endsWith('.cs')
predicate envNotTest(Line) => !Line.File.Path:startsWith('tests/') && !Line.File.Path:startsWith('samples/')
predicate usesEnvironment(Line) => Line.Text:matches('.*\bEnvironment\..*')

export let no-environment = codebase.Lines:usesEnvironment:envIsCSharp:envNotTest
    :toWarning('System.Environment usage must be reviewed/justified — prefer explicit options over env vars ({item.File.Path}:{item.Number})')
