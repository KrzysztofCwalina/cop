# Keep the CLI free of ASP.NET framework references so cop.exe can ship as a single file.

predicate isCopCliProject(Project) => Project.Path:contains('cop/cli')
predicate referencesAspNet(Project) => Project.Frameworks:contains('Microsoft.AspNetCore.App')

let aspnet-message = 'Project {item.Name} has FrameworkReference to Microsoft.AspNetCore.App which breaks single-file publish'

export let no-aspnet-in-cli = codebase.Projects:isCopCliProject:referencesAspNet
    :toError(aspnet-message)
