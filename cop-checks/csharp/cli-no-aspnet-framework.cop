# Keep the CLI free of ASP.NET framework references so cop.exe can ship as a single file.

let cli-projects : [Project] = codebase.Projects.Where(item.Path:contains('cop/cli'))

export let no-aspnet-in-cli = cli-projects
    .Where(hasFramework(item, 'Microsoft.AspNetCore.App'))
    :toError('Project {item.Name}: remove Microsoft.AspNetCore.App for single-file publishing')