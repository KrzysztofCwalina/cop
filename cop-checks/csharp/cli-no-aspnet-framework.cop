# Keep the CLI free of ASP.NET framework references so cop.exe can ship as a single file.

predicate isCopCliProject(Project) =>
    Project.Path:contains('cop/cli')
let aspnet-message =
    'Project {item.Name}: remove Microsoft.AspNetCore.App for single-file publishing'

export let no-aspnet-in-cli = checkRule(
    'cop-checks/no-aspnet-in-cli',
    codebase.Projects:isCopCliProject
    .Where(hasFramework(item, 'Microsoft.AspNetCore.App'))
    :toError(aspnet-message))
