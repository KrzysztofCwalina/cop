# Keep the runtime FFI small; implement domain-specific capabilities in .cop packages.
# Test-only registrations do not expand the shipped API.

import code

let approved-ffi-names = [
    'print', 'debug', 'save', 'assert', 'fail', 'error', 'read',
    'pathMatches', 'provider', 'distinct', 'take', 'skip', 'first',
    'last', 'text', 'concat', 'push', 'enqueue', 'pop', 'elementAt',
    'empty', 'startsWith', 'endsWith', 'contains', 'equals', 'notEquals',
    'matches', 'length', 'isSet', 'isClear', 'Get', 'containsKey'
]

predicate isFfiRegistration(Statement) =>
    Statement.Kind == call &&
    Statement.MemberName:equals('Register') &&
    hasIdentifierReceiverIgnoringCase(Statement, 'ffi')

export let no-new-ffi = codebase.Calls
    .Where(
        !inFolders(item.File, ['tests/']) &&
        isFfiRegistration(item) &&
        !hasStringArgumentIn(item, 0, approved-ffi-names))
    :toError('Unapproved runtime function; use a .cop package or get explicit approval')
