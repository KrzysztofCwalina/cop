# Keep the runtime FFI small; implement domain-specific capabilities in .cop packages.

import code

let approved-ffi-names = [
    'print', 'debug', 'save', 'assert', 'fail', 'error', 'read',
    'pathMatches', 'provider', 'distinct', 'take', 'skip', 'first',
    'last', 'text', 'concat', 'push', 'enqueue', 'pop', 'elementAt',
    'empty', 'startsWith', 'endsWith', 'contains', 'equals', 'notEquals',
    'matches', 'length', 'isSet', 'isClear', 'Get', 'containsKey'
]

predicate hasFfiReceiver(Statement) => Statement.CallTarget.Kind == memberAccess
    && Statement.CallTarget.Target.Kind == identifier
    && Statement.CallTarget.Target.Name:equals('ffi')

predicate isFfiRegistration(Statement) =>
    Statement.Kind == call
    && Statement.MemberName:equals('Register')
    && hasFfiReceiver

predicate hasApprovedFfiName(Statement) => Statement.ArgumentExpressions.Count > 0
    && Statement.ArgumentExpressions[0].Kind == stringLiteral
    && Statement.ArgumentExpressions[0].StringValue:in(approved-ffi-names)

# The invocation test registers 'double' to exercise a foreign call.
predicate inFfiInvocationTest(Statement) =>
    Statement.File.Path == 'tests/lang.tests/lang/EvaluatorTests.cs'
    && Statement.Method.Name == 'EvalForeignFunction'

predicate hasDoubleName(Statement) => Statement.ArgumentExpressions.Count > 0
    && Statement.ArgumentExpressions[0].Kind == stringLiteral
    && Statement.ArgumentExpressions[0].StringValue == 'double'

predicate hasFfiTestExemption(Statement) => inFfiInvocationTest && hasDoubleName

predicate isUnapprovedRegistration(Statement) =>
    isFfiRegistration && !hasApprovedFfiName && !hasFfiTestExemption

let ffi-message = 'New runtime FFI registered without approval. The FFI surface must not grow — implement the capability as a .cop package, or get sign-off and add its name to approved-ffi-names.'

export let no-new-ffi = codebase.Calls:isUnapprovedRegistration
    :toError(ffi-message)
