# Require types with a DataProvider base to be named *Provider.
# Load-bearing — DataProvider.ToString() derives the provider's display name by
# stripping the 'Provider' suffix, so a misnamed subclass breaks provider naming.

predicate derivesFromDataProvider(Type) => Type.BaseTypes:contains('DataProvider')
predicate lacksProviderSuffix(Type) => !Type.Name:endsWith('Provider')

export let derived-provider-naming = codebase.Types:derivesFromDataProvider:lacksProviderSuffix
    :toError('{item.Name} extends DataProvider but is not named *Provider ({item.File.Path})')
