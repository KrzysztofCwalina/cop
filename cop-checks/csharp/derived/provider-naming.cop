# Name DataProvider subclasses *Provider; their display names omit the suffix.

predicate lacksProviderSuffix(Type) =>
    !Type.Name:endsWith('Provider')

let provider-name-message =
    '{item.Name} extends DataProvider but is not named *Provider ({item.File.Path})'

export let derived-provider-naming = checkRule(
    'cop-checks/derived-provider-naming',
    codebase.Types
    :extendsDataProvider:lacksProviderSuffix
    :toError(provider-name-message))
