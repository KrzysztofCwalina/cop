# Flag Roslyn imports in cop/shared/ and cop/runtime/.
# C# semantic analysis belongs in csharp-provider, not the language core.

predicate isInRoslynFreeCore(Type) =>
    Type.File.Path:contains('cop/shared/')
    || Type.File.Path:contains('cop/runtime/')
predicate importsRoslynNamespace(Type) =>
    Type.File.Usings:contains('Microsoft.CodeAnalysis')
    || Type.File.Usings:contains('Microsoft.CodeAnalysis.CSharp')

export let derived-core-no-roslyn = codebase.Types:isInRoslynFreeCore:importsRoslynNamespace
    :toError('Core type {item.Name} depends on Roslyn — move C# analysis to csharp-provider ({item.File.Path})')
