# Keep Roslyn in csharp-provider so the language and runtime stay language-independent.

predicate importsRoslyn(File) =>
    File.Usings:contains('Microsoft.CodeAnalysis')
    || File.Usings:contains('Microsoft.CodeAnalysis.CSharp')

let core-roslyn-message = 'Core type {item.Name} depends on Roslyn — move C# analysis to csharp-provider ({item.File.Path})'

export let derived-core-no-roslyn = codebase.Types
    .Where(inCore(item.File) && importsRoslyn(item.File))
    :toError(core-roslyn-message)
