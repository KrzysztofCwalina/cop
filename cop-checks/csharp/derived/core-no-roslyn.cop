# Keep Roslyn in csharp-provider so the language and runtime stay language-independent.

let roslyn-namespaces = ['Microsoft.CodeAnalysis', 'Microsoft.CodeAnalysis.CSharp']

let core-roslyn-message =
    '{item.Name}: C# analysis belongs in csharp-provider, not the core'

export let derived-core-no-roslyn = codebase.Types
    .Where(
        inCore(item.File) &&
        importsAny(item.File, roslyn-namespaces))
    :toError(core-roslyn-message)
