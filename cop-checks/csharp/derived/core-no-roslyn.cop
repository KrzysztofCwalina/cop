# Keep Roslyn in csharp-provider so the language and runtime stay language-independent.

export let derived-core-no-roslyn = codebase.Types
    .Where(
        (item.File.Path:contains('cop/shared/') || item.File.Path:contains('cop/runtime/')) &&
        importsAny(item.File, ['Microsoft.CodeAnalysis', 'Microsoft.CodeAnalysis.CSharp']))
    :toError('{item.Name}: C# analysis belongs in csharp-provider, not the core')
