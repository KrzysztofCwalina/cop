# Keep the language and runtime host-independent: no CLI command or REPL imports.

let core-cli-message =
    '{item.Name}: remove CLI/REPL dependencies; keep the core host-independent'

export let derived-core-no-cli-dependency = checkRule(
    'cop-checks/derived-core-no-cli-dependency',
    codebase.Types
    .Where(
        inCore(item.File) &&
        importsCliCommandsOrRepl(item.File))
    :toError(core-cli-message))
