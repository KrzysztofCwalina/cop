# Keep the language and runtime host-independent: no CLI command or REPL imports.

let core-cli-message = '{item.Name} (in cop/shared or cop/runtime) depends on the CLI (Cop.Cli/Cop.Repl) — the language/runtime must stay host-agnostic ({item.File.Path})'

export let derived-core-no-cli-dependency = codebase.Types
    .Where(inCore(item.File) && importsCliCommandsOrRepl(item.File))
    :toError(core-cli-message)
