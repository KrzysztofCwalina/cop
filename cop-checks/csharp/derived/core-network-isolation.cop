# Keep networking imports out of the interpreter and runtime; providers handle network I/O.

predicate importsNetworking(File) =>
    File.Usings:contains('System.Net')
    || File.Usings:contains('System.Net.Http')
    || File.Usings:contains('System.Net.Sockets')

let core-network-message = '{item.Name} performs network I/O in the language core — move network access to a provider ({item.File.Path})'

export let derived-core-network-isolation = codebase.Types
    .Where((inInterpreter(item.File) || inRuntime(item.File)) && importsNetworking(item.File))
    :toError(core-network-message)
