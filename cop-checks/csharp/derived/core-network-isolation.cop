# Keep networking imports out of the interpreter and runtime.
# Providers handle network I/O.

let network-namespaces = ['System.Net', 'System.Net.Http', 'System.Net.Sockets']
let network-isolated-paths = ['cop/shared/interpreter/', 'cop/runtime/']

let interpreter-and-runtime-types : [Type] = codebase.Types
    .Where(item.File.Path:containsAny(network-isolated-paths))

export let derived-core-network-isolation = interpreter-and-runtime-types
    .Where(importsAny(item.File, network-namespaces))
    :toError('{item.Name}: networking belongs in providers, not the language core')