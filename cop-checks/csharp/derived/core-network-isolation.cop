# Keep networking imports out of the interpreter and runtime.
# Providers handle network I/O.

let networking-namespaces = ['System.Net', 'System.Net.Http', 'System.Net.Sockets']

let core-network-message =
    '{item.Name}: networking belongs in providers, not the language core'

export let derived-core-network-isolation = checkRule(
    'cop-checks/derived-core-network-isolation',
    codebase.Types
    .Where(
        (
            inInterpreter(item.File) ||
            inRuntime(item.File)
        ) &&
        importsAny(item.File, networking-namespaces))
    :toError(core-network-message))
