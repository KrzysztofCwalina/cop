# Report types containing an async void method; use async Task instead.
# `async void` swallows exceptions and makes failures unobservable in the async runtime —
# use `async Task` instead. (Event handlers, the only legitimate exception, are not used here.)

predicate isAsyncVoidMethod(Method) =>
    Method.Modifiers:isSet(Async) && Method.ReturnType.Name:equals('void')
predicate hasAsyncVoidMethod(Type) => Type.Methods:any(isAsyncVoidMethod)

export let derived-no-async-void = codebase.Types:hasAsyncVoidMethod
    :toError('{item.Name} declares an async void method — use async Task ({item.File.Path})')
