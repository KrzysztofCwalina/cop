# Use async Task instead of async void so callers can await completion and observe failures.

predicate isAsyncVoid(Method) =>
    Method.Modifiers:isSet(Async) && Method.ReturnType.Name:equals('void')
predicate hasAsyncVoid(Type) => Type.Methods:any(isAsyncVoid)

let async-void-message = '{item.Name} declares an async void method — use async Task ({item.File.Path})'

export let derived-no-async-void = codebase.Types:hasAsyncVoid
    :toError(async-void-message)
