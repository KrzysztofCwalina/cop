# Require types named *Command in cop/cli/commands/ to be static.
# They hold no instance state — every command is a static entry point.

predicate isInCliCommandsFolder(Type) => Type.File.Path:contains('cop/cli/commands/')
predicate hasCommandSuffix(Type) => Type.Name:endsWith('Command')
predicate lacksStaticModifier(Type) => !Type.Modifiers:isSet(Static)

export let derived-cli-commands-are-static = codebase.Types
    :isInCliCommandsFolder:hasCommandSuffix:lacksStaticModifier
    :toError('CLI command {item.Name} must be a static class ({item.File.Path})')
