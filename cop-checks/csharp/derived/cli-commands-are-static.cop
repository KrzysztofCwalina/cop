# CLI commands are entry points, not objects; their classes must be static.

let cli-types : [Type] = codebase.Types.Where(item.File.Path:contains('cop/cli/commands/'))
let cli-command-types : [Type] = cli-types.Where(item.Name:endsWith('Command'))

export let derived-cli-commands-are-static = cli-command-types
    .Where(!item.Modifiers:isSet(Static))
    :toError('CLI command {item.Name} must be a static class ({item.File.Path})')