# CLI commands are entry points, not objects; their classes must be static.

export let derived-cli-commands-are-static = codebase.Types
    .Where(
        item.File.Path:contains('cop/cli/commands/') &&
        item.Name:endsWith('Command') &&
        !item.Modifiers:isSet(Static))
    :toError('CLI command {item.Name} must be a static class ({item.File.Path})')
