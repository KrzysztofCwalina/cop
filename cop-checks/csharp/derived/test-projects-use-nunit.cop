# Projects under tests/ must reference the NUnit package — the repo's single test framework.

import code

predicate isInTestProjectsFolder(Project) => Project.Path:startsWith('tests/')
predicate isNUnitPackageName(string) => string:equals('NUnit')
predicate referencesNUnitPackage(Project) => Project.Packages:any(isNUnitPackageName)
predicate lacksNUnitPackage(Project) => !referencesNUnitPackage

export let derived-test-projects-use-nunit = codebase.Projects:isInTestProjectsFolder:lacksNUnitPackage
    :toError('Test project {item.Name} must reference NUnit')
