# Use NUnit consistently across projects under tests/.

import code

predicate inTests(Project) => Project.Path:startsWith('tests/')
predicate isNUnit(string) => string:equals('NUnit')
predicate referencesNUnit(Project) => Project.Packages:any(isNUnit)
predicate lacksNUnit(Project) => !referencesNUnit

let test-framework-message = 'Test project {item.Name} must reference NUnit'

export let derived-test-projects-use-nunit = codebase.Projects:inTests:lacksNUnit
    :toError(test-framework-message)
