# Use NUnit consistently across projects under tests/.

import code

predicate inTests(Project) =>
    Project.Path:startsWith('tests/')
let test-framework-message =
    'Test project {item.Name} must reference NUnit'

export let derived-test-projects-use-nunit = checkRule(
    'cop-checks/derived-test-projects-use-nunit',
    codebase.Projects:inTests
    .Where(!hasPackage(item, 'NUnit'))
    :toError(test-framework-message))
