# Keep process execution in providers; the interpreter must not reference Process.

predicate referencesProcess(Statement) =>
    Statement.TypeName:equals('Process')

let process-launch-message =
    'The interpreter must not launch processes; use a provider'

export let derived-interpreter-no-process-launch = checkRule(
    'cop-checks/derived-interpreter-no-process-launch',
    codebase.Statements:referencesProcess
    .Where(inInterpreter(item.File))
    :toError(process-launch-message))
