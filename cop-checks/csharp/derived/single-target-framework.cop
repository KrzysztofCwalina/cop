# Use TargetFramework, not TargetFrameworks, for single-target builds and publishing.

import code

let multi-targeting-message =
    'Project {item.Name}: use TargetFramework, not TargetFrameworks'

export let derived-single-target-framework = checkRule(
    'cop-checks/derived-single-target-framework',
    codebase.Projects
    .Where(hasProjectProperty(item, 'TargetFrameworks'))
    :toError(multi-targeting-message))
