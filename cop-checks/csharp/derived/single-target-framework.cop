# Use TargetFramework, not TargetFrameworks, to keep builds and publishing single-targeted.

import code

predicate isTargetFrameworks(ProjectProperty) => ProjectProperty.Name:equals('TargetFrameworks')
predicate declaresTargetFrameworks(Project) => Project.Properties:any(isTargetFrameworks)

let multi-targeting-message = 'Project {item.Name} uses TargetFrameworks (multi-targeting) — use a single TargetFramework'

export let derived-single-target-framework = codebase.Projects:declaresTargetFrameworks
    :toError(multi-targeting-message)
