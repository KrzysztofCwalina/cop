# Reserve the Exception suffix for types derived from Exception.

let exception-base-message = '{item.Name} is named *Exception but does not derive from Exception ({item.File.Path})'

export let derived-exception-suffix-implies-base = codebase.Types:hasExceptionSuffix
    .Where(!hasExceptionBase(item) && !inTestsOrSamples(item.File))
    :toError(exception-base-message)
