# Require types named *Exception to have an Exception base, except tests/ and samples/.
# Complements exception-naming (the reverse direction): guards against non-exception
# types accidentally named *Exception. (Excludes tests/samples, which hold intentional
# bad examples.)

predicate hasExceptionSuffix(Type) => Type.Name:endsWith('Exception')
predicate lacksExceptionBase(Type) => !Type.BaseTypes:contains('Exception')
predicate isOutsideExceptionBaseFixtures(Type) =>
    !Type.File.Path:startsWith('tests/')
    && !Type.File.Path:startsWith('samples/')

export let derived-exception-suffix-implies-base = codebase.Types
    :hasExceptionSuffix:lacksExceptionBase:isOutsideExceptionBaseFixtures
    :toError('{item.Name} is named *Exception but does not derive from Exception ({item.File.Path})')
