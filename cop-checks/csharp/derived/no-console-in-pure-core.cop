# Route core output through the output abstraction, not Console.

predicate inPureCore(File) =>
    File.Path:contains('cop/shared/interpreter/') ||
    File.Path:contains('cop/shared/ast/') ||
    File.Path:contains('cop/shared/parser/') ||
    File.Path:contains('cop/shared/tokenizer/') ||
    File.Path:contains('cop/runtime/')

let pure-core-statements : [Statement] = codebase.Statements.Where(inPureCore(item.File))

export let derived-no-console-in-pure-core = pure-core-statements
    .Where(item.TypeName:equals('Console'))
    :toError('{item.TypeName}.{item.MemberName}: use the core output abstraction, not Console')