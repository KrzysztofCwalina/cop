# Route core output through the output abstraction, not Console.

predicate inSyntax(File) =>
    File.Path:contains('cop/shared/ast/')
    || File.Path:contains('cop/shared/parser/')
    || File.Path:contains('cop/shared/tokenizer/')
predicate referencesConsole(Statement) => Statement.TypeName:equals('Console')

let console-message = '{item.TypeName}.{item.MemberName} writes to the console in the pure core — use the output abstraction ({item.File.Path}:{item.Line})'

export let derived-no-console-in-pure-core = codebase.Statements:referencesConsole
    .Where(inInterpreter(item.File) || inSyntax(item.File) || inRuntime(item.File))
    :toError(console-message)
