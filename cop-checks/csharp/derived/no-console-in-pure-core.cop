# Flag Console references in the interpreter, AST, parser, tokenizer, and runtime.
# Output goes through the output abstraction (cop/shared/output/*). Diagnostics and sinks
# (DiagnosticFormatter, DataSink) and the CLI are the sanctioned console boundaries.

predicate isInConsoleFreeCore(Statement) =>
    Statement.File.Path:contains('cop/shared/interpreter/')
    || Statement.File.Path:contains('cop/shared/ast/')
    || Statement.File.Path:contains('cop/shared/parser/')
    || Statement.File.Path:contains('cop/shared/tokenizer/')
    || Statement.File.Path:contains('cop/runtime/')
predicate referencesConsoleType(Statement) => Statement.TypeName:equals('Console')

export let derived-no-console-in-pure-core = codebase.Statements:isInConsoleFreeCore:referencesConsoleType
    :toError('{item.TypeName}.{item.MemberName} writes to the console in the pure core — use the output abstraction ({item.File.Path}:{item.Line})')
