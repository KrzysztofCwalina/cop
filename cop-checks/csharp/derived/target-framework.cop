# Target net10.0 consistently across projects.

import code

predicate isUnsupportedFramework(ProjectProperty) =>
    ProjectProperty.Name:equals('TargetFramework')
    && ProjectProperty.Value:notEquals('net10.0')
predicate hasUnsupportedFramework(Project) => Project.Properties:any(isUnsupportedFramework)

let target-framework-message = 'Project {item.Name} must target net10.0'

export let derived-target-framework = codebase.Projects:hasUnsupportedFramework
    :toError(target-framework-message)
