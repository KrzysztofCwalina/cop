# Reject nonblank TargetFramework values other than net10.0.
# Empty/missing settings and TargetFrameworks are not detected by this rule.

import code

predicate isUnexpectedTargetFrameworkSetting(ProjectProperty) =>
    ProjectProperty.Name:equals('TargetFramework')
    && ProjectProperty.Value:notEquals('net10.0')
predicate hasUnexpectedTargetFramework(Project) => Project.Properties:any(isUnexpectedTargetFrameworkSetting)

export let derived-target-framework = codebase.Projects:hasUnexpectedTargetFramework
    :toError('Project {item.Name} must target net10.0')
