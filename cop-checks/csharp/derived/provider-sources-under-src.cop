# Keep provider sources in src/ directories, as expected by the build and packaging.

let provider-folder-types : [Type] = codebase.Types.Where(item.File.Path:startsWith('providers/'))

export let derived-provider-sources-under-src = provider-folder-types
    .Where(!item.File.Path:contains('/src/'))
    :toError('{item.Name} is a provider source outside a src/ folder ({item.File.Path})')