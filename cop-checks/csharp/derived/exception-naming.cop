# Give Exception-derived types an Exception suffix so their purpose is clear.

let exception-base-types = ['Exception']

let exception-types : [Type] = source-code.Types
    .Where(derivesFromAny(item, exception-base-types))

export let derived-exception-naming = exception-types
    .Where(!item.Name:endsWith('Exception'))
    :toError('{item.Name} derives from Exception but is not named *Exception ({item.File.Path})')