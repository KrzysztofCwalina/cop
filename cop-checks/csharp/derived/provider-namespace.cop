# Require DataProvider subclasses to use a namespace starting with Cop.Providers.
# Known exception: the TypeSpec providers declare namespace 'TypeSpecProvider' (allowlisted here,
# the way no-interfaces allowlists ICopCallable). Sample/example providers under samples/ and
# examples/ are excluded (they intentionally demonstrate external custom namespaces).

let namespace-exempt-providers = ['TypeSpecHttpProvider' 'TypeSpecRawProvider']

predicate isDataProviderSubclass(Type) => Type.BaseTypes:contains('DataProvider')
predicate lacksProviderNamespacePrefix(Type) => !Type.File.Namespace:startsWith('Cop.Providers')
predicate isOutsideProviderNamespaceExamples(Type) =>
    !Type.File.Path:startsWith('samples/')
    && !Type.File.Path:startsWith('examples/')
predicate isNotNamespaceExemptProvider(Type) => !Type.Name:in(namespace-exempt-providers)

export let derived-provider-namespace = codebase.Types
    :isDataProviderSubclass:lacksProviderNamespacePrefix
    :isOutsideProviderNamespaceExamples:isNotNamespaceExemptProvider
    :toError('Provider {item.Name} must live in the Cop.Providers namespace, not {item.File.Namespace} ({item.File.Path})')
