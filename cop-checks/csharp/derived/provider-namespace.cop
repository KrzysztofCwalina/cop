# Give DataProvider subclasses namespaces starting with Cop.Providers.

export let derived-provider-namespace = codebase.Types
    .Where(
        !inFolders(item.File, ['samples/', 'examples/']) &&
        derivesFromAny(item, ['DataProvider']) &&
        !item.File.Namespace:startsWith('Cop.Providers') &&
        !item.Name:in(['TypeSpecHttpProvider', 'TypeSpecRawProvider']))
    :toError('{item.Name}: namespace must start with Cop.Providers, not {item.File.Namespace}')
