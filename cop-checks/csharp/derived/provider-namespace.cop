# Give DataProvider subclasses namespaces starting with Cop.Providers.

let exempt-provider-names = ['TypeSpecHttpProvider' 'TypeSpecRawProvider']

predicate hasProviderNamespacePrefix(File) => File.Namespace:startsWith('Cop.Providers')
predicate hasExemptProviderName(Type) => Type.Name:in(exempt-provider-names)

let provider-namespace-message = 'Provider {item.Name} must live in the Cop.Providers namespace, not {item.File.Namespace} ({item.File.Path})'

export let derived-provider-namespace = codebase.Types:extendsDataProvider
    .Where(!hasProviderNamespacePrefix(item.File)
        && !inSamplesOrExamples(item.File)
        && !hasExemptProviderName(item))
    :toError(provider-namespace-message)
