# Give DataProvider subclasses namespaces starting with Cop.Providers.

let exempt-provider-names = ['TypeSpecHttpProvider' 'TypeSpecRawProvider']

predicate hasProviderNamespacePrefix(File) =>
    File.Namespace:startsWith('Cop.Providers')
predicate hasExemptProviderName(Type) =>
    Type.Name:in(exempt-provider-names)

let provider-namespace-message =
    '{item.Name}: namespace must start with Cop.Providers, not {item.File.Namespace}'

export let derived-provider-namespace = codebase.Types:extendsDataProvider
    .Where(item.File.Path:in(file-paths-without-samples-or-examples))
    .Where(
        !hasProviderNamespacePrefix(item.File) &&
        !hasExemptProviderName(item))
    :toError(provider-namespace-message)
