# Give DataProvider subclasses namespaces starting with Cop.Providers.

# The TypeSpec providers keep their own namespace.
let providers-outside-namespace = ['TypeSpecHttpProvider', 'TypeSpecRawProvider']

let shipped-provider-types : [Type] = codebase.Types
    .Where(derivesFromAny(item, ['DataProvider']))
    .Where(!inFolders(item.File, ['samples/', 'examples/']))
let checked-provider-types : [Type] = shipped-provider-types
    .Where(!item.Name:in(providers-outside-namespace))

export let derived-provider-namespace = checked-provider-types
    .Where(!item.File.Namespace:startsWith('Cop.Providers'))
    :toError('{item.Name}: namespace must start with Cop.Providers, not {item.File.Namespace}')