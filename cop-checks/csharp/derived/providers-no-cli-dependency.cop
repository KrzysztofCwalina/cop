# Flag Cop.Cli.Commands and Cop.Repl imports in files under providers/.
# Providers supply data to the runtime; they must not reach into the command layer.

predicate isInHostAgnosticProviders(Type) => Type.File.Path:startsWith('providers/')
predicate providerImportsCliNamespace(Type) =>
    Type.File.Usings:contains('Cop.Cli.Commands')
    || Type.File.Usings:contains('Cop.Repl')

export let derived-providers-no-cli-dependency = codebase.Types:isInHostAgnosticProviders:providerImportsCliNamespace
    :toError('Provider type {item.Name} depends on the CLI (Cop.Cli/Cop.Repl) ({item.File.Path})')
