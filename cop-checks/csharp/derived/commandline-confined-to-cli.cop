# Flag System.CommandLine imports outside cop/cli/, including test code.
# The parsing/argument layer must not leak into the language, runtime, or providers.

predicate isOutsideCliFolder(Type) => !Type.File.Path:contains('cop/cli/')
predicate importsSystemCommandLine(Type) => Type.File.Usings:contains('System.CommandLine')

export let derived-commandline-confined-to-cli = codebase.Types:isOutsideCliFolder:importsSystemCommandLine
    :toError('{item.Name} uses System.CommandLine outside cop/cli ({item.File.Path})')
