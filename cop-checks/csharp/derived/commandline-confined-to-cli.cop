# Keep argument parsing in the CLI; other layers must not import System.CommandLine.

let commandline-namespaces = ['System.CommandLine']

let non-cli-types : [Type] = codebase.Types.Where(!item.File.Path:contains('cop/cli/'))

export let derived-commandline-confined-to-cli = non-cli-types
    .Where(importsAny(item.File, commandline-namespaces))
    :toError('{item.Name} uses System.CommandLine outside cop/cli ({item.File.Path})')