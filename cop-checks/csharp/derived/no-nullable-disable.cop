# Reject active C# #nullable disable directives, including warnings/annotations variants.
# Uses active Roslyn directives and their parsed keywords, not comments or string literals.

predicate isCSharpSourceStatement(Statement) => Statement.File.Language == csharp
predicate isNullableDisableDirective(Statement) =>
    Statement.Kind == directive
    && Statement.Keywords:contains('nullable')
    && Statement.Keywords:contains('disable')

export let derived-no-nullable-disable = codebase.Statements:isCSharpSourceStatement:isNullableDisableDirective
    :toError('Do not disable nullable reference types ({item.File.Path}:{item.Line})')
