# Require types with a TestFixture decorator to live under tests/.
# A fixture elsewhere won't be compiled or run by the test projects.

predicate isTestFixtureType(Type) => Type.Decorators:contains('TestFixture')
predicate isOutsideTestFixturesFolder(Type) => !Type.File.Path:startsWith('tests/')

export let derived-tests-location = codebase.Types:isTestFixtureType:isOutsideTestFixturesFolder
    :toError('Test fixture {item.Name} must live under tests/ ({item.File.Path})')
