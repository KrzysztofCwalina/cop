# Keep the language independent of code-analysis types; use generic provider data instead.

export let derived-language-no-code-model = codebase.Types
    .Where(
        item.File.Path:contains('cop/shared/') &&
        importsAny(item.File, ['Cop.Providers.SourceModel']))
    :toError('{item.Name}: remove Cop.Providers.SourceModel; keep the language general-purpose')
