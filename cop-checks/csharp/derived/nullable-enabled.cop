# Enable nullable reference types to catch null mistakes at compile time.

import code

predicate isInvalidNullable(ProjectProperty) =>
    ProjectProperty.Name:equals('Nullable')
    && ProjectProperty.Value:notEquals('enable')
predicate hasInvalidNullable(Project) => Project.Properties:any(isInvalidNullable)

let nullable-setting-message = 'Project {item.Name} must set <Nullable>enable</Nullable>'

export let derived-nullable-enabled = codebase.Projects:hasInvalidNullable
    :toError(nullable-setting-message)
