# Reject nonblank Nullable settings other than enable.
# Empty and missing settings are not detected; this inspects parsed project properties.

import code

predicate isNonEnabledNullableSetting(ProjectProperty) =>
    ProjectProperty.Name:equals('Nullable')
    && ProjectProperty.Value:notEquals('enable')
predicate hasNonEnabledNullableSetting(Project) => Project.Properties:any(isNonEnabledNullableSetting)

export let derived-nullable-enabled = codebase.Projects:hasNonEnabledNullableSetting
    :toError('Project {item.Name} must set <Nullable>enable</Nullable>')
