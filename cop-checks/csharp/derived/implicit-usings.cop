# Enable implicit usings to keep common namespace imports consistent across projects.

import code

let implicit-usings-message =
    'Project {item.Name} must set <ImplicitUsings>enable</ImplicitUsings>'

export let derived-implicit-usings = codebase.Projects
    .Where(hasOtherProjectPropertyValue(item, 'ImplicitUsings', 'enable'))
    :toError(implicit-usings-message)
