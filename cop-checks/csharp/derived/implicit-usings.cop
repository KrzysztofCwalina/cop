# Reject nonblank ImplicitUsings settings other than enable.
# Empty and missing settings are not detected; this inspects parsed project properties.

import code

predicate isNonEnabledImplicitUsingsSetting(ProjectProperty) =>
    ProjectProperty.Name:equals('ImplicitUsings')
    && ProjectProperty.Value:notEquals('enable')
predicate hasNonEnabledImplicitUsings(Project) => Project.Properties:any(isNonEnabledImplicitUsingsSetting)

export let derived-implicit-usings = codebase.Projects:hasNonEnabledImplicitUsings
    :toError('Project {item.Name} must set <ImplicitUsings>enable</ImplicitUsings>')
