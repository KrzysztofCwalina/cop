# Enable implicit usings to keep common namespace imports consistent across projects.

import code

predicate isInvalidImplicitUsings(ProjectProperty) =>
    ProjectProperty.Name:equals('ImplicitUsings')
    && ProjectProperty.Value:notEquals('enable')
predicate hasInvalidImplicitUsings(Project) => Project.Properties:any(isInvalidImplicitUsings)

let implicit-usings-message = 'Project {item.Name} must set <ImplicitUsings>enable</ImplicitUsings>'

export let derived-implicit-usings = codebase.Projects:hasInvalidImplicitUsings
    :toError(implicit-usings-message)
