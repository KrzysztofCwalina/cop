# Flag analysis-related type names in the core; code-analysis logic belongs in packages.

let analysis-name-markers = ['Analyzer', 'Linter', 'CodeSmell', 'CodeReview']

export let derived-core-domain-purity = core-types
    .Where(item.Name:containsAny(analysis-name-markers))
    :toError('Core type {item.Name}: move analysis-specific logic to a .cop package')