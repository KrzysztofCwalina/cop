# Use abstract classes for production abstractions instead of new interfaces.

# ICopCallable lets callable values retain their CopValue base class.
let allowed-interfaces = ['ICopCallable']

predicate isInterface(Type) => Type.Kind == Interface
predicate isApprovedInterface(Type) => allowed-interfaces:contains(Type.Name)

let interface-message = 'Do not add new interfaces — use abstract classes instead: {item.Name} in {item.File.Path}'

export let no-new-interfaces = codebase.Types:isCSharp:isInterface
    .Where(!isApprovedInterface(item) && !inTestsSamplesOrExamples(item.File))
    :toError(interface-message)
