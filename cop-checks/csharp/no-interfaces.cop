# Use abstract classes for production abstractions instead of new interfaces.

import code

# ICopCallable lets callable values retain their CopValue base class.
let allowed-interfaces = ['ICopCallable']

export let no-new-interfaces = code.interfacesExcept(
    codebase.Types:isCSharp.Where(!inFolders(item.File, ['tests/', 'samples/', 'examples/'])),
    allowed-interfaces)
    :toError('Use an abstract class instead of interface {item.Name} ({item.File.Path})')
