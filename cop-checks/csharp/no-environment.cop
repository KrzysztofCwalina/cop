# The environment supplies execution context, not a second configuration API.

let calls-outside-host-environment : [Statement] = source-code.Calls
    .Where(item.File.Path != 'cop/shared/HostEnvironment.cs')

export let no-environment = calls-outside-host-environment:isCSharp:isEnvironmentVariableAccess
    :toError('Use CLI flags or config instead of environment variables for Cop settings')
