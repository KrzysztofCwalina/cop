# Keep Cop settings explicit: use CLI flags or config files instead of environment variables.

predicate hasEnvironmentReceiver(Statement) =>
    Statement.TypeName:equals('Environment')
    || Statement.TypeName:equals('System.Environment')
    || Statement.TypeName:equals('global::System.Environment')
predicate hasEnvAccessorName(Statement) =>
    Statement.MemberName:equals('GetEnvironmentVariable')
    || Statement.MemberName:equals('SetEnvironmentVariable')
predicate accessesEnvVariable(Statement) => hasEnvironmentReceiver && hasEnvAccessorName

predicate isSecretNameLiteral(CodeExpression) => CodeExpression.Kind == stringLiteral
    && (CodeExpression.StringValue:contains('TOKEN')
        || CodeExpression.StringValue:contains('SECRET')
        || CodeExpression.StringValue:contains('PASSWORD'))
predicate hasSecretName(Statement) => Statement.ArgumentExpressions.Count > 0
    && isSecretNameLiteral(Statement.ArgumentExpressions[0])

predicate hasLiteralName(Statement) => Statement.ArgumentExpressions.Count > 0
    && Statement.ArgumentExpressions[0].Kind == stringLiteral
predicate hasPathName(Statement) => hasLiteralName
    && Statement.ArgumentExpressions[0].StringValue == 'PATH'
predicate isSingleArgEnvRead(Statement) =>
    hasEnvironmentReceiver && Statement.MemberName == 'GetEnvironmentVariable'
    && Statement.ArgumentExpressions.Count == 1
predicate readsSearchPath(Statement) => isSingleArgEnvRead && hasPathName

predicate inPathInstaller(Statement) =>
    Statement.File.Path == 'cop/cli/commands/CopInstallation.cs'
    && Statement.Method.Name == 'ConfigurePath'
predicate hasInstallerPathExemption(Statement) => inPathInstaller && hasPathName

# Toolchain discovery needs access to Java and Cargo environment settings.
predicate inJavaContextDiscovery(Statement) =>
    Statement.File.Path == 'providers/java-provider/src/JavaSemanticContext.cs'
    && Statement.Method.Name == 'Discover'
predicate hasClasspathName(Statement) => hasLiteralName
    && Statement.ArgumentExpressions[0].StringValue == 'CLASSPATH'
predicate inRustFrontendBind(Statement) =>
    Statement.File.Path == 'providers/rust-provider/src/RustFrontend.cs'
    && Statement.Method.Name == 'Bind'
predicate isAllowedRustArg(CodeExpression) =>
    (CodeExpression.Kind == stringLiteral && CodeExpression.StringValue == 'CARGO_HOME')
    || (CodeExpression.Kind == identifier && CodeExpression.Name == 'name')
predicate isAllowedJavaEnvRead(Statement) =>
    isSingleArgEnvRead && inJavaContextDiscovery && hasClasspathName
predicate isAllowedRustEnvRead(Statement) =>
    isSingleArgEnvRead && inRustFrontendBind
    && isAllowedRustArg(Statement.ArgumentExpressions[0])
predicate isAllowedFrontendRead(Statement) => isAllowedJavaEnvRead || isAllowedRustEnvRead

predicate lacksEnvExemption(Statement) =>
    !hasSecretName
    && !readsSearchPath
    && !isAllowedFrontendRead
    && !hasInstallerPathExemption

let environment-message = 'Environment variable used to control behavior — use a CLI flag or config instead ({item.File.Path}:{item.Line})'

export let no-environment = codebase.Calls
    :accessesEnvVariable:lacksEnvExemption
    .Where(item.File.Language == csharp && !inTestsOrSamples(item.File))
    :toError(environment-message)
