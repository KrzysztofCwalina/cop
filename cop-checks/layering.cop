# Runtime must not reference providers

import code-layering

let runtime-projects = ['runtime']
let provider-projects = [
    'code'
    'markdown-provider'
    'csharp-provider'
    'python-provider'
    'javascript-provider'
    'json-provider'
    'http-provider'
    'typespec-provider'
    'cop-provider'
]

predicate isLayeringRuntimeProject(Project) => Project.Name:in(runtime-projects)
predicate isLayeringProviderName(string) => string:in(provider-projects)
predicate hasLayeringProviderReference(Project) => Project.References:any(isLayeringProviderName)

export let layering-violations = codebase.Projects:isLayeringRuntimeProject:hasLayeringProviderReference
    :toError('{item.Name} must not reference providers other than filesystem-provider')
