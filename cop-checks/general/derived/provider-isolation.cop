# Keep the listed provider projects independent of one another.

import code

let provider-names = [
    'AiProvider'
    'codeql-provider'
    'cop-provider'
    'csharp-provider'
    'go-provider'
    'HttpProvider'
    'java-provider'
    'javascript-provider'
    'json-provider'
    'python-provider'
    'rust-provider'
    'tool-providers'
    'typespec-provider'
]

export let derived-provider-isolation = codebase.Projects
    .WhereIn(item.Name, provider-names)
    .Where(referencesAny(item, provider-names))
    :toError('Provider project {item.Name} must not reference another provider project')
