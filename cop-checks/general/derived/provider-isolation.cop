# Keep the listed provider projects independent of one another.

import code

let provider-names = [
    'AiProvider'
    'codeql-provider'
    'cop-provider'
    'csharp-provider'
    'go-provider'
    'HttpProvider'
    'java-provider'
    'javascript-provider'
    'json-provider'
    'python-provider'
    'rust-provider'
    'tool-providers'
    'typespec-provider'
]

predicate isListedProviderName(string) => string:in(provider-names)
predicate isListedProvider(Project) => Project.Name:in(provider-names)
predicate referencesListedProvider(Project) => Project.References:any(isListedProviderName)

let provider-dependency-message = 'Provider project {item.Name} must not reference another provider project'

export let derived-provider-isolation = codebase.Projects
    :isListedProvider:referencesListedProvider
    :toError(provider-dependency-message)
