# Keep the listed provider projects independent of one another.

import code

let provider-names = [
    'AiProvider'
    'codeql-provider'
    'cop-provider'
    'csharp-provider'
    'go-provider'
    'HttpProvider'
    'java-provider'
    'javascript-provider'
    'json-provider'
    'python-provider'
    'rust-provider'
    'tool-providers'
    'typespec-provider'
]

predicate isListedProvider(Project) =>
    Project.Name:in(provider-names)

let provider-dependency-message =
    'Provider project {item.Name} must not reference another provider project'

export let derived-provider-isolation = codebase.Projects:isListedProvider
    .Where(referencesAny(item, provider-names))
    :toError(provider-dependency-message)
