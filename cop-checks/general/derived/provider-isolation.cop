# Reject references between the listed provider projects.
# References to projects outside the list are unrestricted by this rule.

import code

let isolation-checked-provider-names = [
    'AiProvider'
    'codeql-provider'
    'cop-provider'
    'csharp-provider'
    'go-provider'
    'HttpProvider'
    'java-provider'
    'javascript-provider'
    'json-provider'
    'python-provider'
    'rust-provider'
    'tool-providers'
    'typespec-provider'
]

predicate isIsolationCheckedProviderName(string) => string:in(isolation-checked-provider-names)
predicate isProviderSubjectToIsolation(Project) => Project.Name:in(isolation-checked-provider-names)
predicate referencesIsolationCheckedProvider(Project) => Project.References:any(isIsolationCheckedProviderName)

export let derived-provider-isolation = codebase.Projects
    :isProviderSubjectToIsolation:referencesIsolationCheckedProvider
    :toError('Provider project {item.Name} must not reference another provider project')
