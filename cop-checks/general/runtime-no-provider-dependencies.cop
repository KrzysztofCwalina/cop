# Keep the listed provider dependencies out of runtime; filesystem-provider is allowed.

import code

let forbidden-providers = [
    'code'
    'markdown-provider'
    'csharp-provider'
    'python-provider'
    'javascript-provider'
    'json-provider'
    'http-provider'
    'typespec-provider'
    'cop-provider'
]

export let layering-violations = codebase.Projects
    .Where(item.Name:in(['runtime']) && referencesAny(item, forbidden-providers))
    :toError('{item.Name} must not reference providers other than filesystem-provider')
