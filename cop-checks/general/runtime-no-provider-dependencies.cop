# Keep the listed provider dependencies out of runtime; filesystem-provider is allowed.

let forbidden-providers = [
    'code'
    'markdown-provider'
    'csharp-provider'
    'python-provider'
    'javascript-provider'
    'json-provider'
    'http-provider'
    'typespec-provider'
    'cop-provider'
]

let runtime-projects : [Project] = codebase.Projects.Where(item.Name == 'runtime')

export let layering-violations = runtime-projects
    .Where(referencesAny(item, forbidden-providers))
    :toError('{item.Name} must not reference providers other than filesystem-provider')