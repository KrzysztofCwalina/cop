# Keep the listed provider dependencies out of runtime; filesystem-provider is allowed.

import code

let runtime-projects = ['runtime']
let forbidden-providers = [
    'code'
    'markdown-provider'
    'csharp-provider'
    'python-provider'
    'javascript-provider'
    'json-provider'
    'http-provider'
    'typespec-provider'
    'cop-provider'
]

predicate isRuntime(Project) => Project.Name:in(runtime-projects)
predicate isForbiddenProvider(string) => string:in(forbidden-providers)
predicate referencesForbiddenProvider(Project) => Project.References:any(isForbiddenProvider)

let runtime-dependency-message = '{item.Name} must not reference providers other than filesystem-provider'

export let layering-violations = codebase.Projects:isRuntime:referencesForbiddenProvider
    :toError(runtime-dependency-message)
