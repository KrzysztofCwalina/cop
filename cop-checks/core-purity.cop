# AI self-check — Core purity.
#
# The cop CORE — the general-purpose Cop language (cop/shared/) and the runtime
# engine (cop/runtime/) — must stay DOMAIN-AGNOSTIC. Code-analysis behavior
# (code-review Violations, issue severities, error/warning/info reporting, checks,
# rules, analyzers) is the job of cop PACKAGES such as code-analysis, and must
# never be baked into the C# core.
#
# This is an LLM-based rule: it sends the core type inventory to ai.judge, which
# flags any type whose PURPOSE is analyzing user source code. Unlike a static
# rule, it can evaluate an abstract architectural requirement.
#
# Opt-in (makes a network call; needs ~/.cop/ai.json — see packages/ai):
#   cop cop-checks/ai/main.cop -t . -p csharp

import code
import ai
import code

predicate isCoreType(Type) =>
    Type.File.Path:contains('cop/shared/') || Type.File.Path:contains('cop/runtime/')

let core-types = codebase.Types:isCoreType

export let core-purity-violations = ai.judge(
    'These C# types make up the cop CORE: a general-purpose functional language (under cop/shared/) and its runtime engine (under cop/runtime/). The core must stay DOMAIN-AGNOSTIC: any behavior that belongs in a cop PACKAGE must not be baked into the core. The forbidden domain is CODE ANALYSIS: analyzing user SOURCE CODE for quality, style, or correctness issues - the job of cop check packages such as code-analysis. Forbidden core types are ones whose PURPOSE is code review or linting: a code-review Violation type, code-issue severity levels, error-warning-info reporting about user code quality, or Check, Rule, Lint, or Analyzer concepts. IMPORTANT: judge by PURPOSE, not by keywords in the name. The mere presence of words like Violation, Diagnostic, Severity, Error, or Exception in a type name does NOT make it forbidden. The following are general-purpose infrastructure and are ALWAYS allowed: the languages own parser, tokenizer, evaluator, interpreter, values, type system, environment, modules; the compilers own syntax, type, and name-binding diagnostics and their severities (these report errors in cop programs, like any compiler); the runtime engine and provider plumbing; and package-management infrastructure such as checksum or integrity violations, dependency errors, feeds, and restore. Flag ONLY types whose clear purpose is analyzing user source code. For each real violation set file to the path shown in brackets, set line to 1, and write a short message naming the type and its code-analysis purpose. If none qualify, return an empty array.',
    core-types)
