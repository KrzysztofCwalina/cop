# AI self-check — Core purity.
#
# The cop CORE — the general-purpose Cop language (cop/shared/) and the runtime
# engine (cop/runtime/) — must stay DOMAIN-AGNOSTIC. Code-analysis behavior
# (code-review Violations, issue severities, error/warning/info reporting, checks,
# rules, analyzers) is the job of cop PACKAGES such as code-analysis, and must
# never be baked into the C# core.
#
# This is an LLM-based rule: it sends the core type inventory to ai.judge, which
# flags any type whose PURPOSE is analyzing user source code. Unlike a static
# rule, it can evaluate an abstract architectural requirement.
#
# Opt-in (makes a network call; needs ~/.cop/ai.json — see packages/core/ai):
#   cop cop-checks/main.cop -t . -c ai

import code
import ai
import code

predicate isCoreType(Type) =>
    Type.File.Path:contains('cop/shared/') || Type.File.Path:contains('cop/runtime/')

let core-types = codebase.Types:isCoreType

export let core-purity-violations = ai.judge(
    '''
    The Cop core must remain a general-purpose language and runtime.
    Reviewing user source code for quality, style, or correctness belongs
    in packages, not the core. This includes code-review violations,
    code-issue severities, and linting rules or analyzers.

    The language implementation, compiler diagnostics, runtime/provider
    infrastructure, and package management belong in the core.
    Compiler error severities and package-integrity violations are allowed;
    their purpose is not reviewing user source code.
    ''',
    core-types)
