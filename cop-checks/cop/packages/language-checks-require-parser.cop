# Language-specific checks must use an explicit parser, not Program.Providers.

let language-package-paths = [
    'dotnet/', 'js/', 'python/', 'java/', 'go/', 'rust/',
    'checks/csharp-', 'checks/javascript-', 'checks/python-',
    'checks/java-', 'checks/go-', 'checks/rust-'
]

predicate isProgramProviders(CodeExpression) =>
    isMemberOfIgnoringCase(CodeExpression, 'Program', 'Providers')

export let lang-provider-hardcoded-violations = codebase.Calls
    .Where(
        inFolders(item.File, language-package-paths) &&
        item.MemberName:equals('codebase') &&
        item.CallTarget.Kind == identifier &&
        item.ArgumentExpressions:any(isProgramProviders))
    :toError('Use codebase(<lang>.parse()), not codebase(Program.Providers)')
