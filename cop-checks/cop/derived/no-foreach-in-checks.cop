# Reject foreach statements in cop-checks/; report violation lists through CHECK.
# Violations are always produced with :toError/:toWarning/:toInfo and printed via CHECK.

predicate isForeachStatement(Statement) => Statement.Kind == foreach
predicate isInForeachRestrictedChecksFolder(Statement) => Statement.File.Path:contains('cop-checks/')

export let derived-no-foreach-in-checks = codebase.Statements:isForeachStatement:isInForeachRestrictedChecksFolder
    :toError('Do not use foreach in cop-checks — use CHECK ({item.File.Path}:{item.Line})')
