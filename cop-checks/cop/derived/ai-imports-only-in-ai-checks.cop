# Keep default checks deterministic; only *core-purity.cop files may import ai.

export let derived-ai-imports-only-in-ai-checks = codebase.Statements
    .Where(
        item.Kind == import &&
        item.MemberName:equals('ai') &&
        item.File.Path:contains('cop-checks/') &&
        !item.File.Path:endsWith('core-purity.cop'))
    :toError('Only core-purity.cop may import ai; keep default checks deterministic')
