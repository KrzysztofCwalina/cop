# Allow command declarations in cop-checks/ only in files ending with main.cop.
# Each individual check file exports a violation list; only the aggregator runs commands.

predicate isCommandDeclaration(Statement) => Statement.Kind == command
predicate isInCommandRestrictedChecksFolder(Statement) => Statement.File.Path:contains('cop-checks/')
predicate isOutsideMainCheckFile(Statement) => !Statement.File.Path:endsWith('main.cop')

export let derived-single-command-in-checks = codebase.Statements
    :isCommandDeclaration:isInCommandRestrictedChecksFolder:isOutsideMainCheckFile
    :toError('Only cop-checks/main.cop may declare a command ({item.File.Path}:{item.Line})')
