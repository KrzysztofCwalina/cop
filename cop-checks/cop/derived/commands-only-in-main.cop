# Keep commands in *main.cop files; individual checks only export violations.

let non-main-check-statements : [Statement] = check-statements
    .Where(!item.File.Path:endsWith('main.cop'))
let commands-in-checks : [Statement] = non-main-check-statements.Where(item.Kind == command)

export let derived-single-command-in-checks = commands-in-checks
    :toError('Only cop-checks/main.cop may declare a command ({item.File.Path}:{item.Line})')