# Keep commands in *main.cop files; individual checks only export violations.

predicate isCommand(Statement) =>
    Statement.Kind == command
predicate hasMainSuffix(File) =>
    File.Path:endsWith('main.cop')

let check-command-message =
    'Only cop-checks/main.cop may declare a command ({item.File.Path}:{item.Line})'

export let derived-single-command-in-checks = codebase.Statements:isCommand
    .Where(
        inChecks(item.File) &&
        !hasMainSuffix(item.File))
    :toError(check-command-message)
