# Keep runtime-backed API declarations in files named intrinsics.cop.
# This check enforces declaration placement; implementations remain in C#.

import cop

predicate isOutsideIntrinsicsFile(CopFunction) => !CopFunction.File.Path:endsWith('intrinsics.cop')

export let intrinsics-in-wrong-file = codebase.Methods:asCop:isIntrinsic:isOutsideIntrinsicsFile
    :toError('Intrinsic declaration must be in intrinsics.cop, not {item.File.Path}')
