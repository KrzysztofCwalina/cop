<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\cop\cli\cop.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <Target Name="CopyToPackageLib" AfterTargets="Build">
    <PropertyGroup>
      <PackageLibDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\packages\core\http\lib\'))</PackageLibDir>
    </PropertyGroup>
    <MakeDir Directories="$(PackageLibDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageLibDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
