<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Cop.Providers</RootNamespace>
    <PublishReadyToRun>true</PublishReadyToRun>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\cop\cli\cop.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>

  <Target Name="EmbedFrameworkMetadata" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <FrameworkMetadata Include="@(ReferencePath)"
                         Condition="'%(ReferencePath.FrameworkReferenceName)' == 'Microsoft.NETCore.App'" />
      <EmbeddedResource Include="@(FrameworkMetadata)">
        <LogicalName>Cop.CSharp.Framework.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
    <Error Condition="'@(FrameworkMetadata)' == ''"
           Text="C# analysis requires the SDK-resolved Microsoft.NETCore.App reference metadata." />
  </Target>

  <!-- Copy provider DLL + deps to package lib/ folder after build -->
  <Target Name="CopyToPackageLib" AfterTargets="Build">
    <PropertyGroup>
      <PackageLibDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\packages\languages\csharp\lib\'))</PackageLibDir>
    </PropertyGroup>
    <MakeDir Directories="$(PackageLibDir)" />
    <ItemGroup>
      <ProviderFiles Include="$(OutputPath)csharp-provider.dll" />
      <ProviderFiles Include="$(OutputPath)csharp-provider.deps.json" />
      <!-- Roslyn and MetadataLoadContext dependencies -->
      <ProviderFiles Include="$(OutputPath)Microsoft.CodeAnalysis*.dll" />
      <ProviderFiles Include="$(OutputPath)System.Reflection.MetadataLoadContext.dll" />
      <ProviderFiles Include="$(OutputPath)System.Collections.Immutable.dll" Condition="Exists('$(OutputPath)System.Collections.Immutable.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(ProviderFiles)" DestinationFolder="$(PackageLibDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
