<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TypeSpecProvider</RootNamespace>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\cop\cli\cop.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyToPackageLibs" AfterTargets="Build">
    <ItemGroup>
      <PackageLibDir Include="$(MSBuildThisFileDirectory)..\..\packages\languages\typespec\lib\" />
      <PackageLibDir Include="$(MSBuildThisFileDirectory)..\..\packages\languages\typespec-http\lib\" />
    </ItemGroup>
    <MakeDir Directories="@(PackageLibDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="%(PackageLibDir.Identity)" SkipUnchangedFiles="true" />
  </Target>

</Project>
