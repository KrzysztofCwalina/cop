# Cop Self-Check: Intrinsics must be in intrinsics.cop
#
# Design principle: All intrinsic function declarations (=> intrinsic)
# must be defined exclusively in packages/core/src/intrinsics.cop.
# This keeps the runtime-implemented functions in a single, auditable location.
#
# Run: cop run self-checks/intrinsics/intrinsics-placement.cop -t .

import cop
import code-analysis

predicate isIntrinsicDeclaration(Line) => Line.Text:matches('=\s*intrinsic\s*$')

predicate isInWrongFile(Line) => isIntrinsicDeclaration && !Line.File.Path:endsWith('intrinsics.cop')

export let misplaced-intrinsics = cop.Lines:isInWrongFile
    :toError('Intrinsic declaration must be in intrinsics.cop, not {item.File.Path}')

command check-intrinsics = CHECK(misplaced-intrinsics)
