# Cop Self-Check: All types must be in namespaces

# Design principle: Every C# type in the cop codebase must be declared
# within a namespace. Namespace-less types break assembly resolution and
# make the code harder to organise.

# Run: cop run self-checks/ -t .

import csharp
import code-analysis

predicate inTestProject(Type) => Type.File.Path:sw('tests/') || Type.File.Path:sw('samples/')

predicate hasNamespace(Type) => Type.File.Namespace.Length:gt(0)

predicate missingNamespace(Type) => !hasNamespace && !inTestProject

export let types-without-namespace = csharp.Types:missingNamespace
    :toError('{item.Name} in {item.File.Path} must be in a namespace')

command check-namespaces = CHECK(types-without-namespace)
