# Cop Self-Check: Type Metadata Coverage

# Design principle: Every type reachable through the Cop type system must be
# defined in metadata - either as a real export type definition in a .cop
# package file, or as a pseudo type registered in TypeRegistry.RegisterCorePrimitives.

# This check uses the cop-lang provider to structurally inspect .cop type
# definitions and the csharp provider to verify C# schema classes.

# Run: cop run self-checks/all-types-have-metadata.cop -t .

import cop-lang
import csharp

# All types defined in .cop package files under packages/code/
predicate isCodePackageType(Type) => Type.File.Path:ct('code/src')

# All types defined in .cop package files (any package)
predicate isPackageType(Type) => Type.File.Path:ct('packages/')

# Check: C# schema class exists
predicate isSchemaClass(Type) => Type.Name:eq('CodeSchema')
    && Type.File.Path:ct('providers/code')

export let schema-class-exists = csharp.Types:isSchemaClass

# List all .cop type definitions from code package (informational)
export let code-types = cop-lang.Types:isCodePackageType

command show-schema = foreach schema-class-exists => '{item.Name} found in {item.File.Path}'
command show-types = foreach code-types => '{item.Name} ({item.File.Path})'
