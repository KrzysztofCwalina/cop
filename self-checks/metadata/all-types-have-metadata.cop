# Cop Self-Check: Package Metadata Coverage
#
# Design principle: Every data provider must have a corresponding .cop package
# that defines 'export type' metadata for the types it registers, and
# explicit 'export let' bindings using provider()/source()/sink() intrinsics.
#
# If this check fails, add the item to the tracked list below AND to docs/review-app.html.
#
# Run: cop run self-checks/metadata/all-types-have-metadata.cop -t .

import csharp-checks
import core
import code
import code-analysis

# ═══════════════════════════════════════════════════════════════════════════════
# Part 1: Provider Implementations
# ═══════════════════════════════════════════════════════════════════════════════

# Known provider implementations (update when adding a new provider)
let tracked-providers = [
    'CSharpProvider'
    'PythonProvider'
    'JavaScriptProvider'
    'CopProvider'
    'MarkdownProvider'
    'FilesystemProvider'
    'HttpProvider'
    'JsonProvider'
    'TypeSpecProvider'
    'TypeSpecHttpProvider'
    'TypeSpecRawProvider'
    'CodeSchemaProvider'
]

# ObjectProvider subclasses in the providers/ directory
predicate isProviderImpl(Type) =>
    Type.File.Path:contains('providers/')
    && Type.Name:endsWith('Provider')

predicate untrackedProvider(Type) => isProviderImpl && !Type.Name:in(tracked-providers)

export let untracked-providers = csharp.Types:untrackedProvider
    :toWarning('Provider {item.Name} in {item.File.Path} needs a .cop package with type metadata')

# ═══════════════════════════════════════════════════════════════════════════════
# Part 2: Provider Intrinsics
# ═══════════════════════════════════════════════════════════════════════════════

# Use provider('core') to access cop code provider for packages/ directory
let pkg-code = provider('core')

# Streaming providers expose StreamProvider/SinkProvider subclasses.
# Track SinkProvider classes here to ensure they are documented.
let tracked-streaming-globals = [
    'Receive'
    'Send'
]

# SinkProvider subclasses in the providers/ directory
predicate isSinkClass(Type) =>
    Type.File.Path:contains('providers/')
    && Type.BaseType:equals('SinkProvider')

predicate untrackedSink(Type) => isSinkClass && !Type.Name:contains('Send')

export let untracked-sinks = csharp.Types:untrackedSink
    :toWarning('SinkProvider "{item.Name}" in {item.File.Path} is not documented — add to docs/review-app.html')

# ═══════════════════════════════════════════════════════════════════════════════
# Part 3: Exported Types
# ═══════════════════════════════════════════════════════════════════════════════

# All exported types in .cop packages must be tracked here.
let tracked-types = [
    # code package
    'Modifier'
    'TypeKind'
    'StatementKind'
    'ApiKind'
    'Language'
    'Type'
    'Method'
    'Constructor'
    'Field'
    'Property'
    'Event'
    'Api'
    'Parameter'
    'TypeReference'
    'Statement'
    'Call'
    'Declaration'
    'ErrorHandler'
    'Attribute'
    'Line'
    'Region'
    'File'
    'Project'
    'Codebase'
    # files package
    'Folder'
    'DiskFile'
    'Filesystem'
    # markdown package
    'Heading'
    'Link'
    'Section'
    'FenceBlock'
    'MarkdownContent'
    # code-analysis package
    'Severity'
    'Violation'
    # code-layering package
    'LayerViolation'
    'UncategorizedProject'
    # http package
    'HttpMethod'
    'ContentType'
    'Response'
    'Request'
    # csharp-lister package
    'ApiLine'
    # typespec package
    'TspDecorator'
    'TspProperty'
    'TspModel'
    'TspOperation'
    'TspInterface'
    'TspEnumMember'
    'TspEnum'
    'TspUnionVariant'
    'TspUnion'
    'TspScalar'
    'TspNamespace'
    # typespec-http package
    'HttpVerb'
    'HttpStatusCode'
    'HttpParameterLocation'
    'HttpParameter'
    'HttpHeader'
    'HttpResponse'
    'HttpOperation'
    'HttpService'
]

predicate isExportedPackageType(Type) =>
    Type.Modifiers:isSet(Public)

predicate isUntrackedType(Type) =>
    isExportedPackageType && !Type.Name:in(tracked-types)

export let untracked-types = pkg-code.Types:isUntrackedType
    :toWarning('Exported type "{item.Name}" in {item.File.Path} is not tracked — add here and to docs/review-app.html')

# ═══════════════════════════════════════════════════════════════════════════════
command check-metadata = CHECK(untracked-providers, untracked-globals, untracked-types)
