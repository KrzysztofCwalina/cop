# Cop Self-Check: Provider Isolation
#
# Design principle: Only the filesystem provider is built-in.
# All other providers (code, markdown, csharp, etc.) must be external,
# loaded dynamically via import statements.
#
# Run: cop run self-checks/layering/layering.cop -t .

import csharp-checks
import code-layering

# Define layers
let runtime-projects = [
    'runtime'
]
let provider-projects = [
    'code'
    'markdown-provider'
    'csharp-provider'
    'python-provider'
    'javascript-provider'
    'json-provider'
    'http-provider'
    'typespec-provider'
    'cop-provider'
]
let core-projects = [
    'Cop.Core'
    'cop'
    'filesystem-provider'
]
let test-projects = [
    'Cop.Tests'
    'Lang.Tests'
]
let all-known-projects = 
    runtime-projects + 
    provider-projects + 
    core-projects + 
    test-projects + [
        'HttpProvider'
    ]

# Layer dependency rules: runtime must not reference providers
predicate runtimeReferencesProvider(Project) =>
    Project.Name:in(runtime-projects)
    && Project.References:containsAny(provider-projects)

# Produce violations
export let violations = csharp.Projects:runtimeReferencesProvider
    :toError('{item.Name} must not reference providers other than filesystem-provider')

export let uncategorized = csharp.Projects:isNotInLayer
    :toWarning('Project {item.Name} is not assigned to any architectural layer')

command check-violations = CHECK(violations)
command check-uncategorized = CHECK(uncategorized)
