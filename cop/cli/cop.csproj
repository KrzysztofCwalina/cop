<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>false</SelfContained>
    <AssemblyName>cop</AssemblyName>
    <Version>2026.6.22.2</Version>
    <ApplicationIcon>resources\cop.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lang.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.*" />
  </ItemGroup>



  <!-- Include source files from merged projects (Cop.Core, Runtime, Code Model, Built-in Providers) -->
  <ItemGroup>
    <Compile Include="..\shared\**\*.cs" Exclude="..\shared\bin\**;..\shared\obj\**" LinkBase="Core" />
    <Compile Include="..\runtime\*.cs" LinkBase="Runtime" />
    <Compile Include="..\..\providers\code\src\**\*.cs" LinkBase="CodeModel" />
    <Compile Include="..\..\providers\filesystem-provider\src\**\*.cs" LinkBase="BuiltinProviders" />
    <Compile Include="..\..\providers\markdown-provider\src\**\*.cs" LinkBase="BuiltinProviders" />
  </ItemGroup>

  <!-- Embedded resources for cop help language -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\language-reference.md" LogicalName="Cop.Cli.LanguageReference.md" />
    <EmbeddedResource Include="resources\init-instructions.md" LogicalName="Cop.Cli.InitInstructions.md" />
  </ItemGroup>

</Project>

