{
    "name": "cop-language",
    "displayName": "cop Check Language",
    "description": "Syntax highlighting and IntelliSense for cop check (.cop) files",
    "version": "0.2.2",
    "publisher": "cop",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:cop"
    ],
    "contributes": {
        "languages": [
            {
                "id": "cop",
                "aliases": [
                    "cop",
                    "Cop Check"
                ],
                "extensions": [
                    ".cop"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "cop",
                "scopeName": "source.cop",
                "path": "./syntaxes/cop.tmLanguage.json"
            }
        ],
        "configuration": {
            "title": "cop",
            "properties": {
                "cop.languageServer.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run `cop langserver` to show live diagnostics from the cop compiler."
                },
                "cop.languageServer.path": {
                    "type": "string",
                    "default": "cop",
                    "description": "Path to the cop executable used to start the language server (`cop langserver`)."
                }
            }
        }
    },
    "scripts": {
        "test": "jest --no-coverage"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "jest": "^30.4.2",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    }
}
