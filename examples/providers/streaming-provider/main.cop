# Demonstrates consuming the ticker streaming provider.
# The feed declaration tells cop where to find the ticker package.
feed '.'
import ticker

# Filter: only process ticks with a message
predicate hasMessage(Tick) => Tick.Message:!empty

# Process the stream: print each tick as it arrives
command MAIN =
    foreach Ticks:hasMessage => '{item.Sequence}: {item.Message} @ {item.Timestamp}'
