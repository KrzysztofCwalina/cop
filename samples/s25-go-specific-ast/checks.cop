# Language-specific AST — downcasting a Type to a GoType
#
# Narrow a Type to a GoType with `:asGo` to reach Go-specific fields (IsInterface,
# IsStruct). This sample is deliberately a TEACHING case: these particular facts are
# ALSO available language-independently via the common `Kind`, so you would normally
# write `codebase.Types:Kind:equals('Interface')` instead. Reach for `:asGo` only when
# a Go-only fact has no language-independent equivalent.
#
# Run with: cop run        (or: cop checks.cop -t .)
import code
import code-analysis
import go

let codebase = codebase(go.parse())

let interface-violations = codebase.Types:asGo:isInterface
    :toInfo('{item.Name} is an interface')

command MAIN = CHECK(interface-violations)
