# Language-specific AST — downcasting Types, Methods, and Statements
#
# The unified Codebase model is language-agnostic, so it deliberately can't
# express C#-only concepts like records, extension methods, or lock statements.
# To reach those, narrow with `:asCSharp` — the same narrowing works on Types
# (-> CSharpType), Methods (-> CSharpMethod), and Statements (-> CSharpStatement).
# Multi-language checks keep using the common model; only the checks that need C#
# specifics downcast.
#
# Run with: cop run        (or: cop checks.cop -t .)
import code
import code-analysis
import csharp

let codebase = codebase(csharp.parse())

# Convention: data-transfer types (named *Dto) should be immutable records.
# Expressible ONLY with the C#-specific AST — `IsRecord` has no place in the
# language-agnostic model.
predicate isDto(Type) => Type.Name:endsWith('Dto')

let dto-violations = codebase.Types:isDto:asCSharp:!isRecord
    :toWarning('{item.Name} is a DTO and should be a record')

# `partial` is also a C#-only concept, reached the same way via `:asCSharp`.
let partial-violations = codebase.Types:asCSharp:isPartial
    :toInfo('{item.Name} is a partial type — consider consolidating it')

# Method-level C# facts: narrow Methods the same way. Flag unsafe methods.
let unsafe-methods = codebase.Methods:asCSharp:isUnsafeMethod
    :toWarning('{item.Name} is an unsafe method')

# Statement-level C# facts (control blocks / error handling): flag `lock`
# statements, which the common Statement model has no Kind for.
let lock-statements = codebase.Statements:asCSharp:isLock
    :toInfo('lock statement at line {item.Line}')

command MAIN = CHECK(dto-violations + partial-violations + unsafe-methods + lock-statements)
