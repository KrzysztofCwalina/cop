# Demonstrates language-constrained predicates.
# The same predicate name dispatches differently per source language.
# Constraints use :language syntax on the parameter type.
import code
import csharp

let cb : Codebase = provider('csharp')

# C# print detection — Console.WriteLine, Console.Write
predicate isPrintUsage(Statement:isCSharp) => Statement.Kind == 'call'
    && Statement.TypeName == 'Console'

# Python print detection — print() function call
predicate isPrintUsage(Statement:isPython) => Statement.Kind == 'call'
    && Statement.MemberName == 'print'

# Use explicit provider
let PrintStatements = cb.Statements:isPrintUsage
command MAIN = foreach PrintStatements => print('{item.File.Path}:{item.Line} uses print')
