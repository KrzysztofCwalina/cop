# Simple HTTP server using the push-provider pipeline.
# Listens on port 5000 and responds to incoming requests.
# Run with: cop run
# Stop with: Ctrl+C
import http

# Chat endpoint — forwards request to OpenAI and returns the LLM reply
function complete(string) =>
    http.Post('https://api.openai.com/v1/chat/completions', {
        Authorization: 'Bearer YOUR_API_KEY',
        Content-Type: 'application/json'
    }, {
        model = 'gpt-4o',
        messages = [{ role = 'user', content = string }]
    })

function handle(Request:Uri:equals('/chat')) =>
    Request.Body:Text:complete.Body:Text:ok

function handle(Request:Uri:equals('/hello')) => ok('{"message": "Hello, World!"}')
function handle(Request:Uri:equals('/health')) => ok
function handle(Request) => notFound

async foreach Requests => handle => RESPONSES