# Demonstrates predicate composition: building complex rules from simple ones.
# The code package provides modifier predicates (isPublic, isStatic, isSealed, etc.)
# that you combine with && and || to express richer conditions.
import code
import csharp

let cb : Codebase = provider('csharp')

# Combine built-in predicates with a custom one
predicate isVoidReturn(Method) => Method.ReturnType.Name:equals('void')
predicate isEntryPoint(Method) => Method:isPublic && Method:isStatic && Method:isVoidReturn

# Find types that have entry-point methods
predicate hasEntryPoint(Type) => Type.Methods:any(isEntryPoint)
let EntryPointTypes = cb.Types:hasEntryPoint

command MAIN = foreach EntryPointTypes => print('{item.Name} has public static void methods')
