# Language-specific AST — downcasting a Type to a PythonType
#
# The unified Codebase model marks every Python class as "Class", so it can't tell a
# @dataclass or an Enum from a plain class. Narrow a Type to a PythonType with
# `:asPython` to reach Python-specific fields such as IsDataclass and IsEnum.
#
# Run with: cop run        (or: cop checks.cop -t .)
import code
import code-analysis
import python

let codebase = codebase(python.parse())

# Convention: data-transfer types (*Dto) should be immutable @dataclass-es. Needs the
# Python-specific AST — the common Kind is just "Class" for all of these.
predicate isDto(Type) => Type.Name:endsWith('Dto')

let dto-violations = codebase.Types:isDto:asPython:!isDataclass
    :toWarning('{item.Name} is a DTO and should be a @dataclass')

# Enums are also recovered via `:asPython`.
let enum-violations = codebase.Types:asPython:isEnum
    :toInfo('{item.Name} is an enum')

command MAIN = CHECK(dto-violations + enum-violations)
