# JSON — typed schemas over JSON data.
#
# Declare a `type`, load JSON into a typed list, then filter on a field.
# A boolean field can be used directly as a filter:  people:active
# A custom predicate can also filter on any field:   people:canVote
#
# Run from this folder with:  cop json.cop
import json

type Person = {
    name : string,
    age : int,
    active : bool
}

let people : [Person] = json.Parse('data.json')

predicate canVote(Person) => Person.age:greaterOrEqual(18)

command MAIN = foreach people:active => print('{item.name} ({item.age}) is active')

command VOTERS = foreach people:canVote => print('{item.name} can vote')
