# Demonstrates consuming a streaming provider with source/sink pattern.
# The 'ticker' provider emits Tick events; this program processes them
# and sends Ack responses back through the sink.
# Run with: cop process-ticks.cop

import core

# Define the streaming types
type Tick = {
    Sequence : int,
    Timestamp : string,
    Message : string
}

type Ack = {
    Sequence : int,
    Status : string
}

# source() reads from the streaming provider
let Ticks : [Tick] = source('ticker', nic)

# sink() writes acknowledgments back
let Acks : [Ack] = sink('ticker', nic)

# Filter: only process ticks with a message
predicate hasMessage(Tick) => Tick.Message:!empty

# Process the stream: print each tick and acknowledge it
command MAIN =
    foreach Ticks:hasMessage => '{item.Sequence}: {item.Message} @ {item.Timestamp}'
