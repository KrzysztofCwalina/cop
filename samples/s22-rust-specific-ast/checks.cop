# Language-specific AST — downcasting a Type to a RustType
#
# The unified Codebase model is language-agnostic, so it deliberately can't
# express Rust-only concepts like traits, impl blocks, or unsafe. To reach those,
# narrow a Type to a RustType with `:asRust`, which exposes Rust-specific fields
# such as IsTrait, IsImpl and IsUnsafe. Multi-language checks keep using the
# common model; only the checks that need Rust specifics downcast.
#
# Run with: cop run        (or: cop checks.cop -t .)
import code
import code-analysis
import rust

let codebase = codebase(rust.parse())

# Rust-only: flag `unsafe` traits and impls. Has no place in the common model.
let unsafe-violations = codebase.Types:asRust:isUnsafe
    :toWarning('{item.Name} is unsafe — review carefully')

# Combine a Rust-specific fact (isTrait) with common predicates: public traits
# must be documented. `:isTrait` also excludes synthetic impl-block types.
predicate isUndocumented(Type) => !Type.Documented

let trait-doc-violations = codebase.Types:asRust:isTrait:isPublic:isUndocumented
    :toWarning('public trait {item.Name} must be documented')

command MAIN = CHECK(unsafe-violations + trait-doc-violations)
