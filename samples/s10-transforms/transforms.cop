# Demonstrates list transforms: Where, Select, text, First, Count.
# Transforms use .Method() syntax and return new lists or values.
# Run with: cop run MAIN
import code

# .Where(predicate) — filter a sub-list to matching items
let PublicTypes = Code.Types.Where(Type:isPublic)

# .Count — number of items in a list
predicate hasManyMethods(Type) => Type.Methods.Count > 3

# .Select(template) — project each item into a string
# .text(separator) — join all items into a single string
let MethodNames = Code.Types:hasManyMethods
    .Select('{item.Name}: {item.Methods.Select(Method.Name).text(", ")}')

# .First — access the first element
let FirstPublicType = PublicTypes.First

# Output: show transform results
command MAIN =
    print('Public types: {PublicTypes.Count}') &
    print('First public type: {FirstPublicType.Name}') &
    foreach MethodNames => print('{item}')
