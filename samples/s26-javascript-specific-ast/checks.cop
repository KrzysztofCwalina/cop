# Language-specific AST — downcasting a Type to a JavaScriptType
#
# Narrow a Type to a JavaScriptType with `:asJavaScript` to reach JS/TS-specific fields
# (IsExported, HasBaseClass). This sample is deliberately a TEACHING case: these facts are
# ALSO derivable from the common model (`isPublic`, `BaseTypes`), so prefer language-
# independent checks. Reach for `:asJavaScript` only for JS-only facts with no equivalent.
#
# Run with: cop run        (or: cop checks.cop -t .)
import code
import code-analysis
import javascript

let codebase = codebase(javascript.parse())

let exported-violations = codebase.Types:asJavaScript:isExported
    :toInfo('{item.Name} is exported')

let subclass-violations = codebase.Types:asJavaScript:hasBaseClass
    :toInfo('{item.Name} extends a base class')

command MAIN = CHECK(exported-violations + subclass-violations)
