# Command composition with the & operator.
# Demonstrates defining named commands and chaining them together
# so multiple actions run as a single composed command.
# Run with: cop run LIST-TYPES
# Run with: cop run STATISTICS
import csharp
import code

let cb : Codebase = provider('csharp')

# Individual counting commands
command TYPE-COUNT = print('{cb.Types.Count} types')
command FILE-COUNT = print('{cb.Files.Count} files')

# Chain commands with & to compose a single STATISTICS command
command STATISTICS = TYPE-COUNT & FILE-COUNT

# Combine a foreach listing with a count summary
command LIST-TYPES = foreach cb.Types => print('{item.Name}') & TYPE-COUNT